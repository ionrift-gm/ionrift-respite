<div class="respite-item-provisions-app">

    <nav class="respite-provisions-tab-bar">
        <button type="button" class="respite-provisions-tab-btn {{#if (eq activeTab "editor")}}active{{/if}}" data-action="switchTab" data-tab="editor">
            <i class="fas fa-carrot"></i> {{localize "ionrift-respite.itemProvisions.tabConfigureItem"}}
        </button>
        <button type="button" class="respite-provisions-tab-btn {{#if (eq activeTab "auditor")}}active{{/if}}" data-action="switchTab" data-tab="auditor">
            <i class="fas fa-table-list"></i> {{localize "ionrift-respite.itemProvisions.tabWorldOverrides"}} <span class="respite-provisions-tab-badge">{{auditorCount}}</span>
        </button>
    </nav>

    {{#if (eq activeTab "editor")}}
    <div class="respite-editor-container">

        {{#if hasItem}}
        <div class="respite-item-editor-scroll ionrift-list">
            <div class="respite-item-dropzone respite-item-dropzone--compact" data-tooltip="{{localize "ionrift-respite.itemProvisions.dropAnotherItem"}}">
                <i class="fas fa-arrows-rotate"></i>
                <span>{{localize "ionrift-respite.itemProvisions.dropAnotherItem"}}</span>
            </div>

            <div class="respite-item-provisions-hero">
                <img class="respite-item-provisions-img" src="{{itemImg}}" alt="{{itemName}}" />
                <div class="respite-item-provisions-meta">
                    <h3 class="respite-item-provisions-title">{{itemName}}</h3>
                    <div class="respite-item-provisions-subtitle">
                        <span class="respite-badge">{{itemType}}</span>
                        <span class="respite-location">{{sourceLocation}}</span>
                    </div>
                </div>
            </div>

            {{#if isLocked}}
            <div class="respite-item-provisions-warning">
                <i class="fas fa-lock"></i>
                <span>{{localize "ionrift-respite.itemProvisions.lockedCompendiumWarning"}}</span>
            </div>
            {{/if}}

            <div class="respite-item-provisions-fields">

                {{#if isContainer}}
                <div class="respite-field-row respite-field-row--card">
                    <div class="respite-field-header">
                        <label class="respite-field-label">{{localize "ionrift-respite.itemProvisions.coldStorage"}}</label>
                        <label class="respite-checkbox-label">
                            <input type="checkbox" name="coldStorage" {{#if coldStorage}}checked{{/if}} />
                            <span><i class="fas fa-snowflake"></i> {{{localize "ionrift-respite.itemProvisions.preserveFoodAndIngredients"}}}</span>
                        </label>
                    </div>
                    <p class="respite-field-hint">{{localize "ionrift-respite.itemProvisions.coldStorageHint"}}</p>
                </div>

                <div class="respite-field-row respite-field-row--card">
                    <label class="respite-field-label">{{localize "ionrift-respite.itemProvisions.preservationStorageType"}}</label>
                    <select name="storagePreset" class="respite-select">
                        {{#each storagePresets}}
                        <option value="{{id}}" {{#if (eq id ../selectedStoragePreset)}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                    </select>
                    <p class="respite-field-hint">{{localize "ionrift-respite.itemProvisions.preservationStorageTypeHint"}}</p>
                </div>

                <div class="respite-field-row respite-field-row--card respite-custom-multiplier-row" style="{{#unless isCustomMultiplier}}display: none;{{/unless}}">
                    <label class="respite-field-label">{{localize "ionrift-respite.itemProvisions.customMultiplier"}}</label>
                    <div class="respite-input-group">
                        <input type="number" step="0.1" min="0" name="customPreservationMultiplier" class="respite-input" value="{{preservationMultiplier}}" />
                        <span class="respite-input-suffix">{{localize "ionrift-respite.itemProvisions.shelfLifeSuffix"}}</span>
                    </div>
                    <p class="respite-field-hint">{{localize "ionrift-respite.itemProvisions.customMultiplierHint"}}</p>
                </div>
                {{else}}

                <div class="respite-field-row">
                    <label class="respite-field-label">{{localize "ionrift-respite.itemProvisions.sustenanceType"}}</label>
                    <select name="resourceType" class="respite-select">
                        {{#each resourceTypeOptions}}
                        <option value="{{value}}" {{#if (eq value ../resourceType)}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                    </select>
                    <p class="respite-field-hint">{{{localize "ionrift-respite.itemProvisions.sustenanceTypeHint"}}}</p>
                </div>

                <div class="respite-field-row">
                    <label class="respite-field-label">{{localize "ionrift-respite.itemProvisions.dietaryCategory"}}</label>
                    <select name="foodTag" class="respite-select">
                        {{#each foodTagOptions}}
                        <option value="{{value}}" {{#if (eq value ../foodTag)}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                    </select>
                    <p class="respite-field-hint">{{localize "ionrift-respite.itemProvisions.dietaryCategoryHint"}}</p>
                </div>

                <div class="respite-field-row">
                    <label class="respite-field-label">{{localize "ionrift-respite.itemProvisions.liquidDrinkType"}}</label>
                    <select name="drinkType" class="respite-select">
                        {{#each drinkTypeOptions}}
                        <option value="{{value}}" {{#if (eq value ../drinkType)}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                    </select>
                    <p class="respite-field-hint">{{localize "ionrift-respite.itemProvisions.liquidDrinkTypeHint"}}</p>
                </div>

                <div class="respite-field-row respite-field-row--card">
                    <div class="respite-field-header">
                        <label class="respite-field-label">{{localize "ionrift-respite.itemProvisions.spoilageWindow"}}</label>
                        <label class="respite-checkbox-label">
                            <input type="checkbox" name="isPerishable" data-action="togglePerishable" {{#if isPerishable}}checked{{/if}} />
                            <span>{{localize "ionrift-respite.itemProvisions.perishable"}}</span>
                        </label>
                    </div>

                    <div class="respite-provisions-spoilage-fields" style="{{#unless isPerishable}}display: none;{{/unless}}">
                        <div class="respite-spoilage-input-group">
                            <input type="number" name="spoilsValue" class="respite-input respite-input--number" value="{{spoilsValue}}" min="1" step="1" />
                            <select name="spoilageUnit" class="respite-select respite-select--inline">
                                <option value="days" {{#if (eq spoilageUnit "days")}}selected{{/if}}>{{localize "ionrift-respite.itemProvisions.restsDays"}}</option>
                                <option value="hours" {{#if (eq spoilageUnit "hours")}}selected{{/if}}>{{localize "ionrift-respite.itemProvisions.hours"}}</option>
                            </select>
                        </div>
                        <p class="respite-field-hint">{{localize "ionrift-respite.itemProvisions.spoilageWindowHint"}}</p>
                    </div>
                    {{#unless isPerishable}}
                    <p class="respite-field-hint respite-shelf-stable-note">{{localize "ionrift-respite.itemProvisions.shelfStableNote"}}</p>
                    {{/unless}}
                </div>

                <div class="respite-field-row respite-field-row--card">
                    <label class="respite-field-label">{{localize "ionrift-respite.itemProvisions.sustenanceFulfillment"}}</label>
                    <div class="respite-checkbox-group">
                        <label class="respite-checkbox-label">
                            <input type="checkbox" name="satiatesFood" {{#if satiatesFood}}checked{{/if}} />
                            <span><i class="fas fa-utensils"></i> {{localize "ionrift-respite.itemProvisions.satisfiesHunger"}}</span>
                        </label>
                        <label class="respite-checkbox-label">
                            <input type="checkbox" name="satiatesWater" {{#if satiatesWater}}checked{{/if}} />
                            <span><i class="fas fa-tint"></i> {{localize "ionrift-respite.itemProvisions.quenchesThirst"}}</span>
                        </label>
                    </div>
                    <p class="respite-field-hint">{{localize "ionrift-respite.itemProvisions.sustenanceFulfillmentHint"}}</p>
                </div>
                {{/if}}
            </div>
        </div>

        <footer class="respite-provisions-footer">
            <button type="button" class="respite-btn respite-btn--ghost" data-action="clearProvisions" {{#if isLocked}}disabled{{/if}}>
                <i class="fas fa-trash-can"></i> {{localize "ionrift-respite.itemProvisions.clearRespiteProperties"}}
            </button>
            <button type="button" class="respite-btn respite-btn--primary" data-action="saveProvisions" {{#if isLocked}}disabled{{/if}}>
                <i class="fas fa-check"></i> {{localize "ionrift-respite.itemProvisions.saveProperties"}}
            </button>
        </footer>

        {{else}}
        <div class="respite-item-dropzone respite-item-dropzone--hero">
            <div class="respite-dropzone-icon">
                <i class="fas fa-carrot"></i>
            </div>
            <h3 class="respite-dropzone-title">{{localize "ionrift-respite.itemProvisions.dropAnItemHere"}}</h3>
            <p class="respite-dropzone-desc">
                {{localize "ionrift-respite.itemProvisions.dropzoneDesc"}}
            </p>
            {{#if auditorCount}}
            <button type="button" class="respite-btn respite-btn--ghost" data-action="switchTab" data-tab="auditor" style="margin-top: 0.5rem;">
                <i class="fas fa-table-list"></i> {{localize "ionrift-respite.itemProvisions.viewAllOverrides" count=(concat auditorCount "")}}
            </button>
            {{/if}}
        </div>
        {{/if}}

    </div>

    {{else}}

        <div class="respite-auditor-container">
            <div class="respite-auditor-toolbar">
                <div class="respite-auditor-search-row">
                    <input type="search" class="respite-auditor-search-input" placeholder="{{localize "ionrift-respite.itemProvisions.searchPlaceholder"}}" />
                    <button type="button" class="respite-btn respite-btn--ghost" data-action="auditorRefresh" title="{{localize "ionrift-respite.itemProvisions.refreshAuditList"}}">
                        <i class="fas fa-arrows-rotate"></i>
                    </button>
                </div>

                <div class="respite-auditor-filters">
                    <button type="button" class="respite-filter-pill active" data-action="auditorFilter" data-category="all">{{localize "ionrift-respite.itemProvisions.filterAll" count=(concat auditorCount "")}}</button>
                    <button type="button" class="respite-filter-pill" data-action="auditorFilter" data-category="food">{{localize "ionrift-respite.itemProvisions.filterFood"}}</button>
                    <button type="button" class="respite-filter-pill" data-action="auditorFilter" data-category="water">{{localize "ionrift-respite.itemProvisions.filterWater"}}</button>
                    <button type="button" class="respite-filter-pill" data-action="auditorFilter" data-category="ingredient">{{localize "ionrift-respite.itemProvisions.filterIngredients"}}</button>
                    <button type="button" class="respite-filter-pill" data-action="auditorFilter" data-category="fuel">{{localize "ionrift-respite.itemProvisions.filterFuel"}}</button>
                    <button type="button" class="respite-filter-pill" data-action="auditorFilter" data-category="container">{{localize "ionrift-respite.itemProvisions.filterContainers"}}</button>
                    <button type="button" class="respite-filter-pill" data-action="auditorFilter" data-category="shelf">{{localize "ionrift-respite.itemProvisions.filterShelfStable"}}</button>
                </div>

                <div class="respite-auditor-meta-bar">
                    <span>{{{localize "ionrift-respite.itemProvisions.metaShowingOverrides" count=(concat auditorCount "")}}}</span>
                </div>
            </div>

            {{#if auditorItems.length}}
            <div class="respite-auditor-table-wrap ionrift-list">
                <table class="respite-auditor-table">
                    <thead>
                        <tr>
                            <th class="col-item">{{localize "ionrift-respite.itemProvisions.colItem"}}</th>
                            <th class="col-location">{{localize "ionrift-respite.itemProvisions.colLocation"}}</th>
                            <th class="col-sustenance">{{localize "ionrift-respite.itemProvisions.colSustenance"}}</th>
                            <th class="col-diet">{{localize "ionrift-respite.itemProvisions.colDiet"}}</th>
                            <th class="col-spoilage">{{localize "ionrift-respite.itemProvisions.colSpoilage"}}</th>
                            <th class="col-actions">{{localize "ionrift-respite.itemProvisions.colActions"}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each auditorItems}}
                        <tr class="respite-auditor-row" data-name="{{this.name}}" data-location="{{this.location}}" data-type="{{this.rawType}}" data-shelf="{{#if this.isShelfStable}}true{{else}}false{{/if}}">
                            <td>
                                <div class="respite-auditor-item-cell">
                                    <img class="respite-auditor-item-img" src="{{this.img}}" alt="{{this.name}}" />
                                    <span class="respite-auditor-item-name" title="{{this.name}}">{{this.name}}</span>
                                </div>
                            </td>
                            <td>
                                <span class="respite-location" title="{{this.location}}">{{this.location}}</span>
                            </td>
                            <td>
                                <span class="respite-auditor-badge respite-auditor-badge--{{this.rawType}}">
                                    <i class="fas {{this.typeIcon}}"></i> {{this.typeLabel}}
                                </span>
                            </td>
                            <td>
                                <span class="respite-diet-label">{{this.detailLabel}}</span>
                            </td>
                            <td>
                                <span class="respite-auditor-badge {{#if this.isShelfStable}}respite-auditor-badge--shelf{{/if}}">
                                    {{this.spoilageLabel}}
                                </span>
                            </td>
                            <td>
                                <div class="respite-auditor-actions">
                                    <button type="button" class="respite-action-icon-btn respite-action-icon-btn--edit" data-action="auditorEdit" data-uuid="{{this.uuid}}" title="{{localize "ionrift-respite.itemProvisions.editProperties"}}">
                                        <i class="fas fa-pen-to-square"></i>
                                    </button>
                                    <button type="button" class="respite-action-icon-btn respite-action-icon-btn--danger" data-action="auditorClear" data-uuid="{{this.uuid}}" data-name="{{this.name}}" title="{{localize "ionrift-respite.itemProvisions.clearOverrides"}}">
                                        <i class="fas fa-trash-can"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                        <tr class="respite-auditor-no-matches" style="display: none;">
                            <td colspan="6">
                                <div class="respite-auditor-no-matches-msg">
                                    <i class="fas fa-search"></i> {{localize "ionrift-respite.itemProvisions.noMatchesFilter"}}
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            {{else}}
            <div class="respite-auditor-empty">
                <i class="fas fa-clipboard-check"></i>
                <h4>{{localize "ionrift-respite.itemProvisions.noOverridesInWorld"}}</h4>
                <p>{{localize "ionrift-respite.itemProvisions.noOverridesInWorldHint"}}</p>
            </div>
            {{/if}}
        </div>

    {{/if}}

</div>
