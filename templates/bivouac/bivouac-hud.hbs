<div class="bivouac-hud-container">

    {{!-- Tier 1: Canonical Rest Header --}}
    {{> restHeader}}

    {{!-- Shared Terrain Artwork Banner --}}
    {{> terrainBanner}}

    {{!-- Tier 2: Camp Operations Ribbon --}}
    {{#if (or showCampfireRibbon (and chefStatus.eligible chefVolunteered) outlanderStatus.isEligible songOfRest)}}
    <div class="bivouac-operations-ribbon">
        {{#if showCampfireRibbon}}
        <div class="bivouac-stance-cluster">
            <div class="bivouac-stance-toggles">
                <button type="button" class="bivouac-stance-btn {{#if isWarm}}active{{/if}}"
                    data-action="toggleStance" data-stance="warm"
                    data-tooltip="{{localize "ionrift-respite.bivouac.hud.warmTooltip" healing=fireWarmthLabel}}">
                    <i class="fas fa-fire"></i> {{localize "ionrift-respite.bivouac.stance.warm"}}
                </button>
                <button type="button" class="bivouac-stance-btn {{#if isColdDark}}active{{/if}}"
                    data-action="toggleStance" data-stance="cold_dark"
                    data-tooltip="{{{localize "ionrift-respite.bivouac.hud.coldDarkTooltip"}}}">
                    <i class="fas fa-moon"></i> {{{localize "ionrift-respite.bivouac.stance.coldDark"}}}
                </button>
            </div>

            {{#if isWarm}}
            {{!-- Campfire Fuel Status Pill --}}
            <div class="bivouac-firewood-pill {{#if (gt totalFirewood 0)}}warm{{else}}empty{{/if}}"
                data-tooltip="{{localize "ionrift-respite.bivouac.hud.fuelTooltip" count=totalFirewood}}">
                <i class="fas {{#if (gt totalFirewood 0)}}fa-fire{{else}}fa-triangle-exclamation{{/if}}"></i>
                <span class="firewood-usage">{{#if (gt totalFirewood 0)}}{{localize "ionrift-respite.bivouac.hud.oneFuel"}}{{else}}{{localize "ionrift-respite.bivouac.hud.zeroFuel"}}{{/if}}</span>
            </div>
            {{/if}}

            {{#if shelterActive}}
            <span class="bivouac-status-badge shelter-badge" data-tooltip="{{localize "ionrift-respite.bivouac.hud.shelterTooltip"}}">
                <i class="fas fa-shield-halved"></i> {{localize "ionrift-respite.bivouac.hud.sheltered"}}
            </span>
            {{/if}}

            {{#if stanceCooldownSeconds}}
            <span class="bivouac-cooldown-pill" data-tooltip="{{localize "ionrift-respite.bivouac.hud.cooldownTooltip"}}">
                <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.bivouac.hud.cooldownSeconds" seconds=stanceCooldownSeconds}}
            </span>
            {{/if}}
        </div>
        {{/if}}

        {{!-- Camp Perks Cluster --}}
        {{#if (or (and chefStatus.eligible chefVolunteered) outlanderStatus.isEligible songOfRest)}}
        <div class="bivouac-perks-cluster">
            {{#if songOfRest}}
            <div class="bivouac-perk-chip sr-song-chip" data-tooltip="{{localize "ionrift-respite.bivouac.hud.songTooltip" bard=songOfRest.bardName die=songOfRest.songDie}}">
                <i class="fas fa-music"></i>
                <span>{{songOfRest.bardName}} · {{songOfRest.songDie}}</span>
            </div>
            {{/if}}

            {{#if outlanderStatus.isEligible}}
            <div class="bivouac-perk-chip outlander-chip" data-tooltip="{{#if outlanderStatus.foragerName}}{{{localize "ionrift-respite.bivouac.hud.outlanderTooltip" name=outlanderStatus.foragerName}}}{{else}}{{localize "ionrift-respite.bivouac.hud.wandererTooltip"}}{{/if}}">
                <i class="fas fa-tree"></i> {{localize "ionrift-respite.bivouac.hud.foragedMeals"}}
            </div>
            {{/if}}

            {{#if (and chefStatus.eligible chefVolunteered)}}
            <div class="bivouac-perk-chip chef-chip {{#if (gt chefMealsRemaining 0)}}chef-glowing-badge{{else}}chef-exhausted-badge{{/if}}"
                 data-tooltip="{{#if chefVolunteer}}{{{localize "ionrift-respite.bivouac.hud.chefTooltip" chef=chefVolunteer.chefName count=chefMealsRemaining}}}{{else}}{{{localize "ionrift-respite.bivouac.hud.chefTooltip" chef=chefStatus.leadChef.chefName count=chefMealsRemaining}}}{{/if}}">
                <i class="fas fa-utensils"></i>
                <span>{{localize "ionrift-respite.bivouac.hud.chefLabel"}} <strong>{{#if chefVolunteer}}{{chefVolunteer.chefName}}{{else}}{{chefStatus.leadChef.chefName}}{{/if}}</strong></span>
                <span class="chef-servings">({{localize "ionrift-respite.bivouac.hud.servingsLeft" count=chefMealsRemaining}})</span>
                {{#if canManageChef}}
                <button type="button" class="btn-chef-optout" data-action="optOutChef" data-tooltip="{{localize "ionrift-respite.bivouac.hud.chefOptOutTooltip"}}">✕</button>
                {{/if}}
            </div>
            {{/if}}
        </div>
        {{/if}}
    </div>
    {{/if}}

    {{#if workbenchIdentifyUiEnabled}}
    <div class="sr-nav-row" role="tablist" aria-label="{{localize "ionrift-respite.bivouac.hud.sectionsAria"}}">
        <div class="rest-dock-segments">
            <button type="button" role="tab" class="rest-dock-seg {{#if (eq activeTab "camp")}}active{{/if}}"
                data-action="switchBivouacTab" data-tab="camp" {{#if (eq activeTab "camp")}}aria-selected="true"{{else}}aria-selected="false"{{/if}}>
                <i class="fas fa-campground"></i> {{localize "ionrift-respite.bivouac.hud.tabCamp"}}
            </button>
            <button type="button" role="tab" class="rest-dock-seg {{#if (eq activeTab "workbench")}}active{{/if}}"
                data-action="switchBivouacTab" data-tab="workbench" {{#if (eq activeTab "workbench")}}aria-selected="true"{{else}}aria-selected="false"{{/if}}>
                <i class="fas fa-search"></i> {{localize "ionrift-respite.bivouac.hud.tabIdentify"}}
            </button>
        </div>
    </div>
    {{/if}}

    {{#if (eq activeTab "camp")}}
    <div class="bivouac-camp-flow rest-camp-flow">
        {{#if isGmNeutralView}}
            {{> restGmPartyDeck}}
        {{else}}
            {{#if isGM}}
            <div class="sr-focused-nav">
                <button type="button" class="btn-party-overview" data-action="clearSelectedCharacter" data-tooltip="{{localize "ionrift-respite.bivouac.hud.partyOverviewTooltip"}}">
                    <i class="fas fa-arrow-left"></i> {{localize "ionrift-respite.bivouac.hud.allCharacters"}}
                </button>
                <span class="sr-focused-title"><i class="fas fa-user-shield"></i> {{{localize "ionrift-respite.bivouac.hud.managing" name=heroCharacter.name}}}</span>
            </div>
            {{/if}}
            {{> restHeroCard}}
            {{> restCompanionDeck}}
        {{/if}}
    </div>
    {{else}}
    <div class="bivouac-workbench-container">
        <div class="bivouac-workbench-body">
            {{#with workbenchEmbed}}
            {{> workbenchIdentifyPanel}}
            {{/with}}
        </div>
    </div>
    {{/if}}

    {{!-- Standardized Bottom Footer --}}
    <div class="bivouac-footer-bar">
        <div class="bivouac-footer-left">
            {{#if isGM}}
            {{#if safePassage}}
            <div class="bivouac-safe-status" data-tooltip="{{localize "ionrift-respite.bivouac.hud.safeRestTooltip"}}">
                <i class="fas fa-shield-halved"></i> {{localize "ionrift-respite.bivouac.hud.safeRest"}}
            </div>
            {{else}}
            <div class="bivouac-dc-stepper" data-tooltip="{{localize "ionrift-respite.bivouac.hud.dangerDcTooltip"}}">
                <span class="bivouac-dc-label">{{localize "ionrift-respite.bivouac.hud.dangerDc"}}</span>
                <button type="button" class="btn-dc-stepper" data-action="adjustBivouacDC" data-delta="-1" data-tooltip="{{localize "ionrift-respite.bivouac.hud.decreaseDc"}}">−</button>
                <span class="bivouac-dc-value">{{dangerDC}}</span>
                <button type="button" class="btn-dc-stepper" data-action="adjustBivouacDC" data-delta="1" data-tooltip="{{localize "ionrift-respite.bivouac.hud.increaseDc"}}">+</button>
            </div>
            {{/if}}
            {{/if}}
        </div>

        {{#if isGM}}
        <button type="button" class="btn-primary-green" data-action="passTheNight">
            <i class="fas fa-check"></i> {{localize "ionrift-respite.bivouac.completeRest"}}
        </button>
        {{else}}
        <button type="button" class="sr-finished-toggle {{#if bivouacFooter.myFinished}}active{{/if}}" data-action="toggleBivouacFinished">
            {{#if bivouacFooter.myFinished}}
            <i class="fas fa-undo"></i> {{localize "ionrift-respite.bivouac.hud.stillResting"}}
            {{else}}
            <i class="fas fa-flag-checkered"></i> {{{localize "ionrift-respite.bivouac.hud.imFinished"}}}
            {{/if}}
        </button>
        {{/if}}
    </div>

</div>
