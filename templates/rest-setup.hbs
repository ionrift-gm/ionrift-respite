                    {{#each activeTreeState.stallConsequenceTags}}
                    <span class="tree-consequence-pill fail">{{this}}</span>
                    {{/each}}
                </div>
                {{/if}}
            </div>
            {{/if}}

            {{#each activeTreeState.history}}
