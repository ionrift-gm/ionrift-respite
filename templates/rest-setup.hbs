                                    <span class="loss-metric gold">{{{localize "ionrift-respite.restSetup.consequence.gpLoss" amount=lossGp}}}</span>
                                </div>
                                {{/each}}
                                {{#unless _lockedGold.breakdown.length}}
                                <span class="loss-empty-note">{{localize "ionrift-respite.restSetup.consequence.noCoin"}}</span>
