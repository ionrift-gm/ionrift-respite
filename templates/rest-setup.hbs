                    </span>
                    <span class="step-verdict-badge {{#if result.success}}pass{{else}}fail{{/if}}">
                        {{#if result.success}}{{localize "ionrift-respite.restSetup.tree.passed"}}{{else}}{{localize "ionrift-respite.restSetup.tree.failed"}}{{/if}} ({{result.passCount}}/{{result.rolls.length}})
