                    <div class="event-resolution-verdict"><i class="fas fa-exclamation-triangle"></i> {{localize "ionrift-respite.restSetup.events.partialSuccess"}}</div>
                    <div class="event-resolution-narrative">{{mechanical.onMixed.narrative}}</div>
                    {{#if mechanical.onMixed.effects.length}}
                    <div class="event-effects">
                        {{#each mechanical.onMixed.effects}}
                        <div class="event-effect{{#if _locked}} locked{{/if}}">
                            <div class="effect-head">
                                <span class="effect-label">
                                {{#if (eq type "damage")}}<i class="fas fa-heart-broken"></i> {{formula}} {{damageType}}
                                {{else if (eq type "recovery_penalty")}}<i class="fas fa-bed"></i> {{#if hpMultiplier includeZero=true}}{{localize "ionrift-respite.restSetup.consequence.recoveryMultiplier" multiplier=hpMultiplier}}{{else}}{{localize "ionrift-respite.restSetup.consequence.recoveryMultiplier" multiplier=""}}{{/if}}
                                {{else if (eq type "condition")}}<i class="fas fa-skull-crossbones"></i> {{condition}}{{#if checks.length}} on {{#each checks}}{{#if @index}}, {{/if}}{{upper this}}{{/each}} checks{{/if}} {{#if duration}}({{humanDuration duration}}){{/if}}
                                {{else if (eq type "consume_resource")}}<i class="fas fa-box-open"></i> {{#if resource}}{{localize "ionrift-respite.restSetup.consequence.loseResource" resource=resource}}{{else}}{{localize "ionrift-respite.restSetup.consequence.loseResource" resource=""}}{{/if}}
                                {{else if (eq type "consume_gold")}}<i class="fas fa-coins"></i> {{#if description}}{{description}}{{else}}{{localize "ionrift-respite.restSetup.consequence.coinLifted"}}{{/if}}
                                {{else if (eq type "item_at_risk")}}<i class="fas fa-box-open"></i> {{narrative}}
                                {{/if}}
                                </span>
                                {{#if (eq type "damage")}}
                                {{#if _locked}}<button type="button" class="effect-reroll" data-action="lockEventConsequence" data-event-index="{{@../index}}" data-effect-index="{{@index}}" data-tooltip="{{localize "ionrift-respite.restSetup.consequence.rerollDamage"}}"><i class="fas fa-rotate"></i></button>
                                {{else}}<button type="button" class="btn-lock-consequence" data-action="lockEventConsequence" data-event-index="{{@../index}}" data-effect-index="{{@index}}" data-tooltip="{{{localize "ionrift-respite.restSetup.consequence.lockDamage"}}}"><i class="fas fa-dice-d20"></i> {{{localize "ionrift-respite.restSetup.consequence.rollAndLock"}}}</button>{{/if}}
                                {{else if (eq type "consume_resource")}}
                                {{#if _locked}}<button type="button" class="effect-reroll" data-action="lockEventConsequence" data-event-index="{{@../index}}" data-effect-index="{{@index}}" data-tooltip="{{localize "ionrift-respite.restSetup.consequence.rerollAmount"}}"><i class="fas fa-rotate"></i></button>
                                {{else}}<button type="button" class="btn-lock-consequence" data-action="lockEventConsequence" data-event-index="{{@../index}}" data-effect-index="{{@index}}" data-tooltip="{{{localize "ionrift-respite.restSetup.consequence.lockAmount"}}}"><i class="fas fa-dice-d20"></i> {{{localize "ionrift-respite.restSetup.consequence.rollAndLock"}}}</button>{{/if}}
                                {{else if (eq type "item_at_risk")}}
                                {{#if _locked}}<button type="button" class="effect-reroll" data-action="lockEventConsequence" data-event-index="{{@../index}}" data-effect-index="{{@index}}" data-tooltip="{{localize "ionrift-respite.restSetup.consequence.rerollItems"}}"><i class="fas fa-rotate"></i></button>
