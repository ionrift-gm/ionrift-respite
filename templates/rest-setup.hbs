                        <strong>{{groupAverage}}</strong>
                        <span class="avg-vs">{{localize "ionrift-respite.restSetup.events.vsDc"}}</span>
                        <strong>{{mechanical.dc}}</strong>
                    </div>
                    {{/if}}
                </div>
                {{/if}}

                {{!-- Consolidated resolution block: verdict, narrative, and GM-only consequences in one card --}}
                {{#if (eq resolvedOutcome "triumph")}}
                <div class="event-resolution pass">
                    <div class="event-resolution-verdict"><i class="fas fa-shield-alt"></i> {{localize "ionrift-respite.restSetup.events.checkPassed"}}</div>
                    <div class="event-resolution-narrative">{{mechanical.onTriumph.narrative}}</div>
                </div>
                {{else if (eq resolvedOutcome "success")}}
                <div class="event-resolution pass">
                    <div class="event-resolution-verdict"><i class="fas fa-shield-alt"></i> {{localize "ionrift-respite.restSetup.events.checkPassed"}}</div>
                    <div class="event-resolution-narrative">{{mechanical.onSuccess.narrative}}</div>
                </div>
                {{else if (eq resolvedOutcome "mixed")}}
