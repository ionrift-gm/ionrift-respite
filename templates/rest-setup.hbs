                            <div class="consequence-footer-bar">
                                <span class="consequence-timing-pill"><i class="fas fa-hourglass-end"></i> {{localize "ionrift-respite.restSetup.consequence.leavesPacksAtDawn"}}</span>
                            </div>

                            {{else if (eq type "item_at_risk")}}
                            <div class="consequence-breakdown-matrix">
                                {{#each _lockedItems}}
                                <div class="loss-item-pill gear">
                                    {{#with (lookup @root.actorLookup actorId)}}
                                    <img class="loss-actor-avatar" src="{{img}}" alt="{{../actorName}}"/>
