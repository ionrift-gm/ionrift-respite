        {{!-- Player View: Resolved outcome card OR thin title with narrating state --}}
        {{#if resolvedOutcome}}
        <div class="respite-event-card {{category}} resolved-event">
            <div class="event-header">
                <div class="event-name">
                    {{#if (eq category "encounter")}}<i class="fas fa-swords"></i>
                    {{else if (eq category "complication")}}<i class="fas fa-exclamation-triangle"></i>
                    {{else if (eq category "discovery")}}<i class="fas fa-search"></i>
                    {{else}}<i class="fas fa-moon"></i>
                    {{/if}}
                    {{#if name}}{{name}}{{else}}{{#if (eq category "encounter")}}{{localize "ionrift-respite.restSetup.events.fallbackEncounter"}}{{else if (eq category "complication")}}{{localize "ionrift-respite.restSetup.events.fallbackComplication"}}{{else if (eq category "discovery")}}{{localize "ionrift-respite.restSetup.events.fallbackDiscovery"}}{{else}}{{localize "ionrift-respite.restSetup.events.fallbackQuiet"}}{{/if}}{{/if}}
                </div>
                <span class="event-verdict-inline {{#if (eq resolvedOutcome "triumph")}}pass{{else if (eq resolvedOutcome "success")}}pass{{else if (eq resolvedOutcome "mixed")}}partial{{else}}fail{{/if}}">
                    {{#if (eq resolvedOutcome "triumph")}}<i class="fas fa-check"></i> {{localize "ionrift-respite.restSetup.events.verdictPassed"}}{{else if (eq resolvedOutcome "success")}}<i class="fas fa-check"></i> {{localize "ionrift-respite.restSetup.events.verdictPassed"}}{{else if (eq resolvedOutcome "mixed")}}<i class="fas fa-exclamation-triangle"></i> {{localize "ionrift-respite.restSetup.events.verdictPartial"}}{{else}}<i class="fas fa-times"></i> {{localize "ionrift-respite.restSetup.events.verdictFailed"}}{{/if}}
                </span>
            </div>
            {{#if mechanical}}
            {{#if (eq mechanical.type "skill_check")}}
            <div class="event-mechanical">
                {{#if resolvedRolls}}
                <div class="event-roll-results">
                    {{#each resolvedRolls}}
                    <div class="event-roll-line {{#if passed}}pass{{else}}fail{{/if}}">
                        {{#if img}}<img class="roll-actor-token" src="{{img}}" alt="{{name}}">{{/if}}
                        <span class="roll-char-name">{{name}}</span>
                        <span class="roll-total">{{{localize "ionrift-respite.restSetup.events.rolledTotal" total=total}}}</span>
                        {{#unless ../isGroupAveraged}}
                        <span class="roll-badge {{#if passed}}pass{{else}}fail{{/if}}">
                            {{#if passed}}<i class="fas fa-check"></i> {{localize "ionrift-respite.restSetup.events.pass"}}{{else}}<i class="fas fa-times"></i> {{localize "ionrift-respite.restSetup.events.fail"}}{{/if}}
                        </span>
                        {{/unless}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{#if (eq resolvedOutcome "triumph")}}
                <div class="event-resolution pass">
                    <div class="event-resolution-verdict"><i class="fas fa-shield-alt"></i> {{localize "ionrift-respite.restSetup.events.checkPassed"}}</div>
                    <div class="event-resolution-narrative">{{localize "ionrift-respite.restSetup.events.challengeHeadOn"}}</div>
                </div>
                {{else if (eq resolvedOutcome "success")}}
                <div class="event-resolution pass">
                    <div class="event-resolution-verdict"><i class="fas fa-shield-alt"></i> {{localize "ionrift-respite.restSetup.events.checkPassed"}}</div>
                    <div class="event-resolution-narrative">{{localize "ionrift-respite.restSetup.events.weathersChallenge"}}</div>
                </div>
                {{else if (eq resolvedOutcome "mixed")}}
                <div class="event-resolution partial">
                    <div class="event-resolution-verdict"><i class="fas fa-exclamation-triangle"></i> {{localize "ionrift-respite.restSetup.events.partialSuccess"}}</div>
                    <div class="event-resolution-narrative">{{localize "ionrift-respite.restSetup.events.couldHaveGoneBetter"}}</div>
                </div>
                {{else}}
                <div class="event-resolution fail">
                    <div class="event-resolution-verdict"><i class="fas fa-skull-crossbones"></i> {{localize "ionrift-respite.restSetup.events.checkFailed"}}</div>
                    <div class="event-resolution-narrative">{{localize "ionrift-respite.restSetup.events.turnForTheWorse"}}</div>
                </div>
                {{/if}}

                {{#if playerConsequences.length}}
                <div class="event-player-consequences">
                    <div class="event-player-consequences-head"><i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.restSetup.events.afterTheRest"}}</div>
                    {{#each playerConsequences}}
                    <div class="event-player-consequence"><i class="fas {{icon}}"></i> {{text}}</div>
                    {{/each}}
                </div>
                {{/if}}
            </div>
            {{/if}}
            {{/if}}
        </div>
        {{else}}
        {{!-- Unresolved: Thin title bar with obscured narrating state or roll request --}}
        <div class="player-event-container">
            {{#if @root.pendingEventRoll}}
            {{#if (eq @index @root.pendingEventRoll.eventIndex)}}
            {{#if @root.pendingEventRoll.rollRequest}}
            <div class="player-event-roll-section">
                {{> rollRequest rollRequest=@root.pendingEventRoll.rollRequest}}
            </div>
            {{else}}
            <div class="player-event-narrating-card">
                <i class="fas fa-theater-masks player-narrating-icon"></i>
                <span class="player-narrating-text">{{localize "ionrift-respite.restSetup.tree.gmNarrating"}}</span>
            </div>
            {{/if}}
            {{else}}
            <div class="player-event-narrating-card">
                <i class="fas fa-theater-masks player-narrating-icon"></i>
                <span class="player-narrating-text">{{localize "ionrift-respite.restSetup.tree.gmNarrating"}}</span>
            </div>
            {{/if}}
            {{else}}
            <div class="player-event-narrating-card">
                <i class="fas fa-theater-masks player-narrating-icon"></i>
                <span class="player-narrating-text">{{localize "ionrift-respite.restSetup.tree.gmNarrating"}}</span>
            </div>
            {{/if}}
        </div>
        {{/if}}
        {{/if}}
        {{/each}}
        {{else}}
        <div class="respite-event-card ambient">
            <div class="event-name">{{localize "ionrift-respite.restSetup.events.quietRest"}}</div>
            <div class="event-description">{{localize "ionrift-respite.restSetup.events.nightPassesWithoutIncident"}}</div>
        </div>
        {{/if}}

        {{#if @root.isGM}}
        <div class="event-narration-hint">
            <i class="fas fa-theater-masks"></i>
            {{#if hasEncounterEvent}}
            <em>{{localize "ionrift-respite.restSetup.events.setSceneBeforeBattle"}}</em>
            {{else}}
            <em>{{localize "ionrift-respite.restSetup.events.describeOutcomeBeforeProceeding"}}</em>
            {{/if}}
        </div>
        {{/if}}
        {{/if}}

        {{/if}} {{!-- disasterChoice --}}

        {{else}}
        {{!-- PRE-ROLL: Camp preparations then Night Watch --}}
        {{#if isGM}}

        {{!-- Camp Preparations: camp activity rolls (persists after resolve for GM narration) --}}
        {{#if pendingCampRolls.length}}
        <div class="respite-event-card ambient camp-prep-card">
            <div class="event-name"><i class="fas fa-shield-alt"></i> {{localize "ionrift-respite.restSetup.events.campPreparations"}}</div>
            <div class="event-description">
                {{#if campPrepsResolved}}{{localize "ionrift-respite.restSetup.events.campPrepsResolvedDesc"}}{{else}}{{localize "ionrift-respite.restSetup.events.waitingCampActivityRolls"}}{{/if}}
            </div>
            <div class="camp-prep-list">
                {{#each pendingCampRolls}}
                <div class="camp-prep-entry {{status}}">
                    <i class="{{icon}}"></i>
                    <span class="camp-prep-name">{{characterName}}</span>
                    <span class="camp-prep-activity">{{activityName}}</span>
                    {{#if (eq status 'pass')}}
                    <span class="camp-prep-skill">{{skillName}} DC {{dc}}</span>
                    <span class="camp-prep-result pass"><i class="fas fa-check"></i> {{total}}</span>
                    {{else if (eq status 'fail')}}
                    <span class="camp-prep-skill">{{skillName}} DC {{dc}}</span>
                    <span class="camp-prep-result fail"><i class="fas fa-times"></i> {{total}}</span>
                    {{else}}
                    {{#if requested}}
                    <span class="camp-prep-skill">{{skillName}} DC {{dc}}{{#unless (eq dc baseDC)}} <span class="camp-dc-base">{{localize "ionrift-respite.restSetup.events.wasBaseDc" baseDC=baseDC}}</span>{{/unless}}</span>
                    <span class="camp-prep-result pending"><i class="fas fa-paper-plane"></i> {{localize "ionrift-respite.restSetup.events.sent"}}</span>
                    <button type="button" class="btn-roll-for-player camp-fallback" data-action="rollCampForPlayer" data-character-id="{{characterId}}" data-tooltip="{{localize "ionrift-respite.restSetup.events.rollOnBehalf"}}">
                        <i class="fas fa-dice"></i>
                    </button>
                    {{else}}
                    <span class="camp-prep-dc-controls">
                        <span class="camp-prep-skill">{{skillName}}</span>
                        <button type="button" class="camp-dc-btn" data-action="adjustCampDC" data-character-id="{{characterId}}" data-delta="-1" data-tooltip="{{localize "ionrift-respite.restSetup.events.lowerCampDc"}}">&minus;</button>
                        <span class="camp-dc-value">DC {{dc}}{{#unless (eq dc baseDC)}} <span class="camp-dc-base">({{baseDC}})</span>{{/unless}}</span>
                        <button type="button" class="camp-dc-btn" data-action="adjustCampDC" data-character-id="{{characterId}}" data-delta="1" data-tooltip="{{localize "ionrift-respite.restSetup.events.raiseCampDc"}}">+</button>
                    </span>
                    <button type="button" class="camp-prep-roll-btn" data-action="requestCampRoll" data-character-id="{{characterId}}" data-tooltip="{{localize "ionrift-respite.restSetup.events.sendRollRequest"}}">
                        <i class="fas fa-dice-d20"></i>
                    </button>
                    {{/if}}
                    {{/if}}
                </div>
                {{#if narrative}}
                <div class="camp-prep-narrative {{status}}">
                    <i class="fas {{#if (eq status 'pass')}}fa-check-circle{{else}}fa-times-circle{{/if}}"></i>
                    {{narrative}}
                </div>
                {{/if}}
                {{#each effectDescriptions}}
                <div class="camp-prep-effect">
                    <i class="fas fa-cog"></i> {{this}}
                </div>
                {{/each}}
                {{/each}}
            </div>
        </div>
        {{/if}}

        {{!-- Night Watch: shown when camp preps resolved or no preps needed --}}
        {{#if campPrepsResolved}}

        {{#if showEventPoolNudge}}
        <div class="art-nudge-banner event-pool-nudge-banner">
            <div class="art-nudge-content">
                <div class="art-nudge-text">
                    <span class="art-nudge-title">{{localize "ionrift-respite.restSetup.events.eventPoolSummary" terrain=eventPoolTerrainLabel count=eventPoolCount}}</span>
                </div>
            </div>
            <div class="art-nudge-actions">
                <button type="button" data-action="openEventPoolCurator" class="art-nudge-btn primary">
                    {{localize "ionrift-respite.restSetup.events.curatePool"}}
                </button>
            </div>
        </div>
        {{/if}}

        <div class="respite-event-card ambient event-roll-prompt nw-mode-{{eventsMode}}">
            <div class="event-name">{{localize "ionrift-respite.restSetup.events.nightWatch"}}</div>

            {{#if encountersEnabled}}
            {{#if noEventsInstalled}}
            {{#if isGM}}
            <div class="nw-pick-summary nw-no-events-installed">
                <i class="fas fa-feather-alt"></i>
                <span>{{localize "ionrift-respite.restSetup.events.noEventsInstalled"}}</span>
            </div>
            {{/if}}
            {{/if}}
            <div class="nw-mode-selector" role="tablist" aria-label="{{localize "ionrift-respite.restSetup.events.howNightUnfolds"}}">
                <button type="button" class="nw-mode-tab {{#if eventsModeIsRandom}}is-active{{/if}}"
                    role="tab" aria-selected="{{#if eventsModeIsRandom}}true{{else}}false{{/if}}"
                    data-action="setEventsMode" data-mode="random"
                    {{#if eventsCommitPending}}disabled{{/if}}
                    data-tooltip="{{#if eventsModeRandomAvailable}}{{localize "ionrift-respite.restSetup.events.randomAvailableTooltip"}}{{else if noEventsInstalled}}{{localize "ionrift-respite.restSetup.events.noEventsForTerrain"}}{{else}}{{localize "ionrift-respite.restSetup.events.noEventsInCuratedPool"}}{{/if}}"
                    {{#unless eventsModeRandomAvailable}}disabled{{/unless}}>
                    <i class="fas fa-dice-d20 nw-mode-icon"></i>
                    <span class="nw-mode-label">{{localize "ionrift-respite.restSetup.events.modeRandom"}}</span>
                </button>
                <button type="button" class="nw-mode-tab {{#if eventsModeIsImprovise}}is-active{{/if}}"
                    role="tab" aria-selected="{{#if eventsModeIsImprovise}}true{{else}}false{{/if}}"
                    data-action="setEventsMode" data-mode="improvise"
                    {{#if eventsCommitPending}}disabled{{/if}}
                    data-tooltip="{{localize "ionrift-respite.restSetup.events.modeImproviseTooltip"}}">
                    <i class="fas fa-hat-wizard nw-mode-icon"></i>
                    <span class="nw-mode-label">{{localize "ionrift-respite.restSetup.events.modeImprovise"}}</span>
                </button>
                <button type="button" class="nw-mode-tab {{#if eventsModeIsPick}}is-active{{/if}}"
                    role="tab" aria-selected="{{#if eventsModeIsPick}}true{{else}}false{{/if}}"
                    data-action="setEventsMode" data-mode="pick"
                    {{#if eventsCommitPending}}disabled{{/if}}
                    data-tooltip="{{#if eventsModePickAvailable}}{{localize "ionrift-respite.restSetup.events.pickAvailableTooltip"}}{{else if noEventsInstalled}}{{localize "ionrift-respite.restSetup.events.noEventsForTerrain"}}{{else}}{{localize "ionrift-respite.restSetup.events.noEventsInCuratedPool"}}{{/if}}"
                    {{#unless eventsModePickAvailable}}disabled{{/unless}}>
                    <i class="fas fa-book-open nw-mode-icon"></i>
                    <span class="nw-mode-label">{{localize "ionrift-respite.restSetup.events.modePick"}}</span>
                </button>
            </div>

            {{#if eventsModeIsRandom}}
            <div class="event-description">
                {{#if isGM}}
                {{#if pendingCampRolls.length}}{{localize "ionrift-respite.restSetup.events.campPrepsRollD20"}}{{else}}{{localize "ionrift-respite.restSetup.events.rollD20"}}{{/if}}
                {{else}}
                {{#if pendingCampRolls.length}}{{localize "ionrift-respite.restSetup.events.campPrepsGmCall"}}{{else}}{{localize "ionrift-respite.restSetup.events.gmCallNightCheck"}}{{/if}}
                {{/if}}
            </div>
            {{#if encounterBar}}
            {{#if isGM}}
            {{> encounterThreshold dc=encounterBar.effectiveDC belowLabel="event triggers" eventsCommitPending=eventsCommitPending}}
            {{else if encounterBar.playerFactors.length}}
            <div class="encounter-details-player">
                <span class="encounter-details-player-label">{{localize "ionrift-respite.restSetup.events.campExposure"}}</span>
                <span class="encounter-bar-chips encounter-bar-chips--player">
                    {{#each encounterBar.playerFactors}}
                    {{#unless @first}}<span class="encounter-factor-sep" aria-hidden="true">|</span>{{/unless}}
                    <span class="encounter-chip encounter-chip--{{tone}}"{{#if tooltip}} data-tooltip="{{tooltip}}"{{/if}}>
                        {{#if icon}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}{{label}}
                    </span>
                    {{/each}}
                </span>
            </div>
            {{/if}}
            {{/if}}
            {{/if}}

            {{#if eventsModeIsImprovise}}
            <div class="event-description">
                {{#if isGM}}{{localize "ionrift-respite.restSetup.events.improviseGmPrompt"}}{{else}}{{localize "ionrift-respite.restSetup.events.improvisePlayerPrompt"}}{{/if}}
            </div>
            {{#if encounterBar}}
            {{#if isGM}}
            {{> encounterThreshold dc=encounterBar.effectiveDC belowLabel="your scenario triggers" hideDisaster=true eventsCommitPending=eventsCommitPending}}
            {{else if encounterBar.playerFactors.length}}
            <div class="encounter-details-player">
                <span class="encounter-details-player-label">{{localize "ionrift-respite.restSetup.events.campExposure"}}</span>
                <span class="encounter-bar-chips encounter-bar-chips--player">
                    {{#each encounterBar.playerFactors}}
                    {{#unless @first}}<span class="encounter-factor-sep" aria-hidden="true">|</span>{{/unless}}
                    <span class="encounter-chip encounter-chip--{{tone}}"{{#if tooltip}} data-tooltip="{{tooltip}}"{{/if}}>
                        {{#if icon}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}{{label}}
                    </span>
                    {{/each}}
                </span>
            </div>
            {{/if}}
            {{/if}}
            {{/if}}

            {{#if eventsModeIsPick}}
            <div class="event-description">
                {{localize "ionrift-respite.restSetup.events.pickFromPoolDesc"}}
            </div>
            <div class="nw-pick-summary">
                <i class="fas fa-book-open"></i>
                <span>{{#if (eq eventPoolCount 1)}}{{localize "ionrift-respite.restSetup.events.eventPoolCountOne" terrain=eventPoolTerrainLabel count=eventPoolCount}}{{else}}{{localize "ionrift-respite.restSetup.events.eventPoolCountMany" terrain=eventPoolTerrainLabel count=eventPoolCount}}{{/if}}</span>
            </div>
            {{/if}}
            {{else}}
            <div class="event-description">
                {{localize "ionrift-respite.restSetup.events.encountersOffDesc"}}
            </div>
            {{/if}}
        </div>
        {{/if}}

        {{else}}
        {{!-- PLAYER VIEW: activity-specific messaging --}}
        <div class="respite-event-card ambient player-activity-card">
            <div class="event-name"><i class="fas fa-moon"></i> {{localize "ionrift-respite.restSetup.events.resting"}}</div>
            <div class="event-description">
                {{localize "ionrift-respite.restSetup.events.partySettlesDesc"}}
            </div>

            {{!-- Camp roll buttons for owned characters --}}
            {{#if pendingCampRoll.activities.length}}
            <div class="camp-roll-section">
                {{#each pendingCampRoll.activities}}
                {{#if rollRequest}}
                {{> rollRequest rollRequest=rollRequest}}
                {{else if (eq status 'pass')}}
                <div class="camp-roll-prompt pass">
                    <div class="camp-roll-info">
                        <strong>{{activityName}}</strong>
                        <span class="camp-roll-skill">{{skillName}} DC {{dc}}</span>
                    </div>
                    <span class="camp-roll-result pass" data-tooltip="{{localize "ionrift-respite.restSetup.events.rollSuccessTooltip" total=total}}">
                        <i class="fas fa-check-circle"></i> {{localize "ionrift-respite.restSetup.events.rollPassedResult" total=total}}
                    </span>
                    {{#each effectDescriptions}}
                    <div class="camp-roll-effect"><i class="fas fa-cog"></i> {{this}}</div>
                    {{/each}}
                </div>
                {{else if (eq status 'fail')}}
                <div class="camp-roll-prompt fail">
                    <div class="camp-roll-info">
                        <strong>{{activityName}}</strong>
                        <span class="camp-roll-skill">{{skillName}} DC {{dc}}</span>
                    </div>
                    <span class="camp-roll-result fail" data-tooltip="{{localize "ionrift-respite.restSetup.events.rollFailedTooltip" total=total}}">
                        <i class="fas fa-times-circle"></i> {{localize "ionrift-respite.restSetup.events.rollFailedResult" total=total}}
                    </span>
                    {{#each effectDescriptions}}
                    <div class="camp-roll-effect"><i class="fas fa-cog"></i> {{this}}</div>
                    {{/each}}
                </div>
                {{/if}}
                {{/each}}
            </div>
            {{/if}}
        </div>
        {{/if}}
        {{/if}}

    </div>
    {{#if isGM}}
    <div class="respite-action-bar">
        {{#if eventsRolled}}
            {{#if awaitingCombat}}
            {{!-- Combat in progress, GM decides when complete --}}
            <button type="button" class="btn-primary btn-combat-complete" data-action="completeEncounter">
                <i class="fas fa-check-circle"></i> {{localize "ionrift-respite.restSetup.combat.combatComplete"}}
            </button>
            <button type="button" class="btn-secondary btn-hide-window" data-action="hideWindow">
                <i class="fas fa-eye-slash"></i> {{localize "ionrift-respite.restSetup.combat.hide"}}
            </button>
            {{else if hasEncounterEvent}}
            {{!-- Encounter triggered but not yet acknowledged --}}
            <div class="encounter-gate">
                <div class="encounter-instructions">
                    <i class="fas fa-swords"></i>
                    <span>{{localize "ionrift-respite.restSetup.combat.interruptedCamp"}}</span>
                </div>
                {{#if encounterAwareness}}
                <div class="encounter-awareness-advisory">
                    <i class="fas fa-eye"></i>
                    <span>{{encounterAwareness}}</span>
                </div>
                {{/if}}
                {{#if combatBuffs}}
                <div class="combat-readiness-report">
                    <div class="combat-readiness-header">
                        <i class="fas fa-shield-alt"></i> {{localize "ionrift-respite.restSetup.combat.combatReadiness"}}
                    </div>
                    {{#if combatBuffs.perCharacter.length}}
                    <div class="combat-readiness-list">
                        {{#each combatBuffs.perCharacter}}
                        <div class="combat-buff-entry">
                            <span class="combat-buff-name">{{characterName}}</span>
                            <span class="combat-buff-activity">({{activityName}})</span>
                            <span class="combat-buff-summary">{{summary}}</span>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}
                    {{#if combatBuffs.partyWide.summary}}
                    <div class="combat-readiness-party">
                        <i class="fas fa-users"></i> {{combatBuffs.partyWide.summary}}
                    </div>
                    {{/if}}
                    {{#unless combatBuffs.perCharacter.length}}
                    <div class="combat-readiness-none">
                        {{localize "ionrift-respite.restSetup.combat.noCombatModifiers"}}
                    </div>
                    {{/unless}}
                </div>
                {{/if}}
                <button type="button" class="btn-primary btn-acknowledge-encounter" data-action="acknowledgeEncounter" data-tooltip="{{localize "ionrift-respite.restSetup.combat.minimizesToStatusBar"}}">
                    <i class="fas fa-swords"></i> {{localize "ionrift-respite.restSetup.combat.beginCombat"}}
                </button>
                <div class="combat-hint">
                    <i class="fas fa-info-circle"></i> {{localize "ionrift-respite.restSetup.combat.minimizesHint"}}
                </div>
            </div>
            {{else}}
            {{!-- No encounter, or encounter resolved, allow rest resolution --}}
            {{#if activeTreeState}}{{#unless activeTreeState.resolved}}
            {{!-- Hidden while decision tree is active --}}
            {{/unless}}{{/if}}
            {{#unless (and activeTreeState (not activeTreeState.resolved))}}
            <button type="button" class="btn-primary-green" data-action="enterDawn"
                {{#if (or resolvingRest disasterChoice (not allEventChecksResolved) (not allConsequencesResolved))}}disabled{{/if}}
                data-tooltip="{{#if disasterChoice}}{{localize "ionrift-respite.restSetup.night.chooseDisasterFirst"}}{{else if (not allEventChecksResolved)}}{{localize "ionrift-respite.restSetup.night.resolveAllChecksFirst"}}{{else if (not allConsequencesResolved)}}{{localize "ionrift-respite.restSetup.night.rollLockConsequencesFirst"}}{{else}}{{localize "ionrift-respite.restSetup.night.exhaustionSavesThenEnd"}}{{/if}}">
                <i class="fas fa-sun"></i> {{localize "ionrift-respite.restSetup.night.dawn"}}
            </button>
            {{/unless}}
            {{/if}}
        {{else}}
        {{#if encountersEnabled}}
        <button type="button" class="travel-skip-link nw-no-event-link" data-action="nightPasses"
            {{#if eventsCommitPending}}disabled{{/if}}
            {{#unless campPrepsResolved}}disabled{{/unless}}
            data-tooltip="{{#if eventsCommitPending}}{{localize "ionrift-respite.restSetup.night.waitingNightCheck"}}{{else if campPrepsResolved}}{{localize "ionrift-respite.restSetup.night.gmOverrideSkipCheck"}}{{else}}{{localize "ionrift-respite.restSetup.night.awaitingCampActivityRolls"}}{{/if}}">
            <i class="fas fa-moon"></i> {{localize "ionrift-respite.restSetup.night.noEvent"}}
        </button>
        <button type="button" class="btn-primary btn-roll-events" data-action="commitEventsMode"
            {{#if eventsCommitPending}}disabled{{/if}}
            {{#unless campPrepsResolved}}disabled data-tooltip="{{localize "ionrift-respite.restSetup.night.awaitingCampActivityRolls"}}"{{/unless}}>
            {{#if eventsCommitPending}}
            <i class="fas fa-circle-notch fa-spin"></i>
            {{#if eventsModeIsPick}}{{localize "ionrift-respite.restSetup.night.openingPool"}}{{else}}{{localize "ionrift-respite.restSetup.night.rolling"}}{{/if}}
            {{else if eventsModeIsPick}}
            <i class="fas fa-book-open"></i> {{localize "ionrift-respite.restSetup.night.chooseEvent"}}
            {{else}}
            <i class="fas fa-dice-d20"></i> {{localize "ionrift-respite.restSetup.night.rollForEvents"}}
            {{/if}}
        </button>
        {{else}}
        <button type="button" class="btn-primary btn-night-passes" data-action="nightPasses"
            {{#if eventsCommitPending}}disabled{{/if}}>
            {{#if eventsCommitPending}}
            <i class="fas fa-circle-notch fa-spin"></i> {{localize "ionrift-respite.restSetup.night.continuing"}}
            {{else}}
            <i class="fas fa-moon"></i> {{localize "ionrift-respite.restSetup.night.nightPasses"}}
            {{/if}}
        </button>
        {{/if}}
        {{/if}}
    </div>
    {{else}}
    <div class="respite-action-bar">
        {{#if eventsRolled}}
        {{#if awaitingCombat}}
        <span class="phase-waiting-label"><i class="fas fa-swords"></i> {{localize "ionrift-respite.restSetup.night.combatInProgress"}}</span>
        <button type="button" class="btn-secondary btn-hide-window" data-action="hideWindow" data-tooltip="{{localize "ionrift-respite.restSetup.combat.minimizeToStatusBar"}}">
            <i class="fas fa-eye-slash"></i> {{localize "ionrift-respite.restSetup.combat.hide"}}
        </button>
        {{else}}
        <span class="phase-waiting-label"><i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.restSetup.night.resolvingEvents"}}</span>
        {{/if}}
        {{else}}
        <span class="phase-waiting-label"><i class="fas fa-moon"></i> {{localize "ionrift-respite.restSetup.night.partyRests"}}</span>
        {{/if}}
    </div>
    {{/if}}
    </div>{{!-- /events-phase-body --}}
    {{/if}}

    {{!-- =============== DAWN: exhaustion saves, then the rest ends =============== --}}
    {{#if (eq phase 'dawn')}}
    <div class="events-phase-body">
        {{> dawnExhaustionStage}}
        <div class="respite-action-bar">
            {{#if isGM}}
            <button type="button" class="btn-secondary" data-action="returnToNight">
                <i class="fas fa-arrow-left"></i> {{localize "ionrift-respite.restSetup.dawn.backToNight"}}
            </button>
            <button type="button" class="btn-primary-green" data-action="completeDawn"
                {{#if (or resolvingRest exhaustionSummary.pending)}}disabled{{/if}}
                data-tooltip="{{#if exhaustionSummary.pending}}{{localize "ionrift-respite.restSetup.dawn.rollWaiveSaves"}}{{else}}{{localize "ionrift-respite.restSetup.dawn.applyRestClose"}}{{/if}}">
                {{#if resolvingRest}}
                <i class="fas fa-circle-notch fa-spin"></i> {{localize "ionrift-respite.restSetup.dawn.breakingCamp"}}
                {{else}}
                <i class="fas fa-check-double"></i> {{localize "ionrift-respite.restSetup.dawn.completeRest"}}
                {{/if}}
            </button>
            {{else}}
            {{#if exhaustionSummary.pending}}
            <span class="phase-waiting-label"><i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.restSetup.dawn.settlingSavesPending" count=exhaustionSummary.pending}}</span>
            {{else}}
            <span class="phase-waiting-label success"><i class="fas fa-check-double"></i> {{localize "ionrift-respite.restSetup.dawn.savesSettled"}}</span>
            {{/if}}
            {{/if}}
        </div>
    </div>
    {{/if}}

    {{!-- =============== RESOLUTION PHASE (DAWN BREAKS) =============== --}}
    {{#if (eq phase 'resolve')}}
    <div class="respite-dawn-screen">
        <div class="respite-dawn-header">
            <div class="respite-dawn-title-block">
                <span class="respite-dawn-badge"><i class="fas fa-sun"></i> {{localize "ionrift-respite.restSetup.dawn.dawnBreaks"}}</span>
                <span class="respite-dawn-subtitle">{{localize "ionrift-respite.restSetup.dawn.restCompleteSubtitle" weather=campStatus.weatherLabel comfort=campStatus.comfort}}</span>
            </div>
            <div class="respite-dawn-pacing">
                <span class="dawn-pacing-pill"><i class="fas fa-shield-alt"></i> {{#if (gt incidentsCount 1)}}{{localize "ionrift-respite.restSetup.dawn.incidentsResolvedMany" count=incidentsCount}}{{else if (gt incidentsCount 0)}}{{localize "ionrift-respite.restSetup.dawn.incidentsResolvedOne" count=incidentsCount}}{{else}}{{localize "ionrift-respite.restSetup.dawn.quietNight"}}{{/if}}</span>
            </div>
        </div>

        <div class="respite-dawn-grid">
            {{#each dawnCards}}
            <div class="respite-dawn-card {{#if hasSetback}}has-setback{{else}}all-recovered{{/if}}">
                <div class="dawn-card-portrait-wrap">
                    <img class="dawn-card-portrait" src="{{img}}" alt="{{name}}" />
                    <span class="dawn-card-status-glyph {{#if hasSetback}}setback{{else}}recovered{{/if}}">
                        <i class="fas {{#if hasSetback}}fa-triangle-exclamation{{else}}fa-check{{/if}}"></i>
                    </span>
                </div>
                <div class="dawn-card-info">
                    <div class="dawn-card-name" title="{{name}}">{{name}}</div>
                    <div class="dawn-card-act-pill {{#if activitySuccess}}success{{else}}failed{{/if}}" title="{{activityLabel}}">
                        <i class="{{activityIcon}}"></i> <span>{{activityLabel}}</span>
                    </div>
                </div>
                <div class="dawn-card-vitals">
                    <div class="dawn-vital-row {{#if hpAtMax}}max-val{{/if}}">
                        <i class="fas fa-heart"></i>
                        <span>{{hpLabel}}</span>
                    </div>
                    <div class="dawn-vital-row {{#if hdAtMax}}max-val{{/if}}">
                        <i class="fas fa-dice-d20"></i>
                        <span>{{hdLabel}}{{#if hasBedroll}} <small>(+1)</small>{{/if}}</span>
                    </div>
                </div>
                <div class="dawn-card-condition">
                    {{#if (gt exhaustionDelta 0)}}
                    <span class="dawn-cond-pill negative" title="{{localize "ionrift-respite.restSetup.dawn.gainedExhaustionTitle" count=exhaustionDelta}}">
                        <i class="fas fa-person-falling-burst"></i> {{localize "ionrift-respite.restSetup.dawn.gainedExhaustion" count=exhaustionDelta}}
                    </span>
                    {{else if saveFailed}}
                    <span class="dawn-cond-pill amber" title="{{localize "ionrift-respite.restSetup.dawn.conSaveFailedTitle" dc=exhaustionDC}}">
                        <i class="fas fa-bed"></i> {{localize "ionrift-respite.restSetup.dawn.dcFailed" dc=exhaustionDC}}
                    </span>
                    {{else if savePassed}}
                    <span class="dawn-cond-pill positive" title="{{localize "ionrift-respite.restSetup.dawn.conSavePassedTitle" dc=exhaustionDC}}">
                        <i class="fas fa-shield"></i> {{localize "ionrift-respite.restSetup.dawn.dcPassed" dc=exhaustionDC}}
                    </span>
                    {{else if (lt exhaustionDelta 0)}}
                    <span class="dawn-cond-pill positive" title="{{localize "ionrift-respite.restSetup.dawn.exhaustionReducedTitle"}}">
                        <i class="fas fa-sparkles"></i> {{localize "ionrift-respite.restSetup.dawn.minusOneExh"}}
                    </span>
                    {{else}}
                    <span class="dawn-cond-pill neutral">
                        <i class="fas fa-sparkles"></i> {{localize "ionrift-respite.restSetup.dawn.fullyRested"}}
                    </span>
                    {{/if}}

                    {{#if eventDamage}}
                    <span class="dawn-cond-pill damage" title="{{localize "ionrift-respite.restSetup.dawn.tookDamageTitle" damage=eventDamage}}">
                        <i class="fas fa-tint"></i> {{localize "ionrift-respite.restSetup.dawn.minusHp" damage=eventDamage}}
                    </span>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>

        <div class="respite-dawn-footer">
            <div class="respite-dawn-footer-hint">
                <i class="fas fa-scroll"></i>
                <span>{{localize "ionrift-respite.restSetup.dawn.summaryPostedToChat"}}</span>
            </div>
            <div class="respite-dawn-footer-actions">
                {{#if isGM}}
                <button type="button" class="btn-primary-green btn-break-camp" data-action="finalize">
                    <i class="fas fa-campground"></i> {{{localize "ionrift-respite.restSetup.dawn.breakCampPostChat"}}}
                </button>
                {{else}}
                <span class="player-waiting-pill"><i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.restSetup.dawn.waitingGmBreakCamp"}}</span>
                {{/if}}
            </div>
        </div>
    </div>
    {{/if}}

    {{!-- GM Copy Spell Transaction Card --}}
    {{#if gmCopySpellProposal}}
    <div class="gm-copy-spell-card" style="background: rgba(80,60,140,0.15); border: 1px solid {{#if gmCopySpellProposal.charged}}rgba(34,197,94,0.4){{else}}rgba(160,120,220,0.4){{/if}}; border-radius: 6px; padding: 0.6rem 0.75rem; margin: 0.5rem 0.75rem;">
        {{#if gmCopySpellProposal.charged}}
        {{!-- CHARGED STATE: Gold taken, awaiting player's Arcana roll --}}
        <div style="font-weight: 600; color: rgba(34,197,94,0.9); font-size: 0.85rem; margin-bottom: 0.4rem;">
            <i class="fas fa-coins"></i> {{localize "ionrift-respite.restSetup.copySpell.chargedAwaitingRoll"}}
        </div>
        <div style="font-size: 0.75rem; color: rgba(255,255,255,0.75); line-height: 1.5;">
            <strong>{{gmCopySpellProposal.actorName}}</strong>:
            {{{localize "ionrift-respite.restSetup.copySpell.levelSpell" level=gmCopySpellProposal.spellLevel}}}
            {{{localize "ionrift-respite.restSetup.copySpell.gpCharged" cost=gmCopySpellProposal.cost}}}
            {{{localize "ionrift-respite.restSetup.copySpell.gpRemaining" remaining=gmCopySpellProposal.remainingGold}}}<br>
            <i class="fas fa-dice-d20" style="color: rgba(126,184,218,0.8);"></i>
            {{{localize "ionrift-respite.restSetup.copySpell.awaitingArcanaRoll" dc=gmCopySpellProposal.dc}}}
        </div>
        <div style="font-size: 0.65rem; color: rgba(255,255,255,0.4); margin-top: 0.3rem; font-style: italic;">
            {{localize "ionrift-respite.restSetup.copySpell.disconnectedHint"}}
        </div>
        <div style="display: flex; gap: 0.4rem; margin-top: 0.5rem;">
            <button type="button" data-action="resendCopySpellRoll"
                style="flex: 1; padding: 0.3rem 0.5rem; border-radius: 4px; background: linear-gradient(135deg, rgba(126,184,218,0.3), rgba(126,184,218,0.15)); border: 1px solid rgba(126,184,218,0.4); color: rgba(255,255,255,0.9); font-weight: 600; font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-redo"></i> {{localize "ionrift-respite.restSetup.copySpell.resendRoll"}}
            </button>
            <button type="button" data-action="gmCopySpellFallback"
                style="flex: 1; padding: 0.3rem 0.5rem; border-radius: 4px; background: linear-gradient(135deg, rgba(243,156,18,0.3), rgba(243,156,18,0.15)); border: 1px solid rgba(243,156,18,0.4); color: rgba(255,255,255,0.9); font-weight: 600; font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-dice-d20"></i> {{localize "ionrift-respite.restSetup.copySpell.gmRollsInstead"}}
            </button>
            <button type="button" data-action="dismissGmCopySpell"
                style="padding: 0.3rem 0.5rem; border-radius: 4px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-times"></i>
            </button>
        </div>
        {{else}}
        {{!-- INITIAL STATE: Proposal received, GM decides to charge --}}
        <div style="font-weight: 600; color: rgba(180,140,240,0.9); font-size: 0.85rem; margin-bottom: 0.4rem;">
            <i class="fas fa-scroll"></i> {{localize "ionrift-respite.restSetup.copySpell.copySpellRequest"}}
        </div>
        <div style="font-size: 0.75rem; color: rgba(255,255,255,0.75); line-height: 1.5;">
            {{{localize "ionrift-respite.restSetup.copySpell.wantsToCopy" actor=gmCopySpellProposal.actorName}}}
            {{{localize "ionrift-respite.restSetup.copySpell.levelSpellStrong" level=gmCopySpellProposal.spellLevel}}}<br>
            <i class="fas fa-coins" style="color: rgba(255,200,100,0.8);"></i>
            {{{localize "ionrift-respite.restSetup.copySpell.costGp" cost=gmCopySpellProposal.cost}}}
            {{localize "ionrift-respite.restSetup.copySpell.hasGp" gold=gmCopySpellProposal.currentGold}}
            {{#unless gmCopySpellProposal.canAfford}}
            <span style="color: #ef9a9a;"> {{localize "ionrift-respite.restSetup.copySpell.insufficientGold"}}</span>
            {{/unless}}
            <br>
            <i class="fas fa-dice-d20" style="color: rgba(126,184,218,0.8);"></i>
            {{{localize "ionrift-respite.restSetup.copySpell.arcanaDc" dc=gmCopySpellProposal.dc}}}
        </div>
        <div style="font-size: 0.65rem; color: rgba(255,255,255,0.4); margin-top: 0.3rem; font-style: italic;">
            {{localize "ionrift-respite.restSetup.copySpell.determineSpell"}}
            {{localize "ionrift-respite.restSetup.copySpell.scrollConsumed"}}
        </div>
        <div style="display: flex; gap: 0.4rem; margin-top: 0.5rem;">
            {{#if gmCopySpellProposal.canAfford}}
            <button type="button" data-action="processGmCopySpell"
                style="flex: 1; padding: 0.3rem 0.5rem; border-radius: 4px; background: linear-gradient(135deg, rgba(34,197,94,0.3), rgba(34,197,94,0.15)); border: 1px solid rgba(34,197,94,0.4); color: rgba(255,255,255,0.9); font-weight: 600; font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-coins"></i> {{{localize "ionrift-respite.restSetup.copySpell.chargeSendRoll"}}}
            </button>
            {{else}}
            <button type="button" disabled
                style="flex: 1; padding: 0.3rem 0.5rem; border-radius: 4px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.3); font-weight: 600; font-size: 0.75rem; cursor: not-allowed;">
                <i class="fas fa-coins"></i> {{{localize "ionrift-respite.restSetup.copySpell.cantAfford"}}}
            </button>
            {{/if}}
            <button type="button" data-action="dismissGmCopySpell"
                style="padding: 0.3rem 0.5rem; border-radius: 4px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-times"></i> {{localize "ionrift-respite.restSetup.copySpell.dismiss"}}
            </button>
        </div>
        {{/if}}
    </div>
    {{/if}}

    {{!-- Player Copy Spell Roll Card --}}
    {{#if copySpellRollRequest}}
    {{> rollRequest rollRequest=copySpellRollRequest}}
    {{/if}}

    {{#if isGM}}
    {{#unless safeRestSpot}}
    {{> campLogisticsDrawer}}
    {{/unless}}
    {{/if}}

    {{#if (or (eq phase 'camp') (eq phase 'activity') (eq phase 'meal'))}}
    {{> restFooter}}
    {{/if}}

{{/if}}
</form>
