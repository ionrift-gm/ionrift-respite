                        <span class="roll-char-name">{{name}}</span>
                        <span class="roll-total">{{{localize "ionrift-respite.restSetup.events.rolledTotal" total=total}}}</span>
                        {{#unless ../isGroupAveraged}}
                        <span class="roll-badge {{#if passed}}pass{{else}}fail{{/if}}">
                            {{#if passed}}<i class="fas fa-check"></i> {{localize "ionrift-respite.restSetup.events.pass"}}{{else}}<i class="fas fa-times"></i> {{localize "ionrift-respite.restSetup.events.fail"}}{{/if}}
                        </span>
                        {{/unless}}
                    </div>
                    {{/each}}
                    {{#if groupAverage}}
                    <div class="event-roll-average">
