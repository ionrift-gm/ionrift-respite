{{!-- Ionrift Respite: Rest Setup Template (ApplicationV2) --}}
{{!-- Dual-mode: GM has full control, Players see shared campsite view --}}

<form class="respite-form">

{{#if isLoading}}
    <div class="respite-loading-state">
        <div class="respite-loading-spinner">
            <i class="fas fa-campground fa-2x fa-beat-fade" aria-hidden="true"></i>
        </div>
        <p class="respite-loading-label">Preparing camp&hellip;</p>
    </div>
{{else}}

    {{!-- Phase Indicator: pips and label come from phaseSteps, which only --}}
    {{!-- includes phases that actually run this rest (skipped travel/meal/events --}}
    {{!-- drop out so the dot count matches the real flow). --}}
    {{!-- Tier 1: Canonical Rest Header --}}
    {{> restHeader}}

    {{!-- Shared Terrain Artwork Banner --}}
    {{> terrainBanner}}

    {{!-- Setup keeps the small portrait row inside Advanced, matching the
         one-window rest. Later phases use the dock or this strip. --}}
    {{#unless (or (eq phase 'setup') (eq phase 'activity') (eq phase 'meal') (eq phase 'resolve') (eq phase 'dawn') (eq phase 'supper'))}}
    {{> rosterStrip}}
    {{/unless}}

    {{!-- Camp Status Bar: persistent across all phases post-setup --}}
    {{#if campStatus}}
    {{#unless (or (eq phase 'activity') (eq phase 'camp') (eq phase 'meal') (eq phase 'events') (eq phase 'dawn') (eq phase 'resolve') (eq phase 'supper'))}}
    <div class="camp-status-bar">
        {{!-- Comfort badge removed: the Camp Comfort section below covers this --}}
        {{#if campStatus.weather}}
        {{#unless (eq campStatus.weather "clear")}}
        <span class="camp-status-chip weather-chip" data-tooltip="{{campStatus.weatherTooltip}}">
            <i class="{{campStatus.weatherIcon}}"></i> {{campStatus.weatherLabel}}
        </span>
        {{/unless}}
        {{/if}}
        {{#each campStatus.activeShelters}}
        <span class="camp-status-chip shelter-chip shelter-chip-{{id}}" data-tooltip="{{tooltip}}">
            <i class="{{icon}}"></i> {{name}}
        </span>
        {{/each}}
        {{#unless campStatus.hasTent}}
        {{#unless safeRestSpot}}
        <span class="camp-status-chip shelter-chip absent" data-tooltip="No tent pitched. The camp is exposed to weather and easier for enemies to find.">
            <i class="fas fa-campground"></i> No Tent
        </span>
        {{else}}
        <span class="camp-status-chip shelter-chip absent" data-tooltip="No tent pitched. Weather flavor only in a safe rest spot.">
            <i class="fas fa-campground"></i> No Tent
        </span>
        {{/unless}}
        {{/unless}}
        {{!-- Fire badge removed: the fire section below covers this --}}
    </div>
    {{/unless}}
    {{/if}}


    {{!-- =============== SETUP PHASE =============== --}}
    {{#if (eq phase 'setup')}}

    {{#if isGM}}
    {{#if emptyParty}}
    <div class="respite-setup">
        <div class="respite-empty-party-hint">
            <i class="fas fa-users-slash"></i>
            {{#if (eq emptyPartyReason 'no_primary_party')}}
            <p>No primary party detected.</p>
            <p>A party group exists in this world but is not designated as the primary party. In the Actors sidebar, right-click the Group actor and choose <strong>Make Primary Party</strong>, then add your characters to it.</p>
            {{else if (eq emptyPartyReason 'primary_party_empty')}}
            <p>Primary party has no characters.</p>
            <p>Open the primary party group and drag player characters onto it, or add members from the Members tab.</p>
            <button type="button" class="btn-primary respite-empty-party-action" onclick="game.ionrift?.library?.party?.openNativeManagement?.() ?? ui.notifications.warn('Party management requires ionrift-library.');">
                <i class="fas fa-users"></i> Open Primary Party
            </button>
            {{else if (eq emptyPartyReason 'no_party_group')}}
            <p>No party group found.</p>
            <p>Create a Group actor in the Actors sidebar, add your player characters, then right-click it and choose <strong>Make Primary Party</strong>.</p>
            {{else if showPartyRosterEditor}}
            <p>No characters in the party roster.</p>
            <p>Create or import player-owned characters, then open Party Roster to choose who participates in Rest.</p>
            <button type="button" class="btn-primary respite-empty-party-action" onclick="const App = game.ionrift?.library?.PartyRosterApp; if (App) new App().render(true); else ui.notifications.warn('Party Roster requires ionrift-library.');">
                <i class="fas fa-users-cog"></i> Open Party Roster
            </button>
            {{else}}
            <p>No player-owned characters found.</p>
            <p>Create or import characters, assign them to players, then reopen Respite.</p>
            {{/if}}
        </div>
    </div>
    {{else}}
    <div class="respite-setup">

        {{#if partySetupWarning}}
        <div class="respite-party-setup-warning">
            <i class="fas fa-star-half-stroke" aria-hidden="true"></i>
            {{#if (eq partySetupWarning 'no_primary_party')}}
            <p><strong>No primary party detected.</strong> Rest is using characters from a non-primary group. Right-click the correct Group in the Actors sidebar and choose <strong>Make Primary Party</strong>.</p>
            {{/if}}
        </div>
        {{/if}}



        {{!-- Scene: Rest Type + Environment + Weather --}}
        <div class="scene-grid">
            <div class="form-group scene-rest-type">
                <label>Rest Type</label>
                <div class="rest-type-row">
                    <div class="rest-type-toggle">
                        <button type="button" class="rest-type-btn {{#unless (eq selectedRestType 'short')}}active{{/unless}}"
                            data-rest-type="long">
                            <i class="fas fa-moon"></i> {{#if isGrittyRealism}}Long Rest (7 Days){{else}}Long Rest{{/if}}
                        </button>
                        <button type="button" class="rest-type-btn {{#if (eq selectedRestType 'short')}}active{{/if}}"
                            data-rest-type="short">
                            <i class="{{#if isGrittyRealism}}fas fa-campground{{else}}fas fa-mug-hot{{/if}}"></i> {{#if isGrittyRealism}}Short Rest (8 Hours){{else}}Short Rest{{/if}}
                        </button>
                        <input type="hidden" name="restType" value="{{#if (eq selectedRestType 'short')}}short{{else}}long{{/if}}">
                    </div>
                    <div class="rest-type-controls-right">
                        {{#unless isShortRest}}
                        <label class="safe-rest-spot-toggle {{#if safeRestSpotDisplay}}is-active{{/if}}{{#if safeRestLocked}} is-locked{{/if}}{{#if safeRestPulse}} is-pulse{{/if}}" data-tooltip="{{safeRestTooltip}}">
                            <i class="fas fa-shield-halved" aria-hidden="true"></i>
                            <span class="safe-rest-spot-label">Safe Rest</span>
                            <span class="safe-rest-switch"><input type="checkbox" name="safeRestSpot" value="1" {{#if safeRestSpotDisplay}}checked{{/if}}{{#if safeRestLocked}} disabled{{/if}}><span class="safe-rest-slider"></span></span>
                        </label>
                        {{/unless}}
                        <button type="button"
                                class="dev-rest-variant-toggle {{#if isGrittyRealism}}is-gritty{{/if}}"
                                data-action="toggleDevRestVariant"
                                data-tooltip="Switch rest variant between Normal and Gritty Realism [Dev]">
                            <i class="fas fa-flask" aria-hidden="true"></i>
                            <span class="dev-variant-badge">DEV</span>
                            <span class="dev-variant-label">{{#if isGrittyRealism}}Gritty{{else}}Normal{{/if}}</span>
                        </button>
                    </div>
                </div>
            </div>

            {{#if showEnvironment}}
            <hr class="setup-divider scene-grid-full">

            <div class="form-group scene-environment">
                <label data-tooltip="{{terrainPreview}}">Environment:</label>
                <select name="terrain">
                    {{#each terrainOptionGroups}}
                    <optgroup label="{{group}}">
                        {{#each options}}
                        <option value="{{value}}" {{#if (eq value ../../selectedTerrain)}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                    </optgroup>
                    {{/each}}
                </select>
            </div>
            {{/if}}
            {{#if showWeather}}
            <div class="form-group scene-weather {{#if setupSafeHaven}}scene-weather-flavor{{/if}}">
                <label>Weather:</label>
                <select name="weather">
                    {{#each weatherOptions}}
                    <option value="{{value}}" title="{{hint}}" {{#if (eq value ../selectedWeather)}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                </select>
            </div>
            {{/if}}
        </div>

        {{#if showStatusLine}}
        <div class="setup-status-line-container">
            <span class="setup-status-pill" data-tooltip="Summary of terrain and weather effects">
                <i class="fas fa-campground"></i> {{setupStatusLine}}
            </span>
        </div>
        <hr class="setup-divider">
        {{/if}}

        {{#if restConfigBadges.length}}
        {{#if showConfigSummary}}
        <div class="rest-config-summary" data-tooltip="What this rest includes, based on module settings.">
            {{#each restConfigBadges}}
            <span class="rest-config-badge {{#if on}}is-on{{else}}is-off{{/if}}" data-tooltip="{{tooltip}}">
                <i class="{{icon}}"></i> {{label}}
            </span>
            {{/each}}
        </div>
        {{/if}}
        {{/if}}

        {{!-- Advanced Drawer (collapsed by default; open state survives day-stepper re-renders) --}}
        <details class="scene-advanced-drawer" {{#if setupAdvancedOpen}}open{{/if}}>
            <summary class="scene-advanced-toggle">
                <i class="fas fa-cog"></i> Advanced
            </summary>
            <div class="scene-advanced-body">
                {{!-- Party Roster --}}
                {{#if rosterInfo}}
                <div class="roster-indicator">
                    <div class="roster-indicator-portraits">
                        {{#each rosterInfo.portraits}}
                        <img class="roster-indicator-portrait" src="{{img}}" alt="{{name}}" data-tooltip="{{name}}">
                        {{/each}}
                        {{#if rosterInfo.overflow}}
                        <span class="roster-indicator-overflow">+{{rosterInfo.overflow}}</span>
                        {{/if}}
                    </div>
                    <span class="roster-indicator-label">{{rosterInfo.count}} characters</span>
                    <button type="button" class="roster-indicator-edit" onclick="const App = game.ionrift?.library?.PartyRosterApp; if (App) new App().render(true); else ui.notifications.warn('Party Roster requires ionrift-library.');" data-tooltip="Edit Party Roster">
                        <i class="fas fa-pencil-alt"></i>
                    </button>
                </div>
                {{/if}}
                <div class="form-group scene-rest-mode-override">
                    <label>Rest Interface</label>
                    <select name="restInterfaceMode" {{#if isGrittyLongRest}}disabled{{/if}}>
                        {{#each restModeOptions}}
                        <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
                        {{/each}}
                    </select>
                    <span class="comfort-hint">{{#if isGrittyLongRest}}Camp stations are not available for 7-day downtime. Rest uses the one-window ledger.{{else}}One window: this panel. Camp stations: pieces on the scene, move tokens to act.{{/if}}</span>
                </div>
            </div>
        </details>

    </div>
    <div class="respite-action-bar">
        {{#if isShortRest}}
        <button type="button" class="btn-primary" data-action="beginShortRest">
            <i class="{{#if isGrittyRealism}}fas fa-campground{{else}}fas fa-mug-hot{{/if}}"></i> {{#if isGrittyRealism}}Begin Overnight Rest{{else}}Begin Short Rest{{/if}}
        </button>
        {{else}}
        <button type="button" class="btn-primary" data-action="beginRest">
            <i class="{{#if isGrittyRealism}}fas fa-calendar-week{{else}}fas fa-campground{{/if}}"></i> {{#if isGrittyRealism}}Begin Rest (7-Day Downtime){{else}}Begin Rest{{/if}}
        </button>
        {{/if}}
    </div>
    {{/if}} {{!-- /emptyParty --}}
    {{else}}
    {{!-- Player: waiting for GM to start --}}
    <div class="respite-setup">
        <div class="respite-waiting-message">
            <i class="fas fa-campground"></i>
            <p>The GM is preparing the campsite...</p>
        </div>
    </div>
    {{/if}}
    {{/if}}

    {{!-- =============== MAKE CAMP PHASE =============== --}}
    {{#if (eq phase 'camp')}}

    {{!-- TotM or stations + comfort: unified Make Camp panel --}}
    {{#if showFullMakeCampPanel}}
    <div class="camp-phase-shell">
    {{> workflowStepper}}
    <div class="respite-make-camp">
    <div class="totm-camp-layout make-camp-unified">

        {{#unless safeRestSpot}}
        {{!-- LEFT: Personal Comfort (character-contextual) --}}
        <div class="totm-camp-comfort-panel">

            {{#if campPersonalSelected}}
            {{!-- ── Compact gear grid (2x2 icon tiles) ─────────────────── --}}
            <div class="totm-camp-factors-heading">Your Gear</div>
            <div class="totm-camp-factors-grid">
                <div class="totm-factor-tile {{#if campPersonalSelected.hasBedroll}}present{{else}}missing{{/if}}"
                     data-tooltip="{{#if campPersonalSelected.hasBedroll}}+1 personal comfort{{else}}Comfort stays at camp level{{/if}}">
                    <i class="fas fa-bed totm-factor-tile-icon" aria-hidden="true"></i>
                    <span class="totm-factor-tile-label">Bedroll</span>
                    {{#if campPersonalSelected.hasBedroll}}
                    <span class="totm-factor-tile-status present"><i class="fas fa-check" aria-hidden="true"></i></span>
                    {{else}}
                    <span class="totm-factor-tile-status missing"><i class="fas fa-times" aria-hidden="true"></i></span>
                    {{/if}}
                </div>
                <div class="totm-factor-tile {{#if campPersonalSelected.hasTent}}present{{else}}missing{{/if}}"
                     data-tooltip="{{#if campPersonalSelected.hasTent}}Weather shield active{{else}}No weather shield{{/if}}">
                    <i class="fas fa-campground totm-factor-tile-icon" aria-hidden="true"></i>
                    <span class="totm-factor-tile-label">Tent</span>
                    {{#if campPersonalSelected.hasTent}}
                    <span class="totm-factor-tile-status present"><i class="fas fa-check" aria-hidden="true"></i></span>
                    {{else}}
                    <span class="totm-factor-tile-status missing"><i class="fas fa-times" aria-hidden="true"></i></span>
                    {{/if}}
                </div>
                <div class="totm-factor-tile {{#if campPersonalSelected.hasMessKit}}present{{else}}missing{{/if}}"
                     data-tooltip="{{#if campPersonalSelected.hasMessKit}}Advantage on the exhaustion save (fire must be lit){{else}}No exhaustion-save advantage{{/if}}">
                    <i class="fas fa-utensils totm-factor-tile-icon" aria-hidden="true"></i>
                    <span class="totm-factor-tile-label">Mess Kit</span>
                    {{#if campPersonalSelected.hasMessKit}}
                    <span class="totm-factor-tile-status present"><i class="fas fa-check" aria-hidden="true"></i></span>
                    {{else}}
                    <span class="totm-factor-tile-status missing"><i class="fas fa-times" aria-hidden="true"></i></span>
                    {{/if}}
                </div>
                <div class="totm-factor-tile fire {{#if campColdCampDecided}}cold{{else if campFireIsLit}}present{{else}}missing{{/if}}"
                     data-tooltip="{{#if campColdCampDecided}}Cold camp: no fire, &minus;1 comfort, harder for enemies to spot.{{else if campFireIsLit}}{{#each campFirePickerLevels}}{{#if selected}}{{label}}: {{fireTierPlain id}}{{/if}}{{/each}}{{else}}No fire lit yet{{/if}}">
                    <i class="fas fa-fire totm-factor-tile-icon" aria-hidden="true"></i>
                    <span class="totm-factor-tile-label">Fire</span>
                    {{#if campFireIsLit}}
                    <span class="totm-factor-tile-status fire-active"><i class="fas fa-fire"></i></span>
                    {{else if campColdCampDecided}}
                    <span class="totm-factor-tile-status cold"><i class="fas fa-moon" aria-hidden="true"></i></span>
                    {{else}}
                    <span class="totm-factor-tile-status missing"><i class="fas fa-times" aria-hidden="true"></i></span>
                    {{/if}}
                </div>
            </div>

            {{!-- ── Comfort + recovery card ─────────────────────────── --}}
            <div class="totm-rest-card comfort-{{campPersonalSelected.personalComfort}}">
                <div class="totm-rest-card-header comfort-{{campPersonalSelected.personalComfort}}" data-tooltip="{{comfortHint campPersonalSelected.personalComfort}}" data-tooltip-direction="UP">
                    <span class="totm-rest-card-title">{{campPersonalSelected.personalComfortLabel}}</span>
                    <span class="totm-rest-card-subtitle">Your Rest</span>
                </div>
                <div class="totm-rest-card-body">
                    {{!-- HP chip --}}
                    <span class="totm-rest-chip {{#if campPersonalSelected.recovery.hpFull}}success{{else}}warning{{/if}}">
                        <i class="fas fa-heart" aria-hidden="true"></i>
                        {{campPersonalSelected.recovery.hpLabel}}
                    </span>
                    {{!-- HD chip --}}
                    <span class="totm-rest-chip {{#if campPersonalSelected.recovery.hdSeverity}}{{campPersonalSelected.recovery.hdSeverity}}{{else}}success{{/if}}">
                        <i class="fas fa-cube" aria-hidden="true"></i>
                        {{campPersonalSelected.recovery.hdLabel}}
                    </span>
                    {{!-- Exhaustion chip --}}
                    {{#if campPersonalSelected.recovery.exhaustionDC}}
                    <span class="totm-rest-chip {{campPersonalSelected.recovery.exhaustionSeverity}}">
                        <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                        {{campPersonalSelected.recovery.exhaustionLabel}}
                    </span>
                    {{else}}
                    <span class="totm-rest-chip success">
                        <i class="fas fa-shield-alt" aria-hidden="true"></i>
                        No exhaustion risk
                    </span>
                    {{/if}}
                </div>
            </div>

            {{else}}
            {{!-- ── No character selected: show party camp comfort ──────── --}}
            <div class="totm-camp-comfort-hero">
                <span class="totm-camp-comfort-label">Camp Comfort</span>
                <span class="totm-camp-comfort-tier-big comfort-{{campScanData.campComfort}}" data-tooltip="{{comfortHint campScanData.campComfort}}" data-tooltip-direction="UP">
                    {{campScanData.campComfortLabel}}
                </span>
            </div>
            {{#if mapComfortLine}}
            <p class="totm-camp-comfort-reason">{{mapComfortLine}}</p>
            {{/if}}
            <p class="totm-camp-no-selection">Select a character portrait above to see their personal comfort breakdown.</p>
            {{/if}}

        </div>
        {{else}}
        <div class="totm-camp-comfort-panel totm-safe-rest-note">
            <p class="totm-safe-rest-hint"><i class="fas fa-shield-alt" aria-hidden="true"></i> Safe rest spot: no comfort tiers or encounter pressure. Fire counts as lit for cooking.</p>
        </div>
        {{/unless}}

        {{!-- RIGHT: Campfire ceremony --}}
        <div class="totm-camp-fire-panel {{#if campFireIsLit}}fire-lit{{/if}} {{#if campColdCampDecided}}cold-camp{{/if}}">
            <div class="totm-camp-fire-header">
                <span class="totm-camp-fire-title"><i class="fas fa-fire" aria-hidden="true"></i> Campfire</span>
                {{#if campFireIsLit}}
                <span class="totm-camp-fire-status lit"><i class="fas fa-circle" aria-hidden="true"></i> {{campFireLabel}}</span>
                {{else if campColdCampDecided}}
                <span class="totm-camp-fire-status cold"><i class="fas fa-moon" aria-hidden="true"></i> Cold camp</span>
                {{else}}
                <span class="totm-camp-fire-status unlit"><i class="fas fa-circle" aria-hidden="true"></i> Unlit</span>
                {{/if}}
            </div>

            {{#unless safeRestSpot}}
            {{!-- Fire tier segmented control: synced tier picks; cold camp always available --}}
            <div class="totm-fire-segment-wrap">
                <div class="totm-fire-segments" role="radiogroup" aria-label="Fire intensity tiers">
                    <button type="button"
                            class="totm-fire-segment cold-camp {{#if campColdCampDecided}}selected{{else if campPreviewIsColdCamp}}selected{{/if}}"
                            data-tier="cold_camp"
                            {{#if campColdCampDecided}}aria-checked="true"{{else if campPreviewIsColdCamp}}aria-checked="true"{{else}}aria-checked="false"{{/if}}
                            role="radio"
                            {{#unless campColdCampDecided}}
                            data-action="selectCampColdCamp"
                            {{/unless}}>
                        <i class="fas fa-moon" aria-hidden="true"></i>
                        <span class="totm-fire-segment-label">Cold Camp</span>
                        <span class="totm-fire-segment-cost">No fire</span>
                    </button>
                    {{#each campFirePickerLevels}}
                    <button type="button"
                            class="totm-fire-segment {{#if selected}}selected{{/if}} {{#if disabled}}{{#unless @root.isGM}}disabled{{/unless}}{{/if}}"
                            data-tier="{{id}}"
                            {{#if disabled}}{{#unless @root.isGM}}disabled{{/unless}} data-tooltip="{{disabledReason}}"{{/if}}
                            {{#if selected}}aria-checked="true"{{else}}aria-checked="false"{{/if}}
                            role="radio"
                            {{#unless selected}}
                            data-action="selectCampFireLevel" data-fire-level="{{id}}"
                            {{/unless}}>
                        <span class="totm-fire-segment-label">{{label}}</span>
                        <span class="totm-fire-segment-cost">{{costLabel}}</span>
                    </button>
                    {{/each}}
                </div>
                {{#if campColdCampDecided}}
                <p class="totm-fire-segment-desc">No fire tonight. <span class="fire-penalty">&minus;1 comfort.</span> <span class="fire-benefit">Harder for enemies to spot (lower encounter chance).</span> No cooking.</p>
                {{else if campPreviewIsColdCamp}}
                <p class="totm-fire-segment-desc">No fire tonight. <span class="fire-penalty">&minus;1 comfort.</span> <span class="fire-benefit">Harder for enemies to spot (lower encounter chance).</span> No cooking.</p>
                {{else}}
                {{#each campFirePickerLevels}}
                {{#if selected}}
                <p class="totm-fire-segment-desc">{{> fireTierBody}}</p>
                {{/if}}
                {{/each}}
                {{/if}}

                {{#if showCampCeremonyMinigame}}
                {{#if campPitBlocksFireLighting}}
                <p class="totm-fire-bill-hint">{{#if isGM}}Place the campfire on the map (Place fire) before anyone can light it.{{else}}The GM must place the campfire on the map before you can light the fire.{{/if}} Wood staging is still allowed.</p>
                {{/if}}
                <div class="totm-camp-minigame-host"></div>
                {{else}}
                {{#unless campFireIsLit}}
                {{#unless campColdCampDecided}}
                {{#unless campPreviewIsColdCamp}}
                <div class="totm-fire-bill">
                    <div class="totm-fire-bill-line {{#if campHasEnoughFirewood}}met{{else}}unmet{{/if}}">
                        {{#if campHasEnoughFirewood}}
                        <i class="fas fa-check" aria-hidden="true"></i>
                        {{else}}
                        <i class="fas fa-times" aria-hidden="true"></i>
                        {{/if}}
                        <span>{{campSelectedFirewoodCost}} firewood needed</span>
                        <span class="totm-fire-bill-detail">(party has {{campPartyFirewood}})</span>
                    </div>
                    <div class="totm-fire-bill-line {{#if campCanLight}}met{{else}}unmet{{/if}}">
                        {{#if campCanLight}}
                        <i class="fas fa-check" aria-hidden="true"></i>
                        <span class="totm-fire-bill-lighter" data-tooltip="{{campFireLighterNames}}">
                            {{campFireLighters.length}} can light it
                        </span>
                        {{else}}
                        <i class="fas fa-times" aria-hidden="true"></i>
                        <span>No tinderbox or fire cantrip</span>
                        {{/if}}
                    </div>
                    {{#if campPitBlocksFireLighting}}
                    <div class="totm-fire-bill-line unmet">
                        <i class="fas fa-times" aria-hidden="true"></i>
                        <span>Campfire not on map yet</span>
                    </div>
                    {{/if}}

                    {{#if isGM}}
                    <button type="button" class="totm-fire-light-btn gm-light-submit"
                            data-action="campLightFire"
                            data-actor-id="__gm__"
                            data-method="Tinderbox"
                            {{#if campPitBlocksFireLighting}}disabled data-tooltip="Place the campfire on the map first."{{else}}data-tooltip="Optional. Players with gear see their own Light button. Use this as a GM override."{{/if}}>
                        <i class="fas fa-fire" aria-hidden="true"></i> Light it for them
                    </button>
                    {{else if campViewerCanLight}}
                    {{#each campFireLighters}}{{#if this.isViewerActor}}
                    <button type="button" class="totm-fire-light-btn player-light-submit"
                            data-action="campLightFire"
                            data-actor-id="{{this.actorId}}"
                            data-method="{{this.method}}">
                        <i class="fas fa-fire" aria-hidden="true"></i> Light
                    </button>
                    {{/if}}{{/each}}
                    {{else}}
                    <p class="totm-fire-bill-hint">
                        {{#if campFireLighters.length}}
                        Pick a fire tier above, or wait for {{campFireLighterNames}} or the GM.
                        {{else}}
                        Pick a fire tier above, choose cold camp, or ask the GM.
                        {{/if}}
                    </p>
                    {{/if}}
                </div>
                {{/unless}}
                {{/unless}}
                {{/unless}}
                {{/if}}
            </div>

            {{!-- Firewood pledges (after fire is lit) --}}
            {{#if campFireIsLit}}
            {{#if campFirewoodPledgeList.length}}
            <div class="totm-fire-pledges">
                <span class="totm-fire-pledges-label">Firewood pledged:</span>
                {{#each campFirewoodPledgeList}}
                <span class="totm-fire-pledge-entry">{{actorName}} ({{count}})</span>
                {{/each}}
            </div>
            {{/if}}
            {{/if}}
