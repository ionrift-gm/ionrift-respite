                            <div class="consequence-footer-bar">
                                <span class="consequence-timing-pill"><i class="fas fa-hourglass-end"></i> {{localize "ionrift-respite.restSetup.consequence.leavesPursesAtDawn"}}</span>
                            </div>
                            {{/if}}
                        </div>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                <div class="tree-narration-hint {{#if @root.allConsequencesResolved}}ready{{/if}}">
