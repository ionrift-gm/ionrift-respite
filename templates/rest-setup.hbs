                        {{/with}}
                        <span class="loss-actor-name">{{actorName}}</span>
                        <span class="loss-metric gold">{{{localize "ionrift-respite.restSetup.consequence.gpLoss" amount=lossGp}}}</span>
                    </div>
                    {{/each}}

