                <span class="totm-camp-fire-status cold"><i class="fas fa-moon" aria-hidden="true"></i> {{localize "ionrift-respite.restSetup.activity.coldStatus"}}</span>
                {{else}}
                <span class="totm-camp-fire-status unlit"><i class="fas fa-circle" aria-hidden="true"></i> {{localize "ionrift-respite.restSetup.camp.unlit"}}</span>
                {{/if}}
            </div>
        </div>

        {{!-- Tier picker retired from the aside: the dock hearth select
             owns tier selection. Cold-camp commit still lives in the
             aside via the Cold pill in the status header until the dock
             hearth grows an explicit commit affordance. --}}
        {{#unless safeRestSpot}}
        {{#unless (or campColdCampDecided campFireIsLit)}}
        <div class="totm-fire-cold-commit">
            <button type="button" class="totm-fire-cold-commit-btn"
                    data-action="selectCampColdCamp"
                    data-tooltip="{{localize "ionrift-respite.restSetup.activity.commitColdTooltip"}}">
                <i class="fas fa-moon" aria-hidden="true"></i> {{localize "ionrift-respite.restSetup.activity.commitCold"}}
            </button>
        </div>
        {{/unless}}
        {{/unless}}

        <div class="totm-campfire-minigame-host totm-camp-minigame-host"></div>
    </aside>
    {{/unless}}
    {{/if}}
    </div>{{!-- /totm-activity-layout --}}

    {{/if}} {{!-- /isTheaterMode --}}

    {{#if activityPhasePlayerOverview}}
    {{#unless isTheaterMode}}
    <div class="activity-phase-layout">
        <div class="respite-activities activity-phase-player-overview-wrap">
            <div class="player-overview-heading">
                <i class="fas fa-users" aria-hidden="true"></i>
                <span>{{localize "ionrift-respite.restSetup.playerOverview.heading"}}</span>
            </div>
            <p class="player-overview-lead">{{#if activityPhasePlayerOverview.simpleStations}}{{localize "ionrift-respite.restSetup.playerOverview.leadSimple"}}{{else}}{{#if activityPhasePlayerOverview.trackFood}}{{localize "ionrift-respite.restSetup.playerOverview.leadActivitiesAndRations"}}{{else}}{{localize "ionrift-respite.restSetup.playerOverview.leadActivities"}}{{/if}}{{/if}}</p>
            <div class="player-overview-stat">
                <span class="player-overview-label">{{localize "ionrift-respite.restSetup.playerOverview.withActivity"}}</span>
                <span class="player-overview-value">{{activityPhasePlayerOverview.resolvedCount}} / {{activityPhasePlayerOverview.totalCharacters}}</span>
            </div>
            <div class="player-overview-progress-track" role="progressbar"
                aria-valuenow="{{activityPhasePlayerOverview.resolvedCount}}"
                aria-valuemin="0"
                aria-valuemax="{{activityPhasePlayerOverview.totalCharacters}}">
                <div class="player-overview-progress-fill" style="width: {{activityPhasePlayerOverview.activityProgressPercent}}%;"></div>
            </div>
            {{#if activityPhasePlayerOverview.trackFood}}
            <div class="player-overview-stat">
                <span class="player-overview-label">{{localize "ionrift-respite.restSetup.playerOverview.withRations"}}</span>
                <span class="player-overview-value">{{activityPhasePlayerOverview.mealRationsSubmitted}} / {{activityPhasePlayerOverview.totalCharacters}}</span>
            </div>
            <div class="player-overview-progress-track player-overview-progress-track--meal" role="progressbar"
                aria-valuenow="{{activityPhasePlayerOverview.mealRationsSubmitted}}"
                aria-valuemin="0"
                aria-valuemax="{{activityPhasePlayerOverview.totalCharacters}}">
                <div class="player-overview-progress-fill" style="width: {{activityPhasePlayerOverview.mealRationsProgressPercent}}%;"></div>
            </div>
            {{/if}}
            {{#if activityPhasePlayerOverview.allResolved}}
            {{#if isGM}}
            <div class="respite-action-bar">
                {{> campfireDragHandle}}
                <button type="button" class="btn-primary" data-action="submitActivities">
                    <i class="{{activityProceed.icon}}"></i> {{activityProceed.label}}
                </button>
            </div>
            {{else}}
            <p class="player-overview-note"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {{localize "ionrift-respite.restSetup.playerOverview.waitingOnGm"}}</p>
            {{/if}}
            {{else if isGM}}
            <div class="respite-action-bar">
                {{> campfireDragHandle}}
                <button type="button" class="btn-primary disabled" disabled
                        data-tooltip="{{localize "ionrift-respite.restSetup.playerOverview.lockedTooltip" resolved=activityPhasePlayerOverview.resolvedCount total=activityPhasePlayerOverview.totalCharacters}}">
                    <i class="fas fa-lock"></i> {{activityProceed.label}}
                </button>
            </div>
            {{/if}}
        </div>
    </div>
    {{/unless}}
    {{/if}}
    {{/if}}

    {{!-- =============== MEAL PHASE =============== --}}
    {{#if (eq phase 'meal')}}
    {{!-- Character dock (mock: rest-dock-gritty). --}}
    {{> restDock}}
    <div class="activity-phase-layout">
    {{> restSustenanceWithFire}}
    {{!-- Campfire drawer: spatial mode only. TotM uses the activity-phase side panel. --}}
    {{#unless isTheaterMode}}
    <div class="campfire-drawer">
        <div class="campfire-drawer-content"></div>
    </div>
    {{/unless}}
    </div>{{!-- /activity-phase-layout --}}
    {{/if}}

    {{!-- =============== MEAL BUFFS: before the watch, only when someone has one =============== --}}
    {{#if (eq phase 'supper')}}
    <div class="events-phase-body">
        {{> mealBuffBeat}}
        <div class="respite-action-bar">
            {{#if isGM}}
            <button type="button" class="btn-primary" data-action="continueToNight"
                {{#if mealBuffPending}}disabled{{/if}}
                data-tooltip="{{#if mealBuffPending}}{{localize "ionrift-respite.restSetup.supper.applyFirst"}}{{else}}{{localize "ionrift-respite.restSetup.supper.onToNight"}}{{/if}}">
                <i class="fas fa-moon"></i> {{localize "ionrift-respite.restSetup.supper.onToNight"}}
            </button>
            {{else}}
            <span class="phase-waiting-label"><i class="fas fa-utensils"></i> {{localize "ionrift-respite.restSetup.supper.waitingForMeal"}}</span>
            {{/if}}
        </div>
    </div>
    {{/if}}

    {{!-- =============== EVENTS PHASE =============== --}}
    {{#if (eq phase 'events')}}
    <div class="events-phase-body{{#if (and eventsCommitPending (not eventsRolled))}} is-commit-pending{{/if}}">
        {{#if (and eventsCommitPending (not eventsRolled))}}
        <div class="events-commit-shield" role="status" aria-live="polite">
            <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
            <span>{{#if eventsModeIsPick}}{{localize "ionrift-respite.restSetup.events.openingPool"}}{{else}}{{localize "ionrift-respite.restSetup.events.rollingCheck"}}{{/if}}</span>
        </div>
        {{/if}}
    <div class="respite-events">

        {{#if eventsRolled}}
        {{!-- POST-ROLL: Show event results --}}

        {{!-- Disaster Choice: nat 1 GM pick --}}
        {{#if disasterChoice}}
        <div class="respite-event-card encounter disaster-choice-card">
            <div class="event-name"><i class="fas fa-skull"></i> {{localize "ionrift-respite.restSetup.disaster.title"}}</div>
            <div class="event-description">
                {{localize "ionrift-respite.restSetup.disaster.omen"}}
            </div>
            {{#if isGM}}
            <p class="disaster-guidance">{{localize "ionrift-respite.restSetup.disaster.guidance"}}</p>
            <div class="disaster-options count-{{disasterChoice.optionCount}}">
                {{#if disasterChoice.tree}}
                <div class="disaster-option-card tree">
                    <span class="disaster-option-label">{{localize "ionrift-respite.restSetup.disaster.optionNumber" number=disasterChoice.treeNum}}</span>
                    <i class="fas fa-skull disaster-option-icon"></i>
                    <strong class="disaster-option-title">{{localize "ionrift-respite.restSetup.disaster.disasterEvent"}}</strong>
                    <span class="disaster-option-preview">{{disasterChoice.tree.name}}</span>
                    <button type="button" class="disaster-option-select" data-action="disasterChoice" data-pick="tree" data-tooltip="{{localize "ionrift-respite.restSetup.disaster.treeTooltip"}}">{{localize "ionrift-respite.restSetup.disaster.select"}}</button>
                </div>
                {{/if}}
                {{#if disasterChoice.encounter}}
                <div class="disaster-option-card encounter">
                    <span class="disaster-option-label">{{localize "ionrift-respite.restSetup.disaster.optionNumber" number=disasterChoice.encounterNum}}</span>
                    <i class="fas fa-swords disaster-option-icon"></i>
                    <strong class="disaster-option-title">{{localize "ionrift-respite.restSetup.disaster.combatEncounter"}}</strong>
                    <span class="disaster-option-preview">{{disasterChoice.encounter.name}}</span>
                    <button type="button" class="disaster-option-select" data-action="disasterChoice" data-pick="encounter" data-tooltip="{{localize "ionrift-respite.restSetup.disaster.encounterTooltip"}}">{{localize "ionrift-respite.restSetup.disaster.select"}}</button>
                </div>
                {{/if}}
                {{#if disasterChoice.normals.length}}
                <div class="disaster-option-card normals">
                    <span class="disaster-option-label">{{localize "ionrift-respite.restSetup.disaster.optionNumber" number=disasterChoice.normalsNum}}</span>
                    <i class="fas fa-exclamation-triangle disaster-option-icon"></i>
                    <strong class="disaster-option-title">{{disasterChoice.normalsLabel}}</strong>
                    <span class="disaster-option-preview">
                        {{#each disasterChoice.normals}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}
                    </span>
                    <button type="button" class="disaster-option-select" data-action="disasterChoice" data-pick="normals" data-tooltip="{{localize "ionrift-respite.restSetup.disaster.normalsTooltip"}}">{{localize "ionrift-respite.restSetup.disaster.select"}}</button>
                </div>
                {{/if}}
            </div>
            <div class="disaster-dismiss">
                <button type="button" class="btn-override-link" data-action="disasterChoice" data-pick="dismiss" data-tooltip="{{localize "ionrift-respite.restSetup.disaster.dismissTooltip"}}">{{localize "ionrift-respite.restSetup.disaster.dismiss"}}</button>
            </div>
            {{else}}
            <div class="event-check-waiting">
                <i class="fas fa-skull"></i> {{localize "ionrift-respite.restSetup.disaster.gmDeciding"}}
            </div>
            {{/if}}
        </div>
        {{else}}

        {{!-- Decision Tree: Interactive choices (GM controls, players see obscured narrating state) --}}
        {{#if activeTreeState}}
        {{#if isGM}}
        <div class="respite-decision-tree">
            <div class="respite-event-card complication tree-active">
                <div class="event-name">
                    <span class="event-name-text"><i class="fas fa-exclamation-triangle"></i> {{activeTreeState.eventName}}</span>
                </div>
            </div>

            {{!-- Tree History (previous choices & per-roll consequences) --}}
            {{#each activeTreeState.history}}
            <div class="tree-history-entry {{#if result.success}}is-success{{else}}is-failure{{/if}}">
                <div class="tree-choice-made">
                    <i class="fas fa-arrow-right"></i>
                    <strong>{{choiceLabel}}</strong>
                    <span class="tree-result {{#if result.success}}success{{else}}failure{{/if}}">
                        {{#if result.success}}{{localize "ionrift-respite.restSetup.tree.passed"}}{{else}}{{localize "ionrift-respite.restSetup.tree.failed"}}{{/if}}
                        ({{result.passCount}}/{{result.rolls.length}})
                    </span>
                </div>
                {{#if consequence}}
                <div class="tree-step-consequence {{#if result.success}}is-success{{else}}is-failure{{/if}}">
                    <div class="tree-step-consequence-text">
                        <i class="fas {{#if result.success}}fa-shield-alt{{else}}fa-exclamation-circle{{/if}}"></i>
                        <span>{{consequence}}</span>
                    </div>
                    {{#if consequenceTags.length}}
                    <div class="tree-step-consequence-tags">
                        {{#each consequenceTags}}
                        <span class="tree-consequence-pill {{#if ../result.success}}pass{{else}}fail{{/if}}">{{this}}</span>
                        {{/each}}
                    </div>
                    {{/if}}
                </div>
                {{/if}}
            </div>
            {{/each}}

            {{!-- Current Prompt and Choices (GM adjudication) --}}
            {{#unless activeTreeState.resolved}}

            {{!-- Read-aloud: gmPrompt, then prompt, then description (see DecisionTreeResolver).
                 Decision question is a second line when scene and prompt differ.
                 GM steer and event checkContext stay collapsed for the GM. --}}
            <div class="event-narration-advisory lead tree-narration-block">
                <div class="narration-read-aloud">
                    <i class="fas fa-theater-masks"></i>
                    {{#if activeTreeState.readAloud}}
                    <span>{{activeTreeState.readAloud}}</span>
                    {{else}}
                    <em>{{localize "ionrift-respite.restSetup.tree.setScene"}}</em>
                    {{/if}}
                </div>
                {{#if activeTreeState.showDecisionPrompt}}
                <div class="tree-decision-prompt">
                    <i class="fas fa-question-circle"></i>
                    <span>{{activeTreeState.prompt}}</span>
                </div>
                {{/if}}
                {{#if activeTreeState.checkContext}}
                <div class="event-check-context tree-event-check-context">
                    <i class="fas fa-dice-d20"></i> {{activeTreeState.checkContext}}
                </div>
                {{/if}}
                {{#if activeTreeState.gmGuidance}}
                <details class="tree-gm-steer-expand">
                    <summary data-tooltip="{{localize "ionrift-respite.restSetup.tree.gmSteerTooltip"}}">
                        <i class="fas fa-chess-rook"></i> {{localize "ionrift-respite.restSetup.tree.gmSteer"}}
                    </summary>
                    <div class="tree-gm-steer-body">{{activeTreeState.gmGuidance}}</div>
                </details>
                {{/if}}
            </div>

            {{#if activeTreeState.awaitingRolls}}
            <div class="tree-awaiting-rolls">
                {{#if activeTreeState.rollRequestSent}}
                {{!-- === PHASE 2: Request sent, awaiting results === --}}
                <div class="tree-roll-header">
                    <i class="fas fa-dice-d20"></i>
                    {{localize "ionrift-respite.restSetup.tree.awaitingRolls" skill=activeTreeState.pendingSkillName dc=activeTreeState.pendingDC}}
                </div>
                <div class="tree-roll-dispatched-note">
                    <i class="fas fa-paper-plane"></i> {{localize "ionrift-respite.restSetup.tree.requestDispatched"}}
                </div>
                {{else}}
                {{!-- === PHASE 1: Configure modifiers before sending === --}}
                <div class="tree-roll-header tree-roll-header--configure">
                    <i class="fas fa-sliders-h"></i>
                    {{localize "ionrift-respite.restSetup.tree.configureModifiers" skill=activeTreeState.pendingSkillName dc=activeTreeState.pendingDC}}
                    {{#if activeTreeState.pendingCheckContext}}
                    <span class="choice-check-hint" data-tooltip="{{activeTreeState.pendingCheckContext}}"><i class="fas fa-circle-info"></i></span>
                    {{/if}}
                </div>
                <div class="tree-roll-configure-note">
                    <i class="fas fa-info-circle"></i> {{localize "ionrift-respite.restSetup.tree.configureNote"}}
                </div>
                {{/if}}
                {{!-- Spell rulings advisory --}}
                {{#if activeTreeState.pendingChoiceSpellRulings}}
                <div class="tree-spell-rulings-advisory">
                    <i class="fas fa-hat-wizard"></i>
                    <span>{{activeTreeState.pendingChoiceSpellRulings}}</span>
                </div>
                {{/if}}
                {{!-- Resolved rolls: compact result line, unchanged --}}
                {{#if activeTreeState.resolvedRolls.length}}
                <div class="tree-roll-tracker">
                    {{#each activeTreeState.resolvedRolls}}
                    <div class="tree-roll-entry resolved">
                        <span class="roll-name">{{name}}</span>
                        <span class="roll-total {{#if passed}}pass{{else}}fail{{/if}}">{{total}}</span>
                        <i class="fas {{#if passed}}fa-check-circle{{else}}fa-times-circle{{/if}}"></i>
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                {{!-- Pending rolls: click portrait to cycle normal, adv, dis, auto-pass, auto-fail --}}
                {{#if activeTreeState.pendingRollsEnriched.length}}
                <div class="check-module-avatars tree-roll-avatars">
                    {{#each activeTreeState.pendingRollsEnriched}}
                    <div class="tree-roll-avatar-cell">
                        <button type="button"
                            class="check-avatar{{#if rollModeAdvantage}} adv{{/if}}{{#if rollModeDisadvantage}} dis{{/if}}{{#if rollModeForcePass}} forced-pass{{/if}}{{#if rollModeForceFail}} forced-fail{{/if}}"
                            data-action="cycleTreeRollMode"
                            data-character-id="{{id}}"
                            data-tooltip="{{name}} &middot; {{#if rollModeForcePass}}{{localize "ionrift-respite.restSetup.rollMode.autoPass"}}{{else if rollModeForceFail}}{{localize "ionrift-respite.restSetup.rollMode.autoFail"}}{{else if rollModeAdvantage}}{{localize "ionrift-respite.restSetup.rollMode.advantage"}}{{else if rollModeDisadvantage}}{{localize "ionrift-respite.restSetup.rollMode.disadvantage"}}{{else}}{{localize "ionrift-respite.restSetup.rollMode.normal"}}{{/if}} &middot; {{localize "ionrift-respite.restSetup.rollMode.clickToCycle"}}">
                            <img src="{{img}}" alt="{{name}}" />
                            {{#if rollModeAdvantage}}<span class="check-avatar-mode adv"><i class="fas fa-angle-up"></i></span>{{/if}}
                            {{#if rollModeDisadvantage}}<span class="check-avatar-mode dis"><i class="fas fa-angle-down"></i></span>{{/if}}
                            {{#if rollModeForcePass}}<span class="check-avatar-mode force-pass"><i class="fas fa-check"></i></span>{{/if}}
                            {{#if rollModeForceFail}}<span class="check-avatar-mode force-fail"><i class="fas fa-times"></i></span>{{/if}}
                        </button>
                        {{#if @root.activeTreeState.rollRequestSent}}
                        <button type="button" class="btn-roll-for-player tree-roll-for-player" data-action="rollTreeForPlayer" data-character-id="{{id}}" data-tooltip="{{localize "ionrift-respite.restSetup.tree.rollForPlayer"}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                <div class="tree-roll-actions">
                    {{#if activeTreeState.rollRequestSent}}
                    <button type="button" class="btn-resend-roll" data-action="resendTreeRollRequest" data-tooltip="{{localize "ionrift-respite.restSetup.tree.resendTooltip"}}">
                        <i class="fas fa-paper-plane"></i> {{localize "ionrift-respite.restSetup.tree.resend"}}
                    </button>
                    {{else}}
                    <button type="button" class="btn-send-roll-request" data-action="sendTreeRollRequest" data-tooltip="{{localize "ionrift-respite.restSetup.tree.sendTooltip"}}">
                        <i class="fas fa-paper-plane"></i> {{localize "ionrift-respite.restSetup.tree.sendRequest"}}
                    </button>
                    {{/if}}
                </div>
            </div>

            {{else}}
            {{!-- Centralized Disaster Severity Adjudication Bar --}}
            <div class="disaster-adjudication-bar">
                <div class="adjudication-meta">
                    <span class="adjudication-title"><i class="fas fa-sliders-h"></i> {{localize "ionrift-respite.restSetup.tree.disasterDifficulty"}}</span>
                    <span class="adjudication-hint">{{localize "ionrift-respite.restSetup.tree.difficultyHint"}}</span>
                </div>
                <div class="adjudication-stepper">
                    <button type="button" class="btn-step" data-action="treeDcAdjDown" data-tooltip="{{localize "ionrift-respite.restSetup.tree.lowerAllDc"}}">&minus;</button>
                    <span class="adjudication-dc-chip">{{#if (eq activeTreeState.treeDcAdj 0)}}{{localize "ionrift-respite.restSetup.tree.standardDc"}}{{else if (gt activeTreeState.treeDcAdj 0)}}{{localize "ionrift-respite.restSetup.tree.dcPlus" adj=activeTreeState.treeDcAdj}}{{else}}{{localize "ionrift-respite.restSetup.tree.dcMinus" adj=activeTreeState.treeDcAdj}}{{/if}}</span>
                    <button type="button" class="btn-step" data-action="treeDcAdjUp" data-tooltip="{{localize "ionrift-respite.restSetup.tree.raiseAllDc"}}">+</button>
                </div>
            </div>

            <div class="tree-choices">
                {{#each activeTreeState.options}}
                <div class="tree-choice-card disaster-option-card tree">
                    <div class="tree-choice-top">
                        <span class="disaster-option-label">{{localize "ionrift-respite.restSetup.disaster.optionNumber" number=optionNum}}</span>
                        <strong class="disaster-option-title">{{label}}</strong>
                        {{#if description}}<div class="choice-description">{{description}}</div>{{/if}}
                        {{#if spellRulings}}<div class="choice-spell-rulings"><i class="fas fa-hat-wizard"></i>{{spellRulings}}</div>{{/if}}
                    </div>
                    <div class="tree-choice-bottom">
                        <div class="choice-check">
                            <span class="skill-best-of">{{localize "ionrift-respite.restSetup.tree.bestOf"}}</span>
                            {{#each check.skills}}
                            {{#if @index}}<span class="skill-sep">/</span>{{/if}}
                            <span class="skill-tag">{{this}}</span>
                            {{/each}}
                            {{#if check.checkContext}}
                            <span class="choice-check-hint" data-tooltip="{{check.checkContext}}"><i class="fas fa-circle-info"></i></span>
                            {{/if}}
                        </div>
                        <div class="choice-dc-module">
                            <div class="event-dc-badge circular tree-choice-dc-badge">
                                <span class="dc-label">{{localize "ionrift-respite.restSetup.events.dcLabel"}}</span>
                                <span class="dc-value">{{check.dc}}</span>
                            </div>
                        </div>
                        <button type="button" class="disaster-option-select btn-ionrift-choice" data-action="resolveTreeChoice" data-choice-id="{{id}}" data-tooltip="{{localize "ionrift-respite.restSetup.tree.commitTooltip"}}">
                            {{localize "ionrift-respite.restSetup.disaster.select"}} <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
                {{/each}}
            </div>
            {{#if activeTreeState.treeDcAdjNote}}
            <div class="tree-dc-adj-note">
                <i class="fas fa-sliders-h"></i> {{activeTreeState.treeDcAdjNote}}
            </div>
            {{/if}}

            {{#if activeTreeState.hasStallPenalty}}
            <div class="tree-stall-area">
                <button type="button" class="btn-stall-penalty" data-action="applyStallPenalty"
                    data-tooltip="{{localize "ionrift-respite.restSetup.tree.stallTooltip" bump=activeTreeState.stallPenalty.dcBump}}">
                    <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.restSetup.tree.playersStalling"}}
                </button>
                <span class="stall-hint-text">{{{localize "ionrift-respite.restSetup.tree.stallHint"}}}</span>
                {{#if activeTreeState.stallCount}}
                <span class="stall-applied-count">
                    <i class="fas fa-exclamation-triangle"></i> {{localize "ionrift-respite.restSetup.tree.stallApplied" count=activeTreeState.stallCount bump=activeTreeState.totalStallBump}}{{#if activeTreeState.stallConsequence}} &middot; {{activeTreeState.stallConsequence}}{{/if}}
                </span>
                {{/if}}
            </div>
            {{/if}}
            {{/if}}
            {{/unless}}

            {{!-- Resolved Outcome (GM View) --}}
            {{#if activeTreeState.resolved}}
            <div class="tree-resolved">
                <div class="tree-outcome-header">
                    <i class="fas fa-flag-checkered"></i> {{localize "ionrift-respite.restSetup.tree.outcome"}}
                </div>
                <div class="tree-final-narrative">{{activeTreeState.finalNarrative}}</div>
                {{#if activeTreeState.finalEffects.length}}
                <div class="tree-effects event-effects">
                    <div class="tree-effects-header">{{localize "ionrift-respite.restSetup.tree.consequences"}}</div>
                    {{#each activeTreeState.finalEffects}}
                    <div class="event-effect{{#if _locked}} locked{{/if}}">
                        <div class="effect-head">
                            <span class="effect-label">
                            {{#if (eq type "damage")}}<i class="fas fa-heart-broken"></i> {{formula}} {{damageType}}
                            {{else if (eq type "condition")}}<span class="effect-condition-severe"><i class="fas fa-skull-crossbones"></i> {{condition}}{{#if level}} {{localize "ionrift-respite.restSetup.consequence.conditionLevel" level=level}}{{/if}}{{#if scope}} <span class="effect-scope">({{scope}})</span>{{/if}}</span>
                            {{else if (eq type "supply_loss")}}<i class="fas fa-box-open"></i> {{#if description}}{{description}}{{else}}{{localize "ionrift-respite.restSetup.consequence.suppliesSwept"}}{{/if}}
                            {{else if (eq type "item_at_risk")}}<i class="fas fa-box-open"></i> {{#if narrative}}{{narrative}}{{else}}{{localize "ionrift-respite.restSetup.consequence.gearLost"}}{{/if}}
                            {{else if (eq type "consume_gold")}}<i class="fas fa-coins"></i> {{#if description}}{{description}}{{else}}{{localize "ionrift-respite.restSetup.consequence.coinSwept"}}{{/if}}
                            {{else}}<i class="fas fa-bolt"></i> {{description}}
