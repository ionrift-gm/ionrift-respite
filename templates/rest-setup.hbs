            </button>
            {{else}}
            <span class="phase-waiting-label"><i class="fas fa-utensils"></i> Waiting for the meal</span>
            {{/if}}
        </div>
    </div>
    {{/if}}

    {{!-- =============== EVENTS PHASE =============== --}}
    {{#if (eq phase 'events')}}
    <div class="events-phase-body{{#if (and eventsCommitPending (not eventsRolled))}} is-commit-pending{{/if}}">
        {{#if (and eventsCommitPending (not eventsRolled))}}
        <div class="events-commit-shield" role="status" aria-live="polite">
            <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
            <span>{{#if eventsModeIsPick}}Opening event pool...{{else}}Rolling night check...{{/if}}</span>
        </div>
        {{/if}}
    <div class="respite-events">

        {{#if eventsRolled}}
        {{!-- POST-ROLL: Show event results --}}

        {{!-- Disaster Choice: nat 1 GM pick --}}
        {{#if disasterChoice}}
        <div class="respite-event-card encounter disaster-choice-card">
            <div class="event-name"><i class="fas fa-skull"></i> Natural 1: disaster pool</div>
            <div class="event-description">
                A terrible omen. Choose how the night unfolds.
            </div>
            {{#if isGM}}
            <p class="disaster-guidance">Pick one outcome. A disaster event is a branching scene of skill checks, a combat encounter pulls a monster into camp, and the lighter option runs one or more ordinary events. Dismiss if the night should simply pass.</p>
            <div class="disaster-options count-{{disasterChoice.optionCount}}">
                {{#if disasterChoice.tree}}
                <div class="disaster-option-card tree">
                    <span class="disaster-option-label">Option {{disasterChoice.treeNum}}</span>
                    <i class="fas fa-skull disaster-option-icon"></i>
                    <strong class="disaster-option-title">Disaster Event</strong>
                    <span class="disaster-option-preview">{{disasterChoice.tree.name}}</span>
                    <button type="button" class="disaster-option-select" data-action="disasterChoice" data-pick="tree" data-tooltip="Run a branching disaster scene: a sequence of skill checks with consequences.">Select</button>
                </div>
                {{/if}}
                {{#if disasterChoice.encounter}}
                <div class="disaster-option-card encounter">
                    <span class="disaster-option-label">Option {{disasterChoice.encounterNum}}</span>
                    <i class="fas fa-swords disaster-option-icon"></i>
                    <strong class="disaster-option-title">Combat Encounter</strong>
                    <span class="disaster-option-preview">{{disasterChoice.encounter.name}}</span>
                    <button type="button" class="disaster-option-select" data-action="disasterChoice" data-pick="encounter" data-tooltip="Drop a combat encounter into the camp.">Select</button>
                </div>
                {{/if}}
                {{#if disasterChoice.normals.length}}
                <div class="disaster-option-card normals">
                    <span class="disaster-option-label">Option {{disasterChoice.normalsNum}}</span>
                    <i class="fas fa-exclamation-triangle disaster-option-icon"></i>
                    <strong class="disaster-option-title">{{disasterChoice.normalsLabel}}</strong>
                    <span class="disaster-option-preview">
                        {{#each disasterChoice.normals}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}
                    </span>
                    <button type="button" class="disaster-option-select" data-action="disasterChoice" data-pick="normals" data-tooltip="Run one or more ordinary camp events instead of a full disaster.">Select</button>
                </div>
                {{/if}}
            </div>
            <div class="disaster-dismiss">
                <button type="button" class="btn-override-link" data-action="disasterChoice" data-pick="dismiss" data-tooltip="Skip the disaster: the night passes with no event.">Dismiss and continue</button>
            </div>
            {{else}}
            <div class="event-check-waiting">
                <i class="fas fa-skull"></i> Something terrible stirs. The GM is deciding...
            </div>
            {{/if}}
        </div>
        {{else}}

        {{!-- Decision Tree: Interactive choices (GM controls, players see obscured narrating state) --}}
        {{#if activeTreeState}}
        {{#if isGM}}
        <div class="respite-decision-tree">
            <div class="respite-event-card complication tree-active">
                <div class="event-name">
                    <span class="event-name-text"><i class="fas fa-exclamation-triangle"></i> {{activeTreeState.eventName}}</span>
                </div>
            </div>

            {{!-- Tree History (previous choices) --}}
            {{#each activeTreeState.history}}
            <div class="tree-history-entry">
                <div class="tree-choice-made">
                    <i class="fas fa-arrow-right"></i>
                    <strong>{{choiceLabel}}</strong>
                    <span class="tree-result {{#if result.success}}success{{else}}failure{{/if}}">
                        {{#if result.success}}Passed{{else}}Failed{{/if}}
                        ({{result.passCount}}/{{result.rolls.length}})
                    </span>
                </div>
            </div>
            {{/each}}

            {{!-- Current Prompt and Choices (GM adjudication) --}}
            {{#unless activeTreeState.resolved}}

            {{!-- Read-aloud: gmPrompt, then prompt, then description (see DecisionTreeResolver).
                 Decision question is a second line when scene and prompt differ.
                 GM steer and event checkContext stay collapsed for the GM. --}}
            <div class="event-narration-advisory lead tree-narration-block">
                <div class="narration-read-aloud">
                    <i class="fas fa-theater-masks"></i>
                    {{#if activeTreeState.readAloud}}
                    <span>{{activeTreeState.readAloud}}</span>
                    {{else}}
                    <em>Set the scene, then present the options below.</em>
                    {{/if}}
                </div>
                {{#if activeTreeState.showDecisionPrompt}}
                <div class="tree-decision-prompt">
                    <i class="fas fa-question-circle"></i>
                    <span>{{activeTreeState.prompt}}</span>
                </div>
                {{/if}}
                {{#if activeTreeState.checkContext}}
                <div class="event-check-context tree-event-check-context">
                    <i class="fas fa-dice-d20"></i> {{activeTreeState.checkContext}}
                </div>
                {{/if}}
                {{#if activeTreeState.gmGuidance}}
                <details class="tree-gm-steer-expand">
                    <summary data-tooltip="Expand for pacing, option notes, and stall rules">
                        <i class="fas fa-chess-rook"></i> GM steer
                    </summary>
                    <div class="tree-gm-steer-body">{{activeTreeState.gmGuidance}}</div>
                </details>
                {{/if}}
            </div>

            {{#if activeTreeState.awaitingRolls}}
            <div class="tree-awaiting-rolls">
                {{#if activeTreeState.rollRequestSent}}
                {{!-- === PHASE 2: Request sent, awaiting results === --}}
                <div class="tree-roll-header">
                    <i class="fas fa-dice-d20"></i>
                    Awaiting Player Rolls: {{activeTreeState.pendingSkillName}} DC {{activeTreeState.pendingDC}}
                </div>
                <div class="tree-roll-dispatched-note">
                    <i class="fas fa-paper-plane"></i> Roll request dispatched. Players will see their roll button now.
                </div>
                {{else}}
                {{!-- === PHASE 1: Configure modifiers before sending === --}}
                <div class="tree-roll-header tree-roll-header--configure">
                    <i class="fas fa-sliders-h"></i>
                    Configure Roll Modifiers: {{activeTreeState.pendingSkillName}} DC {{activeTreeState.pendingDC}}
                    {{#if activeTreeState.pendingCheckContext}}
                    <span class="choice-check-hint" data-tooltip="{{activeTreeState.pendingCheckContext}}"><i class="fas fa-circle-info"></i></span>
                    {{/if}}
                </div>
                <div class="tree-roll-configure-note">
                    <i class="fas fa-info-circle"></i> Set modifiers per character, then send the roll request to players.
                </div>
                {{/if}}
                {{!-- Spell rulings advisory --}}
                {{#if activeTreeState.pendingChoiceSpellRulings}}
                <div class="tree-spell-rulings-advisory">
                    <i class="fas fa-hat-wizard"></i>
                    <span>{{activeTreeState.pendingChoiceSpellRulings}}</span>
                </div>
                {{/if}}
                {{!-- Resolved rolls: compact result line, unchanged --}}
                {{#if activeTreeState.resolvedRolls.length}}
                <div class="tree-roll-tracker">
                    {{#each activeTreeState.resolvedRolls}}
                    <div class="tree-roll-entry resolved">
                        <span class="roll-name">{{name}}</span>
                        <span class="roll-total {{#if passed}}pass{{else}}fail{{/if}}">{{total}}</span>
                        <i class="fas {{#if passed}}fa-check-circle{{else}}fa-times-circle{{/if}}"></i>
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                {{!-- Pending rolls: click portrait to cycle normal, adv, dis, auto-pass, auto-fail --}}
                {{#if activeTreeState.pendingRollsEnriched.length}}
                <div class="check-module-avatars tree-roll-avatars">
                    {{#each activeTreeState.pendingRollsEnriched}}
                    <div class="tree-roll-avatar-cell">
                        <button type="button"
                            class="check-avatar{{#if rollModeAdvantage}} adv{{/if}}{{#if rollModeDisadvantage}} dis{{/if}}{{#if rollModeForcePass}} forced-pass{{/if}}{{#if rollModeForceFail}} forced-fail{{/if}}"
                            data-action="cycleTreeRollMode"
                            data-character-id="{{id}}"
                            data-tooltip="{{name}} &middot; {{#if rollModeForcePass}}Auto-pass{{else if rollModeForceFail}}Auto-fail{{else if rollModeAdvantage}}Advantage{{else if rollModeDisadvantage}}Disadvantage{{else}}Normal{{/if}} &middot; click to cycle">
                            <img src="{{img}}" alt="{{name}}" />
                            {{#if rollModeAdvantage}}<span class="check-avatar-mode adv"><i class="fas fa-angle-up"></i></span>{{/if}}
                            {{#if rollModeDisadvantage}}<span class="check-avatar-mode dis"><i class="fas fa-angle-down"></i></span>{{/if}}
                            {{#if rollModeForcePass}}<span class="check-avatar-mode force-pass"><i class="fas fa-check"></i></span>{{/if}}
                            {{#if rollModeForceFail}}<span class="check-avatar-mode force-fail"><i class="fas fa-times"></i></span>{{/if}}
                        </button>
                        {{#if @root.activeTreeState.rollRequestSent}}
                        <button type="button" class="btn-roll-for-player tree-roll-for-player" data-action="rollTreeForPlayer" data-character-id="{{id}}" data-tooltip="Roll on their behalf">
                            <i class="fas fa-dice"></i>
                        </button>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                <div class="tree-roll-actions">
                    {{#if activeTreeState.rollRequestSent}}
                    <button type="button" class="btn-resend-roll" data-action="resendTreeRollRequest" data-tooltip="Re-send the roll request to players">
                        <i class="fas fa-paper-plane"></i> Resend
                    </button>
                    {{else}}
                    <button type="button" class="btn-send-roll-request" data-action="sendTreeRollRequest" data-tooltip="Dispatch roll request to all players with current modifiers">
                        <i class="fas fa-paper-plane"></i> Send Roll Request
                    </button>
                    {{/if}}
                </div>
            </div>

            {{else}}
            {{!-- Centralized Disaster Severity Adjudication Bar --}}
            <div class="disaster-adjudication-bar">
                <div class="adjudication-meta">
                    <span class="adjudication-title"><i class="fas fa-sliders-h"></i> Disaster Difficulty</span>
                    <span class="adjudication-hint">Adjusts base difficulty across all options</span>
                </div>
                <div class="adjudication-stepper">
                    <button type="button" class="btn-step" data-action="treeDcAdjDown" data-tooltip="Lower the DC on all choices">&minus;</button>
                    <span class="adjudication-dc-chip">{{#if (eq activeTreeState.treeDcAdj 0)}}Standard DC{{else if (gt activeTreeState.treeDcAdj 0)}}+{{activeTreeState.treeDcAdj}} DC{{else}}{{activeTreeState.treeDcAdj}} DC{{/if}}</span>
                    <button type="button" class="btn-step" data-action="treeDcAdjUp" data-tooltip="Raise the DC on all choices">+</button>
                </div>
            </div>

            <div class="tree-choices">
                {{#each activeTreeState.options}}
                <div class="tree-choice-card disaster-option-card tree">
                    <div class="tree-choice-top">
                        <span class="disaster-option-label">Option {{optionNum}}</span>
                        <strong class="disaster-option-title">{{label}}</strong>
                        {{#if description}}<div class="choice-description">{{description}}</div>{{/if}}
                        {{#if spellRulings}}<div class="choice-spell-rulings"><i class="fas fa-hat-wizard"></i>{{spellRulings}}</div>{{/if}}
                    </div>
                    <div class="tree-choice-bottom">
                        <div class="choice-check">
                            <span class="skill-best-of">Best of</span>
                            {{#each check.skills}}
                            {{#if @index}}<span class="skill-sep">/</span>{{/if}}
                            <span class="skill-tag">{{this}}</span>
                            {{/each}}
                            {{#if check.checkContext}}
                            <span class="choice-check-hint" data-tooltip="{{check.checkContext}}"><i class="fas fa-circle-info"></i></span>
                            {{/if}}
                        </div>
                        <div class="choice-dc-module">
                            <div class="event-dc-badge circular tree-choice-dc-badge">
                                <span class="dc-label">DC</span>
                                <span class="dc-value">{{check.dc}}</span>
                            </div>
                        </div>
                        <button type="button" class="disaster-option-select btn-ionrift-choice" data-action="resolveTreeChoice" data-choice-id="{{id}}" data-tooltip="Commit to this approach, then configure and roll the check.">
                            Select <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
                {{/each}}
            </div>
            {{#if activeTreeState.treeDcAdjNote}}
            <div class="tree-dc-adj-note">
                <i class="fas fa-sliders-h"></i> {{activeTreeState.treeDcAdjNote}}
            </div>
            {{/if}}

            {{#if activeTreeState.hasStallPenalty}}
            <div class="tree-stall-area">
                <button type="button" class="btn-stall-penalty" data-action="applyStallPenalty"
                    data-tooltip="Apply when players stall or bargain for a third option. DCs +{{activeTreeState.stallPenalty.dcBump}}, supplies lost to the delay. Can be applied multiple times.">
                    <i class="fas fa-hourglass-half"></i> Players Stalling
                </button>
                <span class="stall-hint-text">Third option bid &middot; negotiating between choices &middot; repeating answered questions</span>
                {{#if activeTreeState.stallCount}}
                <span class="stall-applied-count">
                    <i class="fas fa-exclamation-triangle"></i> Applied {{activeTreeState.stallCount}}x. DCs +{{activeTreeState.totalStallBump}}, supplies lost
                </span>
                {{/if}}
            </div>
            {{/if}}
            {{/if}}
            {{/unless}}

            {{!-- Resolved Outcome (GM View) --}}
            {{#if activeTreeState.resolved}}
            <div class="tree-resolved">
                <div class="tree-outcome-header">
                    <i class="fas fa-flag-checkered"></i> Outcome
                </div>
                <div class="tree-final-narrative">{{activeTreeState.finalNarrative}}</div>
                {{#if activeTreeState.finalEffects.length}}
                <div class="tree-effects event-effects">
                    <div class="tree-effects-header">Consequences</div>
                    {{#each activeTreeState.finalEffects}}
                    <div class="event-effect{{#if _locked}} locked{{/if}}">
                        <div class="effect-head">
                            <span class="effect-label">
                            {{#if (eq type "damage")}}<i class="fas fa-heart-broken"></i> {{formula}} {{damageType}}
                            {{else if (eq type "condition")}}<span class="effect-condition-severe"><i class="fas fa-skull-crossbones"></i> {{condition}}{{#if level}} (level {{level}}){{/if}}{{#if scope}} <span class="effect-scope">({{scope}})</span>{{/if}}</span>
                            {{else if (eq type "supply_loss")}}<i class="fas fa-box-open"></i> {{#if description}}{{description}}{{else}}Supplies swept away{{/if}}
                            {{else if (eq type "item_at_risk")}}<i class="fas fa-box-open"></i> {{#if narrative}}{{narrative}}{{else}}Gear lost in the chaos{{/if}}
                            {{else if (eq type "consume_gold")}}<i class="fas fa-coins"></i> {{#if description}}{{description}}{{else}}Coin swept away{{/if}}
                            {{else}}<i class="fas fa-bolt"></i> {{description}}
                            {{/if}}
                            </span>
                            {{#if (eq type "damage")}}
                            {{#if _locked}}<button type="button" class="effect-reroll" data-action="lockEventConsequence" data-event-index="{{@root.activeTreeState.eventIndex}}" data-effect-index="{{@index}}" data-tooltip="Re-roll target and damage"><i class="fas fa-rotate"></i></button>
                            {{else}}<button type="button" class="btn-lock-consequence" data-action="lockEventConsequence" data-event-index="{{@root.activeTreeState.eventIndex}}" data-effect-index="{{@index}}" data-tooltip="Roll the target and damage now and lock it in. The hit lands after the rest, so the night's recovery can't heal it away."><i class="fas fa-dice-d20"></i> Roll &amp; lock</button>{{/if}}
                            {{else if (eq type "supply_loss")}}
                            {{#if _locked}}<button type="button" class="effect-reroll" data-action="lockEventConsequence" data-event-index="{{@root.activeTreeState.eventIndex}}" data-effect-index="{{@index}}" data-tooltip="Re-roll how much is swept away"><i class="fas fa-rotate"></i></button>
                            {{else}}<button type="button" class="btn-lock-consequence" data-action="lockEventConsequence" data-event-index="{{@root.activeTreeState.eventIndex}}" data-effect-index="{{@index}}" data-tooltip="Roll how much is swept away now and lock it in. It leaves the packs when the rest resolves."><i class="fas fa-dice-d20"></i> Roll &amp; lock</button>{{/if}}
                            {{else if (eq type "item_at_risk")}}
                            {{#if _locked}}<button type="button" class="effect-reroll" data-action="lockEventConsequence" data-event-index="{{@root.activeTreeState.eventIndex}}" data-effect-index="{{@index}}" data-tooltip="Re-roll which gear is lost"><i class="fas fa-rotate"></i></button>
                            {{else}}<button type="button" class="btn-lock-consequence" data-action="lockEventConsequence" data-event-index="{{@root.activeTreeState.eventIndex}}" data-effect-index="{{@index}}" data-tooltip="Roll which gear is lost now and lock it in. It leaves the packs when the rest resolves."><i class="fas fa-dice-d20"></i> Roll &amp; lock</button>{{/if}}
                            {{else if (eq type "consume_gold")}}
                            {{#if _locked}}<button type="button" class="effect-reroll" data-action="lockEventConsequence" data-event-index="{{@root.activeTreeState.eventIndex}}" data-effect-index="{{@index}}" data-tooltip="Re-roll the coin lost"><i class="fas fa-rotate"></i></button>
                            {{else}}<button type="button" class="btn-lock-consequence" data-action="lockEventConsequence" data-event-index="{{@root.activeTreeState.eventIndex}}" data-effect-index="{{@index}}" data-tooltip="Roll how much coin is lost now and lock it in. It leaves the purses when the rest resolves."><i class="fas fa-dice-d20"></i> Roll &amp; lock</button>{{/if}}
                            {{/if}}
                        </div>
                        {{#if _locked}}
                        <div class="effect-result consequence-loss-grid">
                            {{#if (eq type "damage")}}
                            <div class="consequence-actors-row">
                                {{#each _lockedTargets}}
                                <div class="loss-actor-chip">
                                    {{#with (lookup @root.actorLookup id)}}
                                    <img class="loss-actor-avatar" src="{{img}}" alt="{{name}}"/>
                                    {{/with}}
                                    <span class="loss-actor-name">{{name}}</span>
                                    <span class="loss-metric damage">&minus;{{amount}} HP</span>
                                </div>
                                {{/each}}
                            </div>
                            <div class="consequence-footer-bar">
                                <span class="consequence-timing-pill"><i class="fas fa-hourglass-end"></i> Lands after rest</span>
                            </div>

                            {{else if (eq type "supply_loss")}}
                            <div class="consequence-breakdown-matrix">
                                {{#each _lockedSupply.breakdown}}
                                <div class="loss-item-pill">
                                    {{#with (lookup @root.actorLookup actorId)}}
                                    <img class="loss-actor-avatar" src="{{img}}" alt="{{../actorName}}"/>
                                    {{/with}}
                                    <span class="loss-actor-name">{{actorName}}</span>
                                    <span class="loss-item-label">{{itemName}}</span>
                                    <span class="loss-metric count">&minus;{{lossQty}}</span>
                                </div>
                                {{/each}}
                                {{#unless _lockedSupply.breakdown.length}}
                                <span class="loss-empty-note">No provisions found in packs</span>
                                {{/unless}}
                            </div>
                            <div class="consequence-footer-bar">
                                <span class="consequence-timing-pill"><i class="fas fa-hourglass-end"></i> Leaves packs at Dawn</span>
                            </div>

                            {{else if (eq type "item_at_risk")}}
                            <div class="consequence-breakdown-matrix">
                                {{#each _lockedItems}}
                                <div class="loss-item-pill gear">
                                    {{#with (lookup @root.actorLookup actorId)}}
                                    <img class="loss-actor-avatar" src="{{img}}" alt="{{../actorName}}"/>
                                    {{/with}}
                                    <span class="loss-actor-name">{{actorName}}</span>
                                    {{#if itemImg}}<img class="loss-item-icon" src="{{itemImg}}" alt="{{itemName}}"/>{{/if}}
                                    <span class="loss-item-label">{{itemName}}</span>
                                    {{#if (gt lossQty 1)}}<span class="loss-metric count">&minus;{{lossQty}}</span>{{/if}}
                                </div>
                                {{/each}}
                                {{#unless _lockedItems.length}}
                                <span class="loss-empty-note">No gear vulnerable to loss</span>
                                {{/unless}}
                            </div>
                            <div class="consequence-footer-bar">
                                <span class="consequence-timing-pill"><i class="fas fa-hourglass-end"></i> Leaves packs at Dawn</span>
                            </div>

                            {{else if (eq type "consume_gold")}}
                            <div class="consequence-breakdown-matrix">
                                {{#each _lockedGold.breakdown}}
                                <div class="loss-item-pill gold">
                                    {{#with (lookup @root.actorLookup actorId)}}
                                    <img class="loss-actor-avatar" src="{{img}}" alt="{{../actorName}}"/>
                                    {{/with}}
                                    <span class="loss-actor-name">{{actorName}}</span>
                                    <span class="loss-metric gold">&minus;{{lossGp}} gp</span>
                                </div>
                                {{/each}}
                                {{#unless _lockedGold.breakdown.length}}
                                <span class="loss-empty-note">No coin in purses</span>
                                {{/unless}}
                            </div>
                            <div class="consequence-footer-bar">
                                <span class="consequence-timing-pill"><i class="fas fa-hourglass-end"></i> Leaves purses at Dawn</span>
                            </div>
                            {{/if}}
                        </div>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                <div class="tree-narration-hint {{#if @root.allConsequencesResolved}}ready{{/if}}">
                    <i class="fas {{#if @root.allConsequencesResolved}}fa-theater-masks{{else}}fa-dice-d20{{/if}}"></i>
                    <span>{{#if @root.allConsequencesResolved}}Consequences locked. Describe the outcome to your players before proceeding to Dawn.{{else}}Roll and lock each consequence above before proceeding.{{/if}}</span>
                </div>
            </div>
            {{/if}}
        </div>
        {{else}}
        {{!-- Player View: Obscured narration state, roll request when prompted --}}
        <div class="respite-decision-tree player-tree-view">
            {{#if activeTreeState.resolved}}
            {{#if activeTreeState.hasLockedLosses}}
            <div class="player-outcome-card">
                <div class="player-loss-header">
                    <i class="fas fa-boxes-packing"></i>
                    <span>Supplies &amp; Gear Removed</span>
                </div>
                <div class="consequence-breakdown-matrix">
                    {{#each activeTreeState.finalEffects}}
                    {{#if _locked}}
                    {{#if (eq type "damage")}}
                    {{#each _lockedTargets}}
                    <div class="loss-actor-chip">
                        {{#with (lookup @root.actorLookup id)}}
                        <img class="loss-actor-avatar" src="{{img}}" alt="{{name}}"/>
                        {{/with}}
                        <span class="loss-actor-name">{{name}}</span>
                        <span class="loss-metric damage">&minus;{{amount}} HP</span>
                    </div>
                    {{/each}}

                    {{else if (eq type "supply_loss")}}
                    {{#each _lockedSupply.breakdown}}
                    <div class="loss-item-pill">
                        {{#with (lookup @root.actorLookup actorId)}}
                        <img class="loss-actor-avatar" src="{{img}}" alt="{{../actorName}}"/>
                        {{/with}}
                        <span class="loss-actor-name">{{actorName}}</span>
                        <span class="loss-item-label">{{itemName}}</span>
                        <span class="loss-metric count">&minus;{{lossQty}}</span>
                    </div>
                    {{/each}}

                    {{else if (eq type "item_at_risk")}}
                    {{#each _lockedItems}}
                    <div class="loss-item-pill gear">
                        {{#with (lookup @root.actorLookup actorId)}}
                        <img class="loss-actor-avatar" src="{{img}}" alt="{{../actorName}}"/>
                        {{/with}}
                        <span class="loss-actor-name">{{actorName}}</span>
                        {{#if itemImg}}<img class="loss-item-icon" src="{{itemImg}}" alt="{{itemName}}"/>{{/if}}
                        <span class="loss-item-label">{{itemName}}</span>
                        {{#if (gt lossQty 1)}}<span class="loss-metric count">&minus;{{lossQty}}</span>{{/if}}
                    </div>
                    {{/each}}

                    {{else if (eq type "consume_gold")}}
                    {{#each _lockedGold.breakdown}}
