                    <div class="check-module-dc-row">
                        <button type="button" class="dc-nudge" data-action="adjustEventDc" data-event-index="{{@index}}" data-delta="-1" data-tooltip="Lower the DC"><i class="fas fa-minus"></i></button>
                        <div class="event-dc-badge circular">
                            <span class="dc-label">DC</span>
                            <span class="dc-value">{{mechanical.dc}}</span>
                        </div>
                        <button type="button" class="dc-nudge" data-action="adjustEventDc" data-event-index="{{@index}}" data-delta="1" data-tooltip="Raise the DC"><i class="fas fa-plus"></i></button>
                    </div>
                    <div class="check-module-target">
                        {{#if (eq mechanical.targets "watch")}}Watch only{{else if (eq mechanical.targets "all")}}Entire party{{else}}Watch{{/if}} &middot; Group Check (averaged)
                    </div>
                    {{#if targetActors.length}}
                    <div class="check-module-avatars">
                        {{#each targetActors}}
                        <button type="button"
                            class="check-avatar{{#if rollModeAdvantage}} adv{{/if}}{{#if rollModeDisadvantage}} dis{{/if}}"
                            data-action="cycleEventRollMode"
                            data-event-index="{{@../index}}"
                            data-character-id="{{id}}"
                            data-tooltip="{{name}} &middot; {{#if rollModeAdvantage}}Advantage{{else if rollModeDisadvantage}}Disadvantage{{else}}Normal{{/if}} (click to change)">
                            <img src="{{img}}" alt="{{name}}" />
                            {{#if rollModeAdvantage}}<span class="check-avatar-mode adv"><i class="fas fa-angle-up"></i></span>{{/if}}
                            {{#if rollModeDisadvantage}}<span class="check-avatar-mode dis"><i class="fas fa-angle-down"></i></span>{{/if}}
                        </button>
                        {{/each}}
                    </div>
                    {{/if}}
                </div>
                {{#if checkContext}}
                <div class="event-check-context">
                    <i class="fas fa-dice-d20"></i> {{checkContext}}
                </div>
                {{/if}}
                <div class="event-gm-hint">
                    <i class="fas fa-info-circle"></i>
                    Averaged rolls trend toward ~10. DCs above 13 are harder, below 8 are easier than individual checks.
                </div>
                <details class="event-outcome-toggle">
                    <summary>
                        <i class="fas fa-eye"></i> Preview Outcomes
                        <i class="fas fa-chevron-right outcome-toggle-chevron"></i>
                    </summary>
                    <div class="event-outcome-preview two-col">
                        <div class="outcome-preview-col pass">
                            <div class="outcome-preview-head"><i class="fas fa-check-circle"></i> Pass</div>
                            <div class="outcome-preview-text">{{mechanical.onSuccess.narrative}}</div>
                            {{#each mechanical.onSuccess.effects}}{{#if description}}
                            <div class="outcome-preview-effect pass"><i class="fas fa-circle"></i> {{description}}</div>
                            {{/if}}{{/each}}
                        </div>
                        <div class="outcome-preview-col fail">
                            <div class="outcome-preview-head"><i class="fas fa-times-circle"></i> Fail</div>
                            <div class="outcome-preview-text">{{mechanical.onFailure.narrative}}</div>
                            {{#each mechanical.onFailure.effects}}{{#if description}}
                            <div class="outcome-preview-effect fail"><i class="fas fa-circle"></i> {{description}}</div>
                            {{/if}}{{/each}}
                        </div>
                    </div>
                </details>

                <div class="event-adjudicate-buttons">
                    <button type="button" class="btn-resolve-check" data-action="resolveSkillCheck" data-event-index="{{@index}}" data-outcome="auto"
                        {{#if @root.anyEventAwaitingRolls}}{{#unless awaitingRolls}}disabled data-tooltip="Resolve the current event first"{{/unless}}{{/if}}>
                        <i class="fas fa-dice-d20"></i> Request Rolls
                    </button>
                    <div class="event-override-links">
                        <button type="button" class="btn-override-link" data-action="resolveSkillCheck" data-event-index="{{@index}}" data-outcome="success"
                            data-tooltip="Skip the roll and set this check as a success."
                            {{#if @root.anyEventAwaitingRolls}}{{#unless awaitingRolls}}disabled{{/unless}}{{/if}}>Force Pass</button>
                        <button type="button" class="btn-override-link" data-action="resolveSkillCheck" data-event-index="{{@index}}" data-outcome="failure"
                            data-tooltip="Skip the roll and set this check as a failure."
                            {{#if @root.anyEventAwaitingRolls}}{{#unless awaitingRolls}}disabled{{/unless}}{{/if}}>Force Fail</button>
                    </div>
                </div>
                {{/if}}
                {{/if}}
            </div>
            {{/if}}

            {{!-- Encounter Hints (GM only, after failed check) --}}
            {{#if (eq resolvedOutcome "failure")}}
            {{#each mechanical.onFailure.effects}}
            {{#if encounterHints}}
            <div class="event-encounter-hints">
                <div class="encounter-hint-title"><i class="fas fa-dragon"></i> Encounter Setup</div>
                {{#if encounterHints.creatureSuggestions}}
                <div class="encounter-hint"><strong>Creatures:</strong> {{join encounterHints.creatureSuggestions ", "}}</div>
                {{/if}}
                {{#if encounterHints.groupSize}}
                <div class="encounter-hint"><strong>Group:</strong> {{encounterHints.groupSize}}</div>
                {{/if}}
                {{#if encounterHints.environment}}
                <div class="encounter-hint"><strong>Environment:</strong> {{encounterHints.environment}}</div>
                {{/if}}
                {{#if encounterHints.tactics}}
                <div class="encounter-hint"><strong>Tactics:</strong> {{encounterHints.tactics}}</div>
                {{/if}}
                {{#if encounterHints.awareness}}
                <div class="encounter-hint"><strong>Awareness:</strong> {{encounterHints.awareness}}</div>
                {{/if}}
                {{#if encounterHints.loot}}
                <div class="encounter-hint"><strong>Loot:</strong> {{encounterHints.loot}}</div>
                {{/if}}
            </div>
            {{/if}}
            {{/each}}
            {{/if}}
            {{/if}}

            {{#if treeHistory}}
            <div class="tree-history-summary">
                {{#each treeHistory}}
                <span class="tree-step"><i class="fas fa-chevron-right"></i> {{choiceLabel}}: {{#if
                    result.success}}Passed{{else}}Failed{{/if}}</span>
                {{/each}}
            </div>
            {{/if}}
        </div>
        {{else}}
        {{!-- Player View: Resolved outcome card OR thin title with narrating state --}}
        {{#if resolvedOutcome}}
        <div class="respite-event-card {{category}} resolved-event">
            <div class="event-header">
                <div class="event-name">
                    {{#if (eq category "encounter")}}<i class="fas fa-swords"></i>
                    {{else if (eq category "complication")}}<i class="fas fa-exclamation-triangle"></i>
                    {{else if (eq category "discovery")}}<i class="fas fa-search"></i>
                    {{else}}<i class="fas fa-moon"></i>
                    {{/if}}
                    {{#if name}}{{name}}{{else}}{{#if (eq category "encounter")}}Something stirs...{{else if (eq category "complication")}}A complication arises...{{else if (eq category "discovery")}}Something catches your eye...{{else}}The night passes...{{/if}}{{/if}}
                </div>
                <span class="event-verdict-inline {{#if (eq resolvedOutcome "triumph")}}pass{{else if (eq resolvedOutcome "success")}}pass{{else if (eq resolvedOutcome "mixed")}}partial{{else}}fail{{/if}}">
                    {{#if (eq resolvedOutcome "triumph")}}<i class="fas fa-check"></i> Passed{{else if (eq resolvedOutcome "success")}}<i class="fas fa-check"></i> Passed{{else if (eq resolvedOutcome "mixed")}}<i class="fas fa-exclamation-triangle"></i> Partial{{else}}<i class="fas fa-times"></i> Failed{{/if}}
                </span>
            </div>
            {{#if mechanical}}
            {{#if (eq mechanical.type "skill_check")}}
            <div class="event-mechanical">
                {{#if resolvedRolls}}
                <div class="event-roll-results">
                    {{#each resolvedRolls}}
                    <div class="event-roll-line {{#if passed}}pass{{else}}fail{{/if}}">
                        {{#if img}}<img class="roll-actor-token" src="{{img}}" alt="{{name}}">{{/if}}
                        <span class="roll-char-name">{{name}}</span>
                        <span class="roll-total">rolled <strong>{{total}}</strong></span>
                        {{#unless ../isGroupAveraged}}
                        <span class="roll-badge {{#if passed}}pass{{else}}fail{{/if}}">
                            {{#if passed}}<i class="fas fa-check"></i> Pass{{else}}<i class="fas fa-times"></i> Fail{{/if}}
                        </span>
                        {{/unless}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{#if (eq resolvedOutcome "triumph")}}
                <div class="event-resolution pass">
                    <div class="event-resolution-verdict"><i class="fas fa-shield-alt"></i> Check Passed</div>
                    <div class="event-resolution-narrative">The party rises to the occasion.</div>
                </div>
                {{else if (eq resolvedOutcome "success")}}
                <div class="event-resolution pass">
                    <div class="event-resolution-verdict"><i class="fas fa-shield-alt"></i> Check Passed</div>
                    <div class="event-resolution-narrative">The party weathers the challenge.</div>
                </div>
                {{else if (eq resolvedOutcome "mixed")}}
                <div class="event-resolution partial">
                    <div class="event-resolution-verdict"><i class="fas fa-exclamation-triangle"></i> Partial Success</div>
                    <div class="event-resolution-narrative">Things could have gone better.</div>
                </div>
                {{else}}
                <div class="event-resolution fail">
                    <div class="event-resolution-verdict"><i class="fas fa-skull-crossbones"></i> Check Failed</div>
                    <div class="event-resolution-narrative">The situation takes a turn for the worse.</div>
                </div>
                {{/if}}

                {{#if playerConsequences.length}}
                <div class="event-player-consequences">
                    <div class="event-player-consequences-head"><i class="fas fa-hourglass-half"></i> After the rest</div>
                    {{#each playerConsequences}}
                    <div class="event-player-consequence"><i class="fas {{icon}}"></i> {{text}}</div>
                    {{/each}}
                </div>
                {{/if}}
            </div>
            {{/if}}
            {{/if}}
        </div>
        {{else}}
        {{!-- Unresolved: Thin title bar with obscured narrating state or roll request --}}
        <div class="player-event-container">
            {{#if @root.pendingEventRoll}}
            {{#if (eq @index @root.pendingEventRoll.eventIndex)}}
            {{#if @root.pendingEventRoll.rollRequest}}
            <div class="player-event-roll-section">
                {{> rollRequest rollRequest=@root.pendingEventRoll.rollRequest}}
            </div>
            {{else}}
            <div class="player-event-narrating-card">
                <i class="fas fa-theater-masks player-narrating-icon"></i>
                <span class="player-narrating-text">The GM is narrating...</span>
            </div>
            {{/if}}
            {{else}}
            <div class="player-event-narrating-card">
                <i class="fas fa-theater-masks player-narrating-icon"></i>
                <span class="player-narrating-text">The GM is narrating...</span>
            </div>
            {{/if}}
            {{else}}
            <div class="player-event-narrating-card">
                <i class="fas fa-theater-masks player-narrating-icon"></i>
                <span class="player-narrating-text">The GM is narrating...</span>
            </div>
            {{/if}}
        </div>
        {{/if}}
        {{/if}}
        {{/each}}
        {{else}}
        <div class="respite-event-card ambient">
            <div class="event-name">Quiet Rest</div>
            <div class="event-description">The night passes without incident.</div>
        </div>
        {{/if}}

        {{#if @root.isGM}}
        <div class="event-narration-hint">
            <i class="fas fa-theater-masks"></i>
            {{#if hasEncounterEvent}}
            <em>Set the scene before battle begins.</em>
            {{else}}
            <em>Describe the outcome to your players before proceeding.</em>
            {{/if}}
        </div>
        {{/if}}
        {{/if}}

        {{/if}} {{!-- disasterChoice --}}

        {{else}}
        {{!-- PRE-ROLL: Camp preparations then Night Watch --}}
        {{#if isGM}}

        {{!-- Camp Preparations: camp activity rolls (persists after resolve for GM narration) --}}
        {{#if pendingCampRolls.length}}
        <div class="respite-event-card ambient camp-prep-card">
            <div class="event-name"><i class="fas fa-shield-alt"></i> Camp Preparations</div>
            <div class="event-description">
                {{#if campPrepsResolved}}Describe the results to your players before the encounter check.{{else}}Waiting for camp activity rolls to resolve before the encounter check.{{/if}}
            </div>
            <div class="camp-prep-list">
                {{#each pendingCampRolls}}
                <div class="camp-prep-entry {{status}}">
                    <i class="{{icon}}"></i>
                    <span class="camp-prep-name">{{characterName}}</span>
                    <span class="camp-prep-activity">{{activityName}}</span>
                    {{#if (eq status 'pass')}}
                    <span class="camp-prep-skill">{{skillName}} DC {{dc}}</span>
                    <span class="camp-prep-result pass"><i class="fas fa-check"></i> {{total}}</span>
                    {{else if (eq status 'fail')}}
                    <span class="camp-prep-skill">{{skillName}} DC {{dc}}</span>
                    <span class="camp-prep-result fail"><i class="fas fa-times"></i> {{total}}</span>
                    {{else}}
                    {{#if requested}}
                    <span class="camp-prep-skill">{{skillName}} DC {{dc}}{{#unless (eq dc baseDC)}} <span class="camp-dc-base">(was {{baseDC}})</span>{{/unless}}</span>
                    <span class="camp-prep-result pending"><i class="fas fa-paper-plane"></i> Sent</span>
                    <button type="button" class="btn-roll-for-player camp-fallback" data-action="rollCampForPlayer" data-character-id="{{characterId}}" data-tooltip="Roll on their behalf">
                        <i class="fas fa-dice"></i>
                    </button>
                    {{else}}
                    <span class="camp-prep-dc-controls">
                        <span class="camp-prep-skill">{{skillName}}</span>
                        <button type="button" class="camp-dc-btn" data-action="adjustCampDC" data-character-id="{{characterId}}" data-delta="-1" data-tooltip="Lower DC">&minus;</button>
                        <span class="camp-dc-value">DC {{dc}}{{#unless (eq dc baseDC)}} <span class="camp-dc-base">({{baseDC}})</span>{{/unless}}</span>
                        <button type="button" class="camp-dc-btn" data-action="adjustCampDC" data-character-id="{{characterId}}" data-delta="1" data-tooltip="Raise DC">+</button>
                    </span>
                    <button type="button" class="camp-prep-roll-btn" data-action="requestCampRoll" data-character-id="{{characterId}}" data-tooltip="Send roll request to player">
                        <i class="fas fa-dice-d20"></i>
                    </button>
                    {{/if}}
                    {{/if}}
                </div>
                {{#if narrative}}
                <div class="camp-prep-narrative {{status}}">
                    <i class="fas {{#if (eq status 'pass')}}fa-check-circle{{else}}fa-times-circle{{/if}}"></i>
                    {{narrative}}
                </div>
                {{/if}}
                {{#each effectDescriptions}}
                <div class="camp-prep-effect">
                    <i class="fas fa-cog"></i> {{this}}
                </div>
                {{/each}}
                {{/each}}
            </div>
        </div>
        {{/if}}

        {{!-- Night Watch: shown when camp preps resolved or no preps needed --}}
        {{#if campPrepsResolved}}

        {{#if showEventPoolNudge}}
        <div class="art-nudge-banner event-pool-nudge-banner">
            <div class="art-nudge-content">
                <div class="art-nudge-text">
                    <span class="art-nudge-title">Event Pool: {{eventPoolTerrainLabel}}, {{eventPoolCount}} events curated</span>
                </div>
            </div>
            <div class="art-nudge-actions">
                <button type="button" data-action="openEventPoolCurator" class="art-nudge-btn primary">
                    Curate Pool
                </button>
            </div>
        </div>
        {{/if}}

        <div class="respite-event-card ambient event-roll-prompt nw-mode-{{eventsMode}}">
            <div class="event-name">Night Watch</div>

            {{#if encountersEnabled}}
            <div class="nw-mode-selector" role="tablist" aria-label="How does the night unfold?">
                <button type="button" class="nw-mode-tab {{#if eventsModeIsRandom}}is-active{{/if}}"
                    role="tab" aria-selected="{{#if eventsModeIsRandom}}true{{else}}false{{/if}}"
                    data-action="setEventsMode" data-mode="random"
                    {{#if eventsCommitPending}}disabled{{/if}}
                    data-tooltip="{{#if eventsModeRandomAvailable}}Roll against the threshold to draw from the curated terrain pool.{{else}}No events in the curated pool for this terrain. Curate the pool first.{{/if}}"
                    {{#unless eventsModeRandomAvailable}}disabled{{/unless}}>
                    <i class="fas fa-dice-d20 nw-mode-icon"></i>
                    <span class="nw-mode-label">Random</span>
                </button>
                <button type="button" class="nw-mode-tab {{#if eventsModeIsImprovise}}is-active{{/if}}"
                    role="tab" aria-selected="{{#if eventsModeIsImprovise}}true{{else}}false{{/if}}"
                    data-action="setEventsMode" data-mode="improvise"
                    {{#if eventsCommitPending}}disabled{{/if}}
                    data-tooltip="Roll against the threshold to narrate your own scenario on failure.">
                    <i class="fas fa-hat-wizard nw-mode-icon"></i>
                    <span class="nw-mode-label">Improvise</span>
                </button>
                <button type="button" class="nw-mode-tab {{#if eventsModeIsPick}}is-active{{/if}}"
                    role="tab" aria-selected="{{#if eventsModeIsPick}}true{{else}}false{{/if}}"
                    data-action="setEventsMode" data-mode="pick"
                    {{#if eventsCommitPending}}disabled{{/if}}
                    data-tooltip="{{#if eventsModePickAvailable}}Select a specific event, bypassing the threshold check.{{else}}No events in the curated pool for this terrain. Curate the pool first.{{/if}}"
                    {{#unless eventsModePickAvailable}}disabled{{/unless}}>
                    <i class="fas fa-book-open nw-mode-icon"></i>
                    <span class="nw-mode-label">Pick from pool</span>
                </button>
            </div>

            {{#if eventsModeIsRandom}}
            <div class="event-description">
                {{#if isGM}}
                {{#if pendingCampRolls.length}}Camp preparations complete. {{/if}}Roll a d20 against the encounter threshold to see what the night brings.
                {{else}}
                {{#if pendingCampRolls.length}}Camp preparations complete. {{/if}}The GM will call for a night check when ready.
                {{/if}}
            </div>
            {{#if encounterBar}}
            {{#if isGM}}
            {{> encounterThreshold dc=encounterBar.effectiveDC belowLabel="event triggers" eventsCommitPending=eventsCommitPending}}
            {{else if encounterBar.playerFactors.length}}
            <div class="encounter-details-player">
                <span class="encounter-details-player-label">Camp exposure</span>
                <span class="encounter-bar-chips encounter-bar-chips--player">
                    {{#each encounterBar.playerFactors}}
                    {{#unless @first}}<span class="encounter-factor-sep" aria-hidden="true">|</span>{{/unless}}
                    <span class="encounter-chip encounter-chip--{{tone}}"{{#if tooltip}} data-tooltip="{{tooltip}}"{{/if}}>
                        {{#if icon}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}{{label}}
                    </span>
                    {{/each}}
                </span>
            </div>
            {{/if}}
            {{/if}}
            {{/if}}

            {{#if eventsModeIsImprovise}}
            <div class="event-description">
                {{#if isGM}}Roll the night check. If an event triggers, run your own scenario at the table.{{else}}The GM will narrate what the night brings.{{/if}}
            </div>
            {{#if encounterBar}}
            {{#if isGM}}
            {{> encounterThreshold dc=encounterBar.effectiveDC belowLabel="your scenario triggers" hideDisaster=true eventsCommitPending=eventsCommitPending}}
            {{else if encounterBar.playerFactors.length}}
            <div class="encounter-details-player">
                <span class="encounter-details-player-label">Camp exposure</span>
                <span class="encounter-bar-chips encounter-bar-chips--player">
                    {{#each encounterBar.playerFactors}}
                    {{#unless @first}}<span class="encounter-factor-sep" aria-hidden="true">|</span>{{/unless}}
                    <span class="encounter-chip encounter-chip--{{tone}}"{{#if tooltip}} data-tooltip="{{tooltip}}"{{/if}}>
                        {{#if icon}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}{{label}}
                    </span>
                    {{/each}}
                </span>
            </div>
            {{/if}}
            {{/if}}
            {{/if}}

            {{#if eventsModeIsPick}}
            <div class="event-description">
                Choose a specific event from the curated pool. The encounter threshold is bypassed; the event runs as written.
            </div>
            <div class="nw-pick-summary">
                <i class="fas fa-book-open"></i>
                <span>{{eventPoolCount}} event{{#unless (eq eventPoolCount 1)}}s{{/unless}} available for {{eventPoolTerrainLabel}}.</span>
            </div>
            {{/if}}
            {{else}}
            <div class="event-description">
                Encounters are off for this rest. The night passes without a check.
            </div>
            {{/if}}
        </div>
        {{/if}}

        {{else}}
        {{!-- PLAYER VIEW: activity-specific messaging --}}
        <div class="respite-event-card ambient player-activity-card">
            <div class="event-name"><i class="fas fa-moon"></i> Resting...</div>
            <div class="event-description">
                The party settles in for the night. The GM will determine what the darkness holds.
            </div>

            {{!-- Camp roll buttons for owned characters --}}
            {{#if pendingCampRoll.activities.length}}
            <div class="camp-roll-section">
                {{#each pendingCampRoll.activities}}
                {{#if rollRequest}}
                {{> rollRequest rollRequest=rollRequest}}
                {{else if (eq status 'pass')}}
                <div class="camp-roll-prompt pass">
                    <div class="camp-roll-info">
                        <strong>{{activityName}}</strong>
                        <span class="camp-roll-skill">{{skillName}} DC {{dc}}</span>
                    </div>
                    <span class="camp-roll-result pass" data-tooltip="Success! Rolled {{total}}">
                        <i class="fas fa-check-circle"></i> {{total}} - Passed
                    </span>
                    {{#each effectDescriptions}}
                    <div class="camp-roll-effect"><i class="fas fa-cog"></i> {{this}}</div>
                    {{/each}}
                </div>
                {{else if (eq status 'fail')}}
                <div class="camp-roll-prompt fail">
                    <div class="camp-roll-info">
                        <strong>{{activityName}}</strong>
                        <span class="camp-roll-skill">{{skillName}} DC {{dc}}</span>
                    </div>
                    <span class="camp-roll-result fail" data-tooltip="Failed. Rolled {{total}}">
                        <i class="fas fa-times-circle"></i> {{total}} - Failed
                    </span>
                    {{#each effectDescriptions}}
                    <div class="camp-roll-effect"><i class="fas fa-cog"></i> {{this}}</div>
                    {{/each}}
                </div>
                {{/if}}
                {{/each}}
            </div>
            {{/if}}
        </div>
        {{/if}}
        {{/if}}

    </div>
    {{#if isGM}}
    <div class="respite-action-bar">
        {{#if eventsRolled}}
            {{#if awaitingCombat}}
            {{!-- Combat in progress, GM decides when complete --}}
            <button type="button" class="btn-primary btn-combat-complete" data-action="completeEncounter">
                <i class="fas fa-check-circle"></i> Combat Complete
            </button>
            <button type="button" class="btn-secondary btn-hide-window" data-action="hideWindow">
                <i class="fas fa-eye-slash"></i> Hide
            </button>
            {{else if hasEncounterEvent}}
            {{!-- Encounter triggered but not yet acknowledged --}}
            <div class="encounter-gate">
                <div class="encounter-instructions">
                    <i class="fas fa-swords"></i>
                    <span>An encounter has interrupted camp.</span>
                </div>
                {{#if encounterAwareness}}
                <div class="encounter-awareness-advisory">
                    <i class="fas fa-eye"></i>
                    <span>{{encounterAwareness}}</span>
                </div>
                {{/if}}
                {{#if combatBuffs}}
                <div class="combat-readiness-report">
                    <div class="combat-readiness-header">
                        <i class="fas fa-shield-alt"></i> Combat Readiness
                    </div>
                    {{#if combatBuffs.perCharacter.length}}
                    <div class="combat-readiness-list">
                        {{#each combatBuffs.perCharacter}}
                        <div class="combat-buff-entry">
                            <span class="combat-buff-name">{{characterName}}</span>
                            <span class="combat-buff-activity">({{activityName}})</span>
                            <span class="combat-buff-summary">{{summary}}</span>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}
                    {{#if combatBuffs.partyWide.summary}}
                    <div class="combat-readiness-party">
                        <i class="fas fa-users"></i> {{combatBuffs.partyWide.summary}}
                    </div>
                    {{/if}}
                    {{#unless combatBuffs.perCharacter.length}}
                    <div class="combat-readiness-none">
                        No combat modifiers from the party's activities.
                    </div>
                    {{/unless}}
                </div>
                {{/if}}
                <button type="button" class="btn-primary btn-acknowledge-encounter" data-action="acknowledgeEncounter" data-tooltip="Minimizes to the status bar">
                    <i class="fas fa-swords"></i> Begin Combat
                </button>
                <div class="combat-hint">
                    <i class="fas fa-info-circle"></i> Minimizes to the status bar. Reopen when combat ends.
                </div>
            </div>
            {{else}}
            {{!-- No encounter, or encounter resolved, allow rest resolution --}}
            {{#if activeTreeState}}{{#unless activeTreeState.resolved}}
            {{!-- Hidden while decision tree is active --}}
            {{/unless}}{{/if}}
            {{#unless (and activeTreeState (not activeTreeState.resolved))}}
            <button type="button" class="btn-primary-green" data-action="enterDawn"
                {{#if (or resolvingRest disasterChoice (not allEventChecksResolved) (not allConsequencesResolved))}}disabled{{/if}}
                data-tooltip="{{#if disasterChoice}}Choose a disaster outcome first{{else if (not allEventChecksResolved)}}Resolve all event skill checks first{{else if (not allConsequencesResolved)}}Roll and lock every consequence first{{else}}Exhaustion saves, then the rest ends{{/if}}">
                <i class="fas fa-sun"></i> Dawn
            </button>
            {{/unless}}
            {{/if}}
        {{else}}
        {{#if encountersEnabled}}
        <button type="button" class="travel-skip-link nw-no-event-link" data-action="nightPasses"
            {{#if eventsCommitPending}}disabled{{/if}}
            {{#unless campPrepsResolved}}disabled{{/unless}}
            data-tooltip="{{#if eventsCommitPending}}Waiting for the night check...{{else if campPrepsResolved}}GM override: skip the night check and run no event.{{else}}Awaiting camp activity rolls{{/if}}">
            <i class="fas fa-moon"></i> No event
        </button>
        <button type="button" class="btn-primary btn-roll-events" data-action="commitEventsMode"
            {{#if eventsCommitPending}}disabled{{/if}}
            {{#unless campPrepsResolved}}disabled data-tooltip="Awaiting camp activity rolls"{{/unless}}>
            {{#if eventsCommitPending}}
            <i class="fas fa-circle-notch fa-spin"></i>
            {{#if eventsModeIsPick}}Opening pool...{{else}}Rolling...{{/if}}
            {{else if eventsModeIsPick}}
            <i class="fas fa-book-open"></i> Choose event
            {{else}}
            <i class="fas fa-dice-d20"></i> Roll for Events
            {{/if}}
        </button>
        {{else}}
        <button type="button" class="btn-primary btn-night-passes" data-action="nightPasses"
            {{#if eventsCommitPending}}disabled{{/if}}>
            {{#if eventsCommitPending}}
            <i class="fas fa-circle-notch fa-spin"></i> Continuing...
            {{else}}
            <i class="fas fa-moon"></i> The night passes
            {{/if}}
        </button>
        {{/if}}
        {{/if}}
    </div>
    {{else}}
    <div class="respite-action-bar">
        {{#if eventsRolled}}
        {{#if awaitingCombat}}
        <span class="phase-waiting-label"><i class="fas fa-swords"></i> Combat in progress...</span>
        <button type="button" class="btn-secondary btn-hide-window" data-action="hideWindow" data-tooltip="Minimize to the status bar">
            <i class="fas fa-eye-slash"></i> Hide
        </button>
        {{else}}
        <span class="phase-waiting-label"><i class="fas fa-hourglass-half"></i> Resolving events...</span>
        {{/if}}
        {{else}}
        <span class="phase-waiting-label"><i class="fas fa-moon"></i> The party rests...</span>
        {{/if}}
    </div>
    {{/if}}
    </div>{{!-- /events-phase-body --}}
    {{/if}}

    {{!-- =============== DAWN: exhaustion saves, then the rest ends =============== --}}
    {{#if (eq phase 'dawn')}}
    <div class="events-phase-body">
        {{> dawnExhaustionStage}}
        <div class="respite-action-bar">
            {{#if isGM}}
            <button type="button" class="btn-secondary" data-action="returnToNight">
                <i class="fas fa-arrow-left"></i> Back to Night
            </button>
            <button type="button" class="btn-primary-green" data-action="completeDawn"
                {{#if (or resolvingRest exhaustionSummary.pending)}}disabled{{/if}}
                data-tooltip="{{#if exhaustionSummary.pending}}Roll or waive each exhaustion save{{else}}Apply the rest and close{{/if}}">
                {{#if resolvingRest}}
                <i class="fas fa-circle-notch fa-spin"></i> Breaking camp...
                {{else}}
                <i class="fas fa-check-double"></i> Complete Rest
                {{/if}}
            </button>
            {{else}}
            {{#if exhaustionSummary.pending}}
            <span class="phase-waiting-label"><i class="fas fa-hourglass-half"></i> Settling dawn saves ({{exhaustionSummary.pending}} pending)...</span>
            {{else}}
            <span class="phase-waiting-label success"><i class="fas fa-check-double"></i> Dawn saves settled</span>
            {{/if}}
            {{/if}}
        </div>
    </div>
    {{/if}}

    {{!-- =============== RESOLUTION PHASE (DAWN BREAKS) =============== --}}
    {{#if (eq phase 'resolve')}}
    <div class="respite-dawn-screen">
        <div class="respite-dawn-header">
            <div class="respite-dawn-title-block">
                <span class="respite-dawn-badge"><i class="fas fa-sun"></i> Dawn Breaks</span>
                <span class="respite-dawn-subtitle">Rest Complete · {{campStatus.weatherLabel}} · {{campStatus.comfort}}</span>
            </div>
            <div class="respite-dawn-pacing">
                <span class="dawn-pacing-pill"><i class="fas fa-shield-alt"></i> {{#if (gt incidentsCount 0)}}{{incidentsCount}} Incident{{#if (gt incidentsCount 1)}}s{{/if}} Resolved{{else}}Quiet Night{{/if}}</span>
            </div>
        </div>

        <div class="respite-dawn-grid">
            {{#each dawnCards}}
            <div class="respite-dawn-card {{#if hasSetback}}has-setback{{else}}all-recovered{{/if}}">
                <div class="dawn-card-portrait-wrap">
                    <img class="dawn-card-portrait" src="{{img}}" alt="{{name}}" />
                    <span class="dawn-card-status-glyph {{#if hasSetback}}setback{{else}}recovered{{/if}}">
                        <i class="fas {{#if hasSetback}}fa-triangle-exclamation{{else}}fa-check{{/if}}"></i>
                    </span>
                </div>
                <div class="dawn-card-info">
                    <div class="dawn-card-name" title="{{name}}">{{name}}</div>
                    <div class="dawn-card-act-pill {{#if activitySuccess}}success{{else}}failed{{/if}}" title="{{activityLabel}}">
                        <i class="{{activityIcon}}"></i> <span>{{activityLabel}}</span>
                    </div>
                </div>
                <div class="dawn-card-vitals">
                    <div class="dawn-vital-row {{#if hpAtMax}}max-val{{/if}}">
                        <i class="fas fa-heart"></i>
                        <span>{{hpLabel}}</span>
                    </div>
                    <div class="dawn-vital-row {{#if hdAtMax}}max-val{{/if}}">
                        <i class="fas fa-dice-d20"></i>
                        <span>{{hdLabel}}{{#if hasBedroll}} <small>(+1)</small>{{/if}}</span>
                    </div>
                </div>
                <div class="dawn-card-condition">
                    {{#if (gt exhaustionDelta 0)}}
                    <span class="dawn-cond-pill negative" title="Gained {{exhaustionDelta}} exhaustion">
                        <i class="fas fa-person-falling-burst"></i> +{{exhaustionDelta}} Exh
                    </span>
                    {{else if saveFailed}}
                    <span class="dawn-cond-pill amber" title="Failed CON save DC {{exhaustionDC}} (offset by rest)">
                        <i class="fas fa-bed"></i> DC {{exhaustionDC}} Failed
                    </span>
                    {{else if savePassed}}
                    <span class="dawn-cond-pill positive" title="Passed CON save DC {{exhaustionDC}}">
                        <i class="fas fa-shield"></i> DC {{exhaustionDC}} Passed
                    </span>
                    {{else if (lt exhaustionDelta 0)}}
                    <span class="dawn-cond-pill positive" title="Exhaustion reduced by 1">
                        <i class="fas fa-sparkles"></i> -1 Exh
                    </span>
                    {{else}}
                    <span class="dawn-cond-pill neutral">
                        <i class="fas fa-sparkles"></i> Fully Rested
                    </span>
                    {{/if}}

                    {{#if eventDamage}}
                    <span class="dawn-cond-pill damage" title="Took {{eventDamage}} damage during night">
                        <i class="fas fa-tint"></i> -{{eventDamage}} HP
                    </span>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>

        <div class="respite-dawn-footer">
            <div class="respite-dawn-footer-hint">
                <i class="fas fa-scroll"></i>
                <span>Rest applied to character sheets. Collapsible summary will be posted to chat upon breaking camp.</span>
            </div>
            <div class="respite-dawn-footer-actions">
                {{#if isGM}}
                <button type="button" class="btn-primary-green btn-break-camp" data-action="finalize">
                    <i class="fas fa-campground"></i> Break Camp & Post to Chat
                </button>
                {{else}}
                <span class="player-waiting-pill"><i class="fas fa-hourglass-half"></i> Waiting for GM to break camp...</span>
                {{/if}}
            </div>
        </div>
    </div>
    {{/if}}

    {{!-- GM Copy Spell Transaction Card --}}
    {{#if gmCopySpellProposal}}
    <div class="gm-copy-spell-card" style="background: rgba(80,60,140,0.15); border: 1px solid {{#if gmCopySpellProposal.charged}}rgba(34,197,94,0.4){{else}}rgba(160,120,220,0.4){{/if}}; border-radius: 6px; padding: 0.6rem 0.75rem; margin: 0.5rem 0.75rem;">
        {{#if gmCopySpellProposal.charged}}
        {{!-- CHARGED STATE: Gold taken, awaiting player's Arcana roll --}}
        <div style="font-weight: 600; color: rgba(34,197,94,0.9); font-size: 0.85rem; margin-bottom: 0.4rem;">
            <i class="fas fa-coins"></i> Gold Charged: Awaiting Arcana Roll
        </div>
        <div style="font-size: 0.75rem; color: rgba(255,255,255,0.75); line-height: 1.5;">
            <strong>{{gmCopySpellProposal.actorName}}</strong>:
            Level <strong>{{gmCopySpellProposal.spellLevel}}</strong> spell.
            <strong>{{gmCopySpellProposal.cost}}gp</strong> charged
            ({{gmCopySpellProposal.remainingGold}}gp remaining).<br>
            <i class="fas fa-dice-d20" style="color: rgba(126,184,218,0.8);"></i>
            Awaiting Arcana roll: DC <strong>{{gmCopySpellProposal.dc}}</strong>.
        </div>
        <div style="font-size: 0.65rem; color: rgba(255,255,255,0.4); margin-top: 0.3rem; font-style: italic;">
            If the player disconnected, use re-send or roll on their behalf.
        </div>
        <div style="display: flex; gap: 0.4rem; margin-top: 0.5rem;">
            <button type="button" data-action="resendCopySpellRoll"
                style="flex: 1; padding: 0.3rem 0.5rem; border-radius: 4px; background: linear-gradient(135deg, rgba(126,184,218,0.3), rgba(126,184,218,0.15)); border: 1px solid rgba(126,184,218,0.4); color: rgba(255,255,255,0.9); font-weight: 600; font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-redo"></i> Re-send Roll
            </button>
            <button type="button" data-action="gmCopySpellFallback"
                style="flex: 1; padding: 0.3rem 0.5rem; border-radius: 4px; background: linear-gradient(135deg, rgba(243,156,18,0.3), rgba(243,156,18,0.15)); border: 1px solid rgba(243,156,18,0.4); color: rgba(255,255,255,0.9); font-weight: 600; font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-dice-d20"></i> GM Rolls Instead
            </button>
            <button type="button" data-action="dismissGmCopySpell"
                style="padding: 0.3rem 0.5rem; border-radius: 4px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-times"></i>
            </button>
        </div>
        {{else}}
        {{!-- INITIAL STATE: Proposal received, GM decides to charge --}}
        <div style="font-weight: 600; color: rgba(180,140,240,0.9); font-size: 0.85rem; margin-bottom: 0.4rem;">
            <i class="fas fa-scroll"></i> Copy Spell Request
        </div>
        <div style="font-size: 0.75rem; color: rgba(255,255,255,0.75); line-height: 1.5;">
            <strong>{{gmCopySpellProposal.actorName}}</strong> wants to copy a
            <strong>Level {{gmCopySpellProposal.spellLevel}}</strong> spell.<br>
            <i class="fas fa-coins" style="color: rgba(255,200,100,0.8);"></i>
            Cost: <strong>{{gmCopySpellProposal.cost}}gp</strong>
            (has {{gmCopySpellProposal.currentGold}}gp)
            {{#unless gmCopySpellProposal.canAfford}}
            <span style="color: #ef9a9a;"> - insufficient gold</span>
            {{/unless}}
            <br>
            <i class="fas fa-dice-d20" style="color: rgba(126,184,218,0.8);"></i>
            Arcana DC: <strong>{{gmCopySpellProposal.dc}}</strong>
        </div>
        <div style="font-size: 0.65rem; color: rgba(255,255,255,0.4); margin-top: 0.3rem; font-style: italic;">
            Determine which spell the player is copying. On success, add it to their spell listing.
            If copying from a scroll, the scroll is consumed regardless of outcome.
        </div>
        <div style="display: flex; gap: 0.4rem; margin-top: 0.5rem;">
            {{#if gmCopySpellProposal.canAfford}}
            <button type="button" data-action="processGmCopySpell"
                style="flex: 1; padding: 0.3rem 0.5rem; border-radius: 4px; background: linear-gradient(135deg, rgba(34,197,94,0.3), rgba(34,197,94,0.15)); border: 1px solid rgba(34,197,94,0.4); color: rgba(255,255,255,0.9); font-weight: 600; font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-coins"></i> Charge & Send Roll
            </button>
            {{else}}
            <button type="button" disabled
                style="flex: 1; padding: 0.3rem 0.5rem; border-radius: 4px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.3); font-weight: 600; font-size: 0.75rem; cursor: not-allowed;">
                <i class="fas fa-coins"></i> Can't Afford
            </button>
            {{/if}}
            <button type="button" data-action="dismissGmCopySpell"
                style="padding: 0.3rem 0.5rem; border-radius: 4px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); font-size: 0.75rem; cursor: pointer;">
                <i class="fas fa-times"></i> Dismiss
            </button>
        </div>
        {{/if}}
    </div>
    {{/if}}

    {{!-- Player Copy Spell Roll Card --}}
    {{#if copySpellRollRequest}}
    {{> rollRequest rollRequest=copySpellRollRequest}}
    {{/if}}

    {{#if isGM}}
    {{#unless safeRestSpot}}
    {{> campLogisticsDrawer}}
    {{/unless}}
    {{/if}}

    {{#if (or (eq phase 'camp') (eq phase 'activity') (eq phase 'meal'))}}
    {{> restFooter}}
    {{/if}}

{{/if}}
</form>
