<div class="downtime-ledger-container {{#if partyReadiness.isAllComplete}}party-committed{{else}}party-choosing{{/if}} {{#if pacingActive}}pacing-flow-active{{/if}}">

    {{!-- Tier 1: Canonical Rest Header --}}
    {{> restHeader}}

    {{!-- Shared Terrain Artwork Banner (Suppressed during tactical pacing) --}}
    {{#unless pacingActive}}
    {{> terrainBanner}}
    {{/unless}}

    {{#if pacingActive}}
    {{!-- =========================================================================
         DEDICATED RESOLUTION FLOW (Single-Night Watch Rotation or Multi-Night Pacing)
         Pacing through each day/night to resolve events, consultations, overrides & battles
         ========================================================================= --}}
    <div class="downtime-pacing-stage {{#if isSingleNight}}single-night-flow{{else}}multi-night-flow{{/if}}">
        {{#if isSingleNight}}
        {{!-- 1A. Single-Night 4-Watch Rotation Ribbon --}}
        <div class="pacing-timeline-deck pacing-watch-deck">
            <div class="pacing-timeline-header">
                <span class="timeline-title"><i class="fas fa-shield-halved"></i> {{localize "ionrift-respite.downtimeLedger.watchRotation8Hour"}}</span>
                <span class="timeline-subtitle">{{localize "ionrift-respite.downtimeLedger.targetDc" dc=currentNightEntry.effectiveDC}} · {{#if currentNightEntry.isRolled}}{{#if currentNightEntry.isResolvedCombat}}{{localize "ionrift-respite.downtimeLedger.combatResolved"}}{{else if currentNightEntry.isRed}}{{localize "ionrift-respite.downtimeLedger.hostileAmbush"}}{{else if currentNightEntry.isAmber}}{{localize "ionrift-respite.downtimeLedger.nocturnalEvent"}}{{else}}{{localize "ionrift-respite.downtimeLedger.quietRest"}}{{/if}}{{else}}{{localize "ionrift-respite.downtimeLedger.awaitingNightCheck"}}{{/if}}</span>
            </div>
            <div class="pacing-watch-grid">
                {{#each watchRotation}}
                <div class="pacing-watch-card {{#if isSurprised}}surprised{{else if isVigilant}}vigilant{{/if}} {{#if isPeakHazard}}peak-hazard{{/if}}">
                    <img class="watch-sentry-avatar" src="{{#if actorImg}}{{actorImg}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="{{actorName}}" data-tooltip="{{actorName}}">
                    <div class="watch-card-meta">
                        <span class="watch-slot-label"><i class="fas {{icon}}"></i> {{label}} ({{hours}})</span>
                        <strong class="watch-sentry-name">{{actorName}}</strong>
                        <span class="watch-pp-pill" data-tooltip="{{localize "ionrift-respite.downtimeLedger.passivePerception"}}">{{localize "ionrift-respite.downtimeLedger.ppVal" pp=passivePerception}}</span>
                    </div>
                    <div class="watch-status-tag">
                        {{#if ../currentNightEntry.isRolled}}
                            {{#if isSurprised}}
                            <span class="status-badge surprised"><i class="fas fa-triangle-exclamation"></i> {{localize "ionrift-respite.downtimeLedger.surprised"}}</span>
                            {{else}}
                            <span class="status-badge alert"><i class="fas fa-check"></i> {{localize "ionrift-respite.downtimeLedger.vigilant"}}</span>
                            {{/if}}
                        {{else}}
                            <span class="status-badge ready"><i class="fas fa-eye"></i> {{localize "ionrift-respite.downtimeLedger.staked"}}</span>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        {{else}}
        {{!-- 1B. Multi-Night Scrubber Timeline Deck with Progressive Fog of War --}}
        <div class="pacing-timeline-deck">
            <div class="pacing-timeline-header">
                <span class="timeline-title"><i class="fas fa-shield-moon"></i> {{localize "ionrift-respite.downtimeLedger.nightlyWatchRotation"}}</span>
                <span class="timeline-subtitle">{{#if isDawnCheck}}{{{localize "ionrift-respite.downtimeLedger.dawnSubtitle"}}}{{else}}{{localize "ionrift-respite.downtimeLedger.selectNightSubtitle"}}{{/if}}</span>
            </div>
            <div class="pacing-scrubber-grid">
                {{#each pacingDraft}}
                <div class="pacing-scrubber-item {{#if isCurrentNight}}is-active-night{{/if}} {{#if isDawnStep}}is-dawn-step{{/if}} {{#if isVeiled}}veiled{{else if isRed}}red{{else if isAmber}}amber{{else if isRolled}}green{{else}}unrolled{{/if}} {{#if isResolvedCombat}}combat-resolved{{/if}}"
                     data-action="setPacingNight" data-night="{{nightIndex}}"
                     data-tooltip="{{#if isDawnStep}}{{tooltip}}{{else}}{{localize "ionrift-respite.downtimeLedger.nightPrefix" nightIndex=nightIndex}} {{#if isVeiled}}{{localize "ionrift-respite.downtimeLedger.veiledInDarkness"}}{{else if isResolvedCombat}}{{localize "ionrift-respite.downtimeLedger.combatResolved"}}{{else if isRolled}}{{statusLabel}} ({{localize "ionrift-respite.downtimeLedger.d20RollVsDc" rollTotal=rollTotal dc=effectiveDC}}){{else}}{{localize "ionrift-respite.downtimeLedger.awaitingNightCheckDc" dc=effectiveDC}}{{/if}}{{/if}}">
                    <div class="scrubber-item-top">
                        <span class="scrubber-night-num">{{#if isDawnStep}}{{localize "ionrift-respite.downtimeLedger.dawn"}}{{else}}{{localize "ionrift-respite.downtimeLedger.nightShort" nightIndex=nightIndex}}{{/if}}</span>
                        <i class="fas {{#if isVeiled}}fa-cloud{{else if isResolvedCombat}}fa-check-circle{{else if isRolled}}{{statusIcon}}{{else if isDawnStep}}fa-sun{{else}}fa-hourglass-half{{/if}} scrubber-state-icon"></i>
                    </div>
                    <div class="scrubber-roll-pill">
                        {{#if isDawnStep}}
                        <span>🌅</span>
                        {{else if isVeiled}}
                        <span>☁️</span>
                        {{else if isRolled}}
                        <span>{{rollTotal}}</span>
                        <span class="scrubber-dc-hint">/{{effectiveDC}}</span>
                        {{else}}
                        <span class="scrubber-unrolled-hint">{{localize "ionrift-respite.downtimeLedger.dcHint" dc=effectiveDC}}</span>
                        {{/if}}
                    </div>
                    <div class="scrubber-mods">
                        {{#if isDawnStep}}
                        <i class="fas fa-sparkles" data-tooltip="{{localize "ionrift-respite.downtimeLedger.exhaustionAdjudication"}}"></i>
                        {{else}}
                        {{#if hasFortify}}<i class="fas fa-shield-alt" data-tooltip="{{localize "ionrift-respite.downtimeLedger.fortifiedDcTooltip"}}"></i>{{/if}}
                        {{#if hasGuard}}<i class="fas fa-eye" data-tooltip="{{localize "ionrift-respite.downtimeLedger.guardOnWatchTooltip"}}"></i>{{/if}}
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        {{/if}}

        {{#if sendoffOpen}}
        {{!-- Send-off beat, same card as a normal rest, before the last watch. --}}
        <div class="events-phase-body">
            {{> mealBuffBeat}}
        </div>
        {{else if isDawnCheck}}
        {{!-- 2B. Dawn Finalization Spotlight Card (Clean 90/10 Pattern) --}}
        <div class="pacing-spotlight-card pacing-dawn-stage clean-dawn-layout">
            
            {{!-- Compact Dawn Hero Header --}}
            <div class="dawn-summary-strip">
                <div class="dawn-lead-group">
                    <div class="dawn-sun-emblem"><i class="fas fa-sun-cloud"></i></div>
                    <div class="dawn-copy-block">
                        <div class="dawn-lead-title">{{localize "ionrift-respite.downtimeLedger.dawnLeadTitle"}}</div>
                        <div class="dawn-lead-hint">{{{localize "ionrift-respite.downtimeLedger.dawnLeadHint"}}}</div>
                    </div>
                </div>

                {{!-- High-Level Batch Orchestration (GM Only) --}}
                {{#if isGM}}
                <div class="dawn-batch-cluster">
                    {{#if exhaustionSummary.pending}}
                    <button type="button" class="btn-dawn-batch roll-all" data-action="rollAllExhaustionSaves"
                            data-tooltip="{{localize "ionrift-respite.downtimeLedger.rollAllExhaustionTooltip" count=exhaustionSummary.pending}}">
                        <i class="fas fa-dice-d20"></i> {{localize "ionrift-respite.downtimeLedger.rollAllPending" count=exhaustionSummary.pending}}
                    </button>
                    <button type="button" class="btn-dawn-batch waive-all" data-action="waiveAllExhaustionSaves"
                            data-tooltip="{{localize "ionrift-respite.downtimeLedger.waiveAllTooltip"}}">
                        <i class="fas fa-shield-check"></i> {{localize "ionrift-respite.downtimeLedger.waiveAll"}}
                    </button>
                    {{else}}
                    <div class="dawn-settled-pill">
                        <i class="fas fa-check-double"></i> {{localize "ionrift-respite.downtimeLedger.allSavesSettled"}}
                    </div>
                    {{/if}}
                </div>
                {{/if}}
            </div>

            {{!-- Streamlined Party Exhaustion Roster (Horizontal Ledger Rows) --}}
            <div class="dawn-roster-stack">
                {{#each exhaustionRoster}}
                <div class="dawn-actor-row {{#if rolled}}{{#if passed}}is-passed{{else}}is-failed{{/if}}{{else if mustRoll}}is-pending{{else}}is-waived{{/if}} {{#if isOverrideOpen}}override-active{{/if}}"
                     data-actor-id="{{actorId}}">
                    
                    {{!-- Character Identity Block --}}
                    <div class="actor-identity-col">
                        <img class="actor-avatar" src="{{#if actorImg}}{{actorImg}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="{{actorName}}">
                        <div class="actor-name-group">
                            <span class="actor-name">{{actorName}}</span>
                            <div class="actor-badges">
                                <span class="pill-con" data-tooltip="{{localize "ionrift-respite.downtimeLedger.conSaveModTooltip"}}">{{localize "ionrift-respite.downtimeLedger.conMod" mod=conModString}}</span>
                                <span class="pill-exh {{#if currentExhaustion}}has-exh{{/if}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.currentExhaustionTooltip"}}">
                                    {{localize "ionrift-respite.downtimeLedger.exhLevel" level=currentExhaustion}}
                                </span>
                            </div>
                        </div>
                    </div>

                    {{!-- Diegetic Hazard Reason --}}
                    <div class="actor-hazard-col" data-tooltip="{{reason}}">
                        <i class="fas {{#if waived}}fa-shield-heart text-emerald{{else}}fa-campground text-amber{{/if}}"></i>
                        <span class="hazard-text">{{reason}}</span>
                    </div>

                    {{!-- Computed Target & Roll Mode Indicator --}}
                    <div class="actor-target-col">
                        {{#if mustRoll}}
                        <span class="target-dc-chip" data-tooltip="{{localize "ionrift-respite.downtimeLedger.conSaveDcTooltip"}}">{{localize "ionrift-respite.downtimeLedger.dcLabel"}} <strong>{{dc}}</strong></span>
                        <span class="target-mode-chip mode-{{advMode}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.rollModeTooltip" mode=advMode}}">
                            {{#if (eq advMode 'adv')}}{{localize "ionrift-respite.downtimeLedger.adv"}}{{else if (eq advMode 'dis')}}{{localize "ionrift-respite.downtimeLedger.dis"}}{{else}}{{localize "ionrift-respite.downtimeLedger.norm"}}{{/if}}
                        </span>
                        {{else}}
                        <span class="target-exempt-chip"><i class="fas fa-check"></i> {{localize "ionrift-respite.downtimeLedger.exempt"}}</span>
                        {{/if}}
                    </div>

                    {{!-- Primary Resolution Action --}}
                    <div class="actor-action-col">
                        {{#if rolled}}
                            {{#if passed}}
                            <div class="result-badge passed" data-tooltip="{{localize "ionrift-respite.downtimeLedger.rolledVsDc" roll=rollTotal dc=dc}}">
                                <i class="fas fa-check-circle"></i> {{localize "ionrift-respite.downtimeLedger.savedRoll" roll=rollTotal}}
                                {{#if ../isGM}}
                                <button type="button" class="btn-mini-reroll" data-action="rollActorExhaustionSave" data-actor-id="{{actorId}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.rerollSaveTooltip"}}">
                                    <i class="fas fa-rotate-right"></i>
                                </button>
                                {{/if}}
                            </div>
                            {{else}}
                            <div class="result-badge failed" data-tooltip="{{localize "ionrift-respite.downtimeLedger.rolledVsDcExh" roll=rollTotal dc=dc}}">
                                <i class="fas fa-skull"></i> {{localize "ionrift-respite.downtimeLedger.failedExhRoll" roll=rollTotal}}
                                {{#if ../isGM}}
                                <button type="button" class="btn-mini-reroll" data-action="rollActorExhaustionSave" data-actor-id="{{actorId}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.rerollSaveTooltip"}}">
                                    <i class="fas fa-rotate-right"></i>
                                </button>
                                {{/if}}
                            </div>
                            {{/if}}
                        {{else if mustRoll}}
                            {{#if ../isGM}}
                            <button type="button" class="btn-dawn-roll-trigger" data-action="rollActorExhaustionSave" data-actor-id="{{actorId}}"
                                    data-tooltip="{{localize "ionrift-respite.downtimeLedger.rollConSaveDcTooltip" dc=dc}}">
                                <i class="fas fa-dice-d20"></i> {{localize "ionrift-respite.downtimeLedger.rollDc" dc=dc}}
                            </button>
                            {{else}}
                            <span class="badge-waiting-gm"><i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.downtimeLedger.pendingGm"}}</span>
                            {{/if}}
                        {{else}}
                            <span class="badge-waived-pill"><i class="fas fa-shield-heart"></i> {{localize "ionrift-respite.downtimeLedger.waived"}}</span>
                        {{/if}}
                    </div>

                    {{!-- Progressive Disclosure Trigger (GM Only) --}}
                    {{#if ../isGM}}
                    <div class="actor-override-col">
                        <button type="button" class="btn-gear-override {{#if isOverrideOpen}}active{{/if}}"
                                data-action="toggleExhaustionOverride" data-actor-id="{{actorId}}"
                                data-tooltip="{{localize "ionrift-respite.downtimeLedger.gmAdjustmentsTooltip"}}">
                            <i class="fas fa-sliders"></i>
                        </button>
                    </div>
                    {{/if}}

                    {{!-- Inline Progressive Disclosure Drawer (Hidden until ⚙ is toggled) --}}
                    {{#if (and ../isGM isOverrideOpen)}}
                    <div class="dawn-override-drawer">
                        <div class="override-drawer-title"><i class="fas fa-sliders"></i> {{localize "ionrift-respite.downtimeLedger.adjustmentsFor" name=actorName}}</div>
                        <div class="override-drawer-controls">
                            {{!-- Waive / Require Toggle --}}
                            <label class="override-checkbox-label">
                                <input type="checkbox" class="dawn-toggle-must-roll" data-actor-id="{{actorId}}" {{#if mustRoll}}checked{{/if}}>
                                <span>{{localize "ionrift-respite.downtimeLedger.requireSave"}}</span>
                            </label>

                            {{!-- DC Stepper --}}
                            <div class="override-dc-stepper">
                                <span class="stepper-label">{{localize "ionrift-respite.downtimeLedger.dcLabel"}}</span>
                                <button type="button" class="btn-step" data-action="adjustExhaustionDC" data-actor-id="{{actorId}}" data-delta="-1">−</button>
                                <input type="number" class="dawn-dc-input" data-actor-id="{{actorId}}" value="{{dc}}" min="5" max="30">
                                <button type="button" class="btn-step" data-action="adjustExhaustionDC" data-actor-id="{{actorId}}" data-delta="1">+</button>
                            </div>

                            {{!-- Roll Mode Segment --}}
                            <div class="override-mode-segment" role="group">
                                <button type="button" class="btn-mode adv {{#if (eq advMode 'adv')}}active{{/if}}"
                                        data-action="setExhaustionAdvMode" data-actor-id="{{actorId}}" data-mode="adv">{{localize "ionrift-respite.downtimeLedger.adv"}}</button>
                                <button type="button" class="btn-mode norm {{#if (eq advMode 'norm')}}active{{/if}}"
                                        data-action="setExhaustionAdvMode" data-actor-id="{{actorId}}" data-mode="norm">{{localize "ionrift-respite.downtimeLedger.norm"}}</button>
                                <button type="button" class="btn-mode dis {{#if (eq advMode 'dis')}}active{{/if}}"
                                        data-action="setExhaustionAdvMode" data-actor-id="{{actorId}}" data-mode="dis">{{localize "ionrift-respite.downtimeLedger.dis"}}</button>
                            </div>

                            {{!-- Close Drawer Shortcut --}}
                            <button type="button" class="btn-close-override" data-action="toggleExhaustionOverride" data-actor-id="{{actorId}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.closeAdjustmentsTooltip"}}">
                                <i class="fas fa-check"></i> {{localize "ionrift-respite.downtimeLedger.done"}}
                            </button>
                        </div>
                    </div>
                    {{/if}}

                </div>
                {{/each}}
            </div>

        </div>

        {{else}}
        {{!-- 2A. Active Night Consultation Spotlight Card --}}
        <div class="pacing-spotlight-card {{#if currentNightEntry.isRolled}}{{#if currentNightEntry.isRed}}red{{else if currentNightEntry.isAmber}}amber{{else}}green{{/if}}{{else}}unrolled{{/if}}">
            <div class="spotlight-card-header">
                <div class="spotlight-title-group">
                    <span class="spotlight-kicker {{#if currentNightEntry.isRolled}}{{#if currentNightEntry.isRed}}kicker-combat{{else if currentNightEntry.isAmber}}kicker-event{{else}}kicker-safe{{/if}}{{else}}kicker-unrolled{{/if}}">
                        <i class="fas {{#if currentNightEntry.isRed}}fa-swords{{else if currentNightEntry.isAmber}}fa-compass{{else if currentNightEntry.isRolled}}fa-moon{{else}}fa-hourglass-half{{/if}}"></i>
                        {{#if currentNightEntry.isRolled}}
                            {{#if currentNightEntry.isDisaster}}{{localize "ionrift-respite.downtimeLedger.disaster"}}{{else if currentNightEntry.isRed}}{{localize "ionrift-respite.downtimeLedger.hostileAmbush"}}{{else if currentNightEntry.isAmber}}{{localize "ionrift-respite.downtimeLedger.wildernessEvent"}}{{else}}{{localize "ionrift-respite.downtimeLedger.quietRest"}}{{/if}}
                        {{else}}
                            {{localize "ionrift-respite.downtimeLedger.awaitingCheck"}}
                        {{/if}}
                    </span>
                    {{#if currentNightEntry.isResolvedCombat}}
                    <span class="spotlight-status-pill resolved-pill">
                        <i class="fas fa-circle-check"></i> {{localize "ionrift-respite.downtimeLedger.combatResolved"}}
                    </span>
                    {{/if}}
                </div>

                {{!-- Transparent DC Derivation & Co-located Stepper (GM Only) --}}
                {{#if isGM}}
                <div class="spotlight-metrics-equation" data-tooltip="{{localize "ionrift-respite.downtimeLedger.encounterDcBreakdown"}}">
                    <span class="eq-token">{{localize "ionrift-respite.downtimeLedger.baseLabel"}} <strong>{{dangerDC}}</strong></span>
                    {{#if currentNightEntry.hearthDelta}}<span class="eq-op">+</span><span class="eq-token fire">{{localize "ionrift-respite.downtimeLedger.fireLabel"}} <strong>{{currentNightEntry.hearthDeltaLabel}}</strong></span>{{/if}}
                    {{#if currentNightEntry.hasFortify}}<span class="eq-op">-</span><span class="eq-token fortify">{{localize "ionrift-respite.downtimeLedger.defLabel"}} <strong>{{currentNightEntry.fortifyDeltaLabel}}</strong></span>{{/if}}
                    <span class="eq-op">=</span>
                    <div class="spotlight-dc-stepper">
                        <button type="button" class="btn-stepper" data-action="adjustNightDC" data-night="{{activePacingNight}}" data-delta="-1" data-tooltip="{{localize "ionrift-respite.downtimeLedger.decreaseDc"}}">−</button>
                        <span class="stepper-val">{{localize "ionrift-respite.downtimeLedger.dcVal" dc=currentNightEntry.effectiveDC}}</span>
                        <button type="button" class="btn-stepper" data-action="adjustNightDC" data-night="{{activePacingNight}}" data-delta="1" data-tooltip="{{localize "ionrift-respite.downtimeLedger.increaseDc"}}">+</button>
                    </div>
                    {{#if currentNightEntry.isRolled}}
                    <span class="eq-roll-pill {{#if currentNightEntry.isRed}}red{{else if currentNightEntry.isAmber}}amber{{else}}green{{/if}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.d20DangerCheckTooltip" dc=currentNightEntry.effectiveDC}}">
                        <i class="fas fa-dice-d20"></i> {{currentNightEntry.rollTotal}}
                    </span>
                    {{/if}}
                </div>
                {{/if}}
            </div>

            {{!-- Spotlight Consultation Body --}}
            <div class="spotlight-body">
                {{#if currentNightEntry.isRolled}}
                <div class="spotlight-narrative-zone">
                    <h3 class="spotlight-event-title">
                        {{#if currentNightEntry.event}}
                            {{currentNightEntry.event.title}}
                        {{else}}
                            {{localize "ionrift-respite.downtimeLedger.quietNightTitle"}}
                        {{/if}}
                    </h3>
                    <p class="spotlight-event-description">
                        {{#if currentNightEntry.event}}
                            {{currentNightEntry.event.description}}
                        {{else}}
                            {{localize "ionrift-respite.downtimeLedger.quietNightDesc"}}
                        {{/if}}
                    </p>

                    {{!-- Sentry / Camp Awareness Callout with Portrait --}}
                    <div class="spotlight-sentry-strip">
                        <img class="sentry-strip-avatar" src="{{#if currentNightEntry.sentryImg}}{{currentNightEntry.sentryImg}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="{{currentNightEntry.sentryName}}">
                        <div class="sentry-info">
                            <span class="sentry-label">{{localize "ionrift-respite.downtimeLedger.watchOnDuty"}}</span>
                            <strong class="sentry-name">{{currentNightEntry.sentryName}}</strong>
                            <span class="sentry-pp-badge" data-tooltip="{{localize "ionrift-respite.downtimeLedger.passivePerception"}}">{{localize "ionrift-respite.downtimeLedger.ppVal" pp=currentNightEntry.sentryPP}}</span>
                            {{#if currentNightEntry.hasActiveGuard}}
                            <span class="sentry-badge alert" data-tooltip="{{localize "ionrift-respite.downtimeLedger.guardActiveTooltip"}}"><i class="fas fa-shield-alt"></i> {{localize "ionrift-respite.downtimeLedger.campGuardOnWatch"}}</span>
                            {{else}}
                            <span class="sentry-badge {{#if currentNightEntry.sentrySurprised}}surprised{{else}}alert{{/if}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.ppVsStealthDc12"}}">
                                {{#if currentNightEntry.sentrySurprised}}<i class="fas fa-triangle-exclamation"></i> {{localize "ionrift-respite.downtimeLedger.surprisedExclamation"}}{{else}}<i class="fas fa-check"></i> {{localize "ionrift-respite.downtimeLedger.alert"}}{{/if}}
                            </span>
                            {{/if}}
                        </div>
                    </div>
                </div>

                {{!-- GM Overrides & Unified Tactical Adjudication --}}
                {{#if isGM}}
                <div class="spotlight-unified-adjudication">
                    {{#if (or currentNightEntry.isRed currentNightEntry.isAmber)}}
                    <div class="adjudication-tactical-cluster">
                        {{#if currentNightEntry.isResolvedCombat}}
                        <div class="adjudication-complete-tag">
                            <i class="fas fa-check-double text-emerald"></i> {{localize "ionrift-respite.downtimeLedger.combatConcluded"}}
                        </div>
                        {{else}}
                        <button type="button" class="btn-tactical-action btn-combat-canvas" data-action="minimizeForCombat" data-tooltip="{{localize "ionrift-respite.downtimeLedger.minimizeForCombatTooltip"}}">
                            <i class="fas fa-window-minimize"></i> {{localize "ionrift-respite.downtimeLedger.runCombatOnCanvas"}}
                        </button>
                        <button type="button" class="btn-tactical-action btn-combat-quick-resolve" data-action="completeCombatForNight" data-tooltip="{{localize "ionrift-respite.downtimeLedger.completeCombatNightTooltip"}}">
                            <i class="fas fa-circle-check"></i> {{localize "ionrift-respite.downtimeLedger.markResolved"}}
                        </button>
                        {{/if}}
                    </div>
                    {{/if}}

                    <div class="adjudication-overrides-cluster">
                        <span class="cluster-label">{{localize "ionrift-respite.downtimeLedger.overridesLabel"}}</span>
                        <button type="button" class="btn-spotlight-curate" data-action="pickPoolNightEvent" data-night="{{activePacingNight}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.pickPoolEventTooltip"}}">
                            <i class="fas fa-book-open"></i> {{localize "ionrift-respite.downtimeLedger.pool"}}
                        </button>
                        <button type="button" class="btn-spotlight-curate" data-action="improviseNightOverride" data-night="{{activePacingNight}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.improviseScenarioTooltip"}}">
                            <i class="fas fa-hat-wizard"></i> {{localize "ionrift-respite.downtimeLedger.improvise"}}
                        </button>
                        <button type="button" class="btn-spotlight-curate safe" data-action="setNightQuiet" data-night="{{activePacingNight}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.quietNightOverrideTooltip"}}">
                            <i class="fas fa-moon"></i> {{localize "ionrift-respite.downtimeLedger.quietRest"}}
                        </button>
                        <button type="button" class="btn-spotlight-curate reroll" data-action="rerollNight" data-night="{{activePacingNight}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.rerollDangerCheckTooltip" dc=currentNightEntry.effectiveDC}}">
                            <i class="fas fa-dice"></i> {{localize "ionrift-respite.downtimeLedger.reroll"}}
                        </button>
                    </div>
                </div>
                {{/if}}

                {{else}}
                {{!-- UNROLLED: THE CEREMONIAL VIGIL BEAT --}}
                <div class="spotlight-unrolled-ceremony">
                    <div class="ceremony-lead">
                        <img class="ceremony-sentry-img" src="{{#if currentNightEntry.sentryImg}}{{currentNightEntry.sentryImg}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="{{currentNightEntry.sentryName}}">
                        <div class="ceremony-narrative">
                            <h3 class="ceremony-title">{{localize "ionrift-respite.downtimeLedger.nightVigilBegins"}}</h3>
                            <p class="ceremony-prompt">
                                {{{localize "ionrift-respite.downtimeLedger.vigilPrompt" sentry=currentNightEntry.sentryName pp=currentNightEntry.sentryPP dc=currentNightEntry.effectiveDC}}}
                            </p>
                        </div>
                    </div>

                    {{#if isGM}}
                    <div class="spotlight-roll-ceremony-deck">
                        <div class="nw-mode-selector" role="tablist" aria-label="{{localize "ionrift-respite.downtimeLedger.vigilAriaLabel"}}">
                            <button type="button" class="nw-mode-tab" data-action="rollNightCheck" data-night="{{activePacingNight}}"
                                    data-tooltip="{{localize "ionrift-respite.downtimeLedger.randomCheckTooltip" dc=currentNightEntry.effectiveDC}}">
                                <i class="fas fa-dice-d20 nw-mode-icon"></i>
                                <span class="nw-mode-label">{{localize "ionrift-respite.downtimeLedger.randomCheck"}}</span>
                            </button>
                            <button type="button" class="nw-mode-tab" data-action="improviseNightCheck" data-night="{{activePacingNight}}"
                                    data-tooltip="{{localize "ionrift-respite.downtimeLedger.improviseCheckTooltip" dc=currentNightEntry.effectiveDC}}">
                                <i class="fas fa-hat-wizard nw-mode-icon"></i>
                                <span class="nw-mode-label">{{localize "ionrift-respite.downtimeLedger.improvise"}}</span>
                            </button>
                            <button type="button" class="nw-mode-tab" data-action="pickPoolNightEvent" data-night="{{activePacingNight}}"
                                    data-tooltip="{{localize "ionrift-respite.downtimeLedger.pickFromPoolTooltip"}}">
                                <i class="fas fa-book-open nw-mode-icon"></i>
                                <span class="nw-mode-label">{{localize "ionrift-respite.downtimeLedger.pickFromPool"}}</span>
                            </button>
                            <button type="button" class="nw-mode-tab safe-bypass" data-action="setNightQuiet" data-night="{{activePacingNight}}"
                                    data-tooltip="{{localize "ionrift-respite.downtimeLedger.quietRestOverrideTooltip"}}">
                                <i class="fas fa-moon nw-mode-icon"></i>
                                <span class="nw-mode-label">{{localize "ionrift-respite.downtimeLedger.quietRest"}}</span>
                            </button>
                        </div>
                    </div>
                    {{else}}
                    <div class="player-pacing-waiting">
                        <i class="fas fa-hourglass-half"></i>
                        <span>{{localize "ionrift-respite.downtimeLedger.gmPreparingCheck"}}</span>
                    </div>
                    {{/if}}
                </div>
                {{/if}}
            </div>
        </div>
        {{/if}}

        {{!-- 3. Dedicated Pacing Footer Controls --}}
        <div class="downtime-pacing-footer">
            {{#if isSingleNight}}
            {{#if isDawnCheck}}
            {{!-- Single Night Dawn Footer --}}
            <button type="button" class="btn-pacing-nav prev" data-action="previousPacingNight" data-tooltip="{{localize "ionrift-respite.downtimeLedger.returnToOvernightVigil"}}">
                <i class="fas fa-arrow-left"></i> {{localize "ionrift-respite.downtimeLedger.backToVigil"}}
            </button>
            <div class="pacing-footer-status">
                <span>{{localize "ionrift-respite.downtimeLedger.dawnFinalAdjudication"}}</span>
            </div>
            {{#if isGM}}
                {{#if exhaustionSummary.pending}}
                <button type="button" class="btn-pacing-nav disabled-pacing" disabled data-tooltip="{{localize "ionrift-respite.downtimeLedger.awaitingExhaustionTooltip"}}">
                    <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.downtimeLedger.awaitingExhaustionSaves"}}
                </button>
                {{else}}
                <button type="button" class="btn-resolve-downtime btn-pacing-finalize" data-action="resolveDowntime" data-tooltip="{{localize "ionrift-respite.downtimeLedger.completeRestTooltip"}}">
                    <i class="fas fa-check-double"></i> {{localize "ionrift-respite.downtimeLedger.completeRest"}}
                </button>
                {{/if}}
            {{else}}
            <div class="player-pacing-footer-note"><span>{{localize "ionrift-respite.downtimeLedger.waitingForGm"}}</span></div>
            {{/if}}

            {{else}}
            {{!-- Single Night Vigil Footer --}}
            {{#if canReturnToPlanning}}
            <button type="button" class="btn-pacing-nav prev" data-action="returnToPlanning" data-tooltip="{{localize "ionrift-respite.downtimeLedger.returnToPlanningTooltip"}}">
                <i class="fas fa-arrow-left"></i> {{localize "ionrift-respite.downtimeLedger.campPlanning"}}
            </button>
            {{else}}
            <div class="pacing-footer-spacer"></div>
            {{/if}}
            <div class="pacing-footer-status">
                <span>{{localize "ionrift-respite.downtimeLedger.eightHourOvernightRest"}}</span>
            </div>
            {{#if isGM}}
                {{#if currentNightEntry.isRolled}}
                <button type="button" class="btn-pacing-nav next" data-action="nextPacingNight" data-tooltip="{{localize "ionrift-respite.downtimeLedger.advanceToDawnTooltip"}}">
                    <span>{{localize "ionrift-respite.downtimeLedger.dawnFinalization"}}</span> <i class="fas fa-sun"></i>
                </button>
                {{else}}
                <button type="button" class="btn-pacing-nav disabled-pacing" disabled data-tooltip="{{localize "ionrift-respite.downtimeLedger.rollNightCheckFirstTooltip"}}">
                    <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.downtimeLedger.awaitingNightCheck"}}
                </button>
                {{/if}}
            {{else}}
            <div class="player-pacing-footer-note">
                <span>{{localize "ionrift-respite.downtimeLedger.waitingForGm"}}</span>
            </div>
            {{/if}}
            {{/if}}

            {{else}}
            {{!-- Multi-Night Footer --}}
            <button type="button" class="btn-pacing-nav prev" data-action="previousPacingNight" {{#unless prevPacingNight}}disabled{{/unless}} data-tooltip="{{#if prevPacingNight}}{{localize "ionrift-respite.downtimeLedger.inspectNightTooltip" night=prevPacingNight}}{{else}}{{localize "ionrift-respite.downtimeLedger.alreadyFirstNight"}}{{/if}}">
                <i class="fas fa-chevron-left"></i> {{#if prevPacingNight}}{{localize "ionrift-respite.downtimeLedger.prevNightShort" night=prevPacingNight}}{{else}}{{localize "ionrift-respite.downtimeLedger.previousNight"}}{{/if}}
            </button>

            <div class="pacing-footer-status">
                {{#if isDawnCheck}}
                <span>{{localize "ionrift-respite.downtimeLedger.dawnFinalCheck"}}</span>
                {{else}}
                <span>{{localize "ionrift-respite.downtimeLedger.nightOfTotal" current=activePacingNight total=totalNights}}</span>
                {{/if}}
            </div>

            {{#if isGM}}
                {{#if isDawnCheck}}
                    {{#if exhaustionSummary.pending}}
                    <button type="button" class="btn-pacing-nav disabled-pacing" disabled data-tooltip="{{localize "ionrift-respite.downtimeLedger.awaitingExhaustionTooltip"}}">
                        <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.downtimeLedger.awaitingExhaustionSaves"}}
                    </button>
                    {{else}}
                    <button type="button" class="btn-resolve-downtime btn-pacing-finalize" data-action="resolveDowntime" data-tooltip="{{localize "ionrift-respite.downtimeLedger.completeMultiNightTooltip"}}">
                        <i class="fas fa-check-double"></i> {{localize "ionrift-respite.downtimeLedger.completeRest"}}
                    </button>
                    {{/if}}
                {{else if isFinalPacingNight}}
                <button type="button" class="btn-pacing-nav next" data-action="nextPacingNight" data-tooltip="{{localize "ionrift-respite.downtimeLedger.advanceToDawnExhaustionTooltip"}}">
                    <span>{{localize "ionrift-respite.downtimeLedger.dawnFinalization"}}</span> <i class="fas fa-sun"></i>
                </button>
                {{else if sendoffOpen}}
                    {{#if mealBuffPending}}
                    <button type="button" class="btn-pacing-nav disabled-pacing" disabled data-tooltip="{{localize "ionrift-respite.downtimeLedger.applySendoffTooltip"}}">
                        <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.downtimeLedger.applyTheSendoff"}}
                    </button>
                    {{else}}
                    <button type="button" class="btn-pacing-nav next" data-action="nextPacingNight" data-tooltip="{{localize "ionrift-respite.downtimeLedger.sendoffReadyTooltip"}}">
                        <span>{{localize "ionrift-respite.downtimeLedger.lastWatch"}}</span> <i class="fas fa-moon"></i>
                    </button>
                    {{/if}}
                {{else if sendoffReady}}
                <button type="button" class="btn-pacing-nav next" data-action="nextPacingNight" data-tooltip="{{localize "ionrift-respite.downtimeLedger.applySendoffTooltip"}}">
                    <span>{{localize "ionrift-respite.downtimeLedger.sendoff"}}</span> <i class="fas fa-utensils"></i>
                </button>
                {{else}}
                <button type="button" class="btn-pacing-nav next" data-action="nextPacingNight" data-tooltip="{{localize "ionrift-respite.downtimeLedger.advanceToNextNightTooltip"}}">
                    <span>{{localize "ionrift-respite.downtimeLedger.nextNightN" night=nextPacingNight}}</span> <i class="fas fa-chevron-right"></i>
                </button>
                {{/if}}
            {{else}}
            <div class="player-pacing-footer-note">
                {{#if sendoffOpen}}
                <span>{{#if mealBuffPending}}{{localize "ionrift-respite.downtimeLedger.applyMealOrDrink"}}{{else}}{{localize "ionrift-respite.downtimeLedger.waitingOnLastWatch"}}{{/if}}</span>
                {{else}}
                <span>{{localize "ionrift-respite.downtimeLedger.waitingForGm"}}</span>
                {{/if}}
            </div>
            {{/if}}
            {{/if}}
        </div>
    </div>
    {{else}}

    {{!-- Safe Rest Haven Strip (Civilized / Safe Haven) --}}
    {{#if (or isCivilized campConditionsBar.safeRestSpot)}}
    <div class="downtime-haven-strip haven-civilized">
        <div class="downtime-conditions-indicator" role="status" aria-label="{{localize "ionrift-respite.downtimeLedger.campConditionsAria"}}">
            <span class="camp-status-chip terrain-chip" data-tooltip="{{campConditionsBar.terrainTooltip}}">
                <i class="{{campConditionsBar.terrainIcon}}" aria-hidden="true"></i> {{campConditionsBar.terrainLabel}}
            </span>
            <span class="camp-status-chip comfort-safe" data-tooltip="{{localize "ionrift-respite.downtimeLedger.comfortSafeTooltip"}}">
                <i class="fas fa-shield-halved" aria-hidden="true"></i> {{localize "ionrift-respite.downtimeLedger.safeRestSpot"}}
            </span>
        </div>
        <div class="downtime-commissary-strip">
            <div class="commissary-pill civilized" data-tooltip="{{localize "ionrift-respite.downtimeLedger.lifestyleCoveredTooltip"}}">
                <i class="fas fa-utensils"></i> {{{localize "ionrift-respite.downtimeLedger.lodgingsMealsCovered"}}}
            </div>
        </div>
    </div>
    {{/if}}

    {{!-- Character Dock: identity card + party switcher (mock: rest-dock-gritty).
         The dock owns the switcher on the downtime ledger, so no separate
         roster strip is rendered here. Starvation and dehydration warnings
         appear as glyphs on the mini portraits. --}}
    {{#if isWilderness}}
    {{> restDock}}
    {{else}}
    {{> rosterStrip}}
    {{/if}}

    {{!-- Main Area: Unified Content-Only Workflow Panel.
         The workflow segments and Examine live on the dock nav
         (mock: rest-dock-gritty). This panel is content-only for both GM and players. --}}
    <div class="downtime-workflow-panel workflow-{{selectedWorkflowStep}}">
        {{!-- GM Roster Rows --}}
        <div class="downtime-gm-roster">
            {{#each characters}}
            <div class="gm-character-row-wrap expanded {{#if hasStarvationRisk}}starvation-risk{{/if}} {{#unless (eq id ../selectedCharacterId)}}tab-hidden{{/unless}}" data-actor-id="{{id}}">
                <div class="gm-char-drilldown-panel">
                    <div class="downtime-tiers-stack">

                    <div class="downtime-tier-card tier-examine">
                        <div class="examine-diegetic">
                            <div class="sust-section-label">{{localize "ionrift-respite.downtimeLedger.examineSection"}}</div>
                            {{#if workbenchEmbed}}
                            {{#with workbenchEmbed}}
                            {{> workbenchIdentifyPanel}}
                            {{/with}}
                            {{else}}
                            <div class="rest-night-card sel">
                                <span class="rest-night-main">
                                    <strong>{{localize "ionrift-respite.downtimeLedger.examineIsOff"}}</strong>
                                    <span>{{localize "ionrift-respite.downtimeLedger.examineTurnOnHint"}}</span>
                                </span>
                            </div>
                            {{/if}}
                        </div>
                    </div>

                    {{!-- TIER 1: Station Activities --}}
                    <div class="downtime-tier-card tier-activities">
                        <div class="sust-section-label">{{localize "ionrift-respite.downtimeLedger.activitiesSection"}}</div>
                        <div class="act-planner">
                            <div class="sust-planner-head">
                                <span class="sust-grow"></span>
                                <span class="sust-budget{{#if isCommitted}} done{{/if}}">{{#if isCommitted}}{{localize "ionrift-respite.downtimeLedger.locked"}}{{else if budget.isComplete}}{{localize "ionrift-respite.downtimeLedger.readyToLock"}}{{else}}{{localize "ionrift-respite.downtimeLedger.daysUnallocatedShort" days=budget.unallocatedDays}}{{/if}}</span>
                            </div>
                        <div class="tier-card-header">
                            <span class="tier-title"><i class="fas fa-hammer"></i> {{localize "ionrift-respite.downtimeLedger.activities"}}</span>
                            <div class="tier-header-badges">
                                {{#if (and (or ../workbenchIdentifyUiEnabled workbenchIdentifyUiEnabled) canInteract)}}
                                <button type="button" class="btn-tier-override btn-identify-toggle {{#if isIdentifyOpen}}active{{/if}}"
                                    data-action="toggleIdentifyDrawer" data-actor-id="{{id}}"
                                    data-tooltip="{{#if isIdentifyOpen}}{{localize "ionrift-respite.downtimeLedger.closeIdentifyWorkbench"}}{{else}}{{localize "ionrift-respite.downtimeLedger.openIdentifyWorkbench" remaining=focusRemaining budget=focusBudget}}{{/if}}">
                                    <i class="fas fa-magnifying-glass"></i> {{localize "ionrift-respite.downtimeLedger.identify"}}{{#if identifyDays}} ({{identifyDays}}d){{/if}}
                                </button>
                                {{/if}}
                                {{#if isCommitted}}
                                <span class="tier-status-pill complete" data-tooltip="{{localize "ionrift-respite.downtimeLedger.activitiesCommittedTooltip"}}">
                                    <i class="fas fa-lock"></i> {{localize "ionrift-respite.downtimeLedger.choicesLocked"}}
                                </span>
                                {{#if isGM}}
                                <button type="button" class="btn-tier-override" data-action="unlockActivities" data-actor-id="{{id}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.gmResetAllocationTooltip"}}">
                                    <i class="fas fa-rotate-left"></i> {{localize "ionrift-respite.downtimeLedger.reset"}}
                                </button>
                                {{/if}}
                                {{else}}
                                <span class="tier-status-pill pending">
                                    {{#if budget.isComplete}}{{localize "ionrift-respite.downtimeLedger.readyToLock"}}{{else}}{{localize "ionrift-respite.downtimeLedger.daysUnallocatedShort" days=budget.unallocatedDays}}{{/if}}
                                </span>
                                {{/if}}
                            </div>
                        </div>

                        {{!-- 7-day segment bar (mock: rest-dock-gritty activities).
                             Mirrors the player view; GM sees the same rollup. --}}
                        {{#unless isCommitted}}
                        <div class="downtime-segment-bar gm-segment-bar">
                            {{#each budget.segments}}
                            <div class="segment-pip {{#if filled}}filled{{/if}} {{#if isRollable}}rollable roll-{{rollStatus}}{{/if}}"
                                {{#if canRollPip}}data-action="rollActivityDay"{{/if}}
                                data-activity="{{activityId}}"
                                data-day="{{dayNumber}}"
                                data-actor-id="{{../id}}"
                                data-tooltip="{{pipTooltip}}">
                                <span class="pip-day">D{{dayNumber}}</span>
                                {{#if filled}}<b class="pip-act">{{label}}</b>{{/if}}
                                {{#if (eq rollStatus "pass")}}<i class="fas fa-check pip-roll-badge pass"></i>{{/if}}
                                {{#if (eq rollStatus "fail")}}<i class="fas fa-times pip-roll-badge fail"></i>{{/if}}
                                {{#if (eq rollStatus "pending")}}<i class="fas fa-circle-dot pip-roll-badge pending"></i>{{/if}}
                            </div>
                            {{/each}}
                        </div>
                        {{/unless}}

                        <div class="tier-card-body tier-activities-body">
                            {{#if isCommitted}}
                            {{!-- Locked State: Clean Itinerary Docket --}}
                            <div class="tier-content-zone locked-activities-docket">
                                <div class="locked-docket-header">
                                    <span class="docket-title"><i class="fas fa-calendar-check"></i> {{localize "ionrift-respite.downtimeLedger.itinerary"}}</span>
                                    <span class="docket-total">{{localize "ionrift-respite.downtimeLedger.allDaysAssigned"}}</span>
                                </div>
                                <div class="locked-docket-items">
                                    {{#each activeActivities}}
                                    <div class="locked-activity-pill" data-tooltip="{{hint}}">
                                        <span class="locked-act-icon"><i class="{{icon}}"></i></span>
                                        <span class="locked-act-label">{{label}}</span>
                                        <span class="locked-act-days">{{assignedDays}}d</span>
                                    </div>
                                    {{/each}}
                                </div>
                            </div>
                            {{else}}
                            {{!-- Left Zone: Station Activities Chips --}}
                            <div class="tier-content-zone downtime-activity-picker rest-night-stations">
                                {{> downtimeActivityStations}}
                            </div>
                            {{/if}}

                            {{!-- Right Zone: 180px Action Rail --}}
                            <div class="tier-action-rail">
                                {{#if isCommitted}}
                                    {{#if hasDefenseRolls}}
                                    {{#if fortifySummary.isAllRolled}}
                                        <div class="badge-tier-resolved defenses {{fortifySummary.resultClass}}" data-tooltip="{{fortifySummary.tooltip}}">
                                            <i class="{{fortifySummary.resultIcon}}"></i>
                                            <span>{{fortifySummary.resultLabel}}</span>
                                        </div>
                                        {{#if (or isGM ../isGM)}}
                                        <button type="button" class="btn-tier-override"
                                            data-action="rollAllActivities" data-roll-kind="defense" data-actor-id="{{id}}"
                                            data-tooltip="{{localize "ionrift-respite.downtimeLedger.gmRerollDefensesTooltip"}}">
                                            <i class="fas fa-redo"></i>
                                            <span>{{localize "ionrift-respite.downtimeLedger.reroll"}}</span>
                                        </button>
                                        {{/if}}
                                    {{else}}
                                        {{#if canInteract}}
                                        <button type="button" class="btn-tier-action btn-roll-defenses"
                                            data-action="rollAllActivities" data-roll-kind="defense" data-actor-id="{{id}}"
                                            data-tooltip="{{localize "ionrift-respite.downtimeLedger.rollUnrolledDefensesTooltip"}}">
                                            <i class="fas fa-dice-d20"></i>
                                            <span>{{localize "ionrift-respite.downtimeLedger.rollDefenses"}}{{#if fortifySummary.unrolledCount}} ({{fortifySummary.unrolledCount}}d){{/if}}</span>
                                        </button>
                                        {{else}}
                                        <span class="tier-action-placeholder">
                                            <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.downtimeLedger.awaitingRoll"}}
                                        </span>
                                        {{/if}}
                                    {{/if}}
                                    {{/if}}

                                    {{#if hasSkillChecks}}
                                    {{#if skillCheckSummary.isAllRolled}}
                                        <div class="badge-tier-resolved" data-tooltip="{{skillCheckSummary.tooltip}}">
                                            <i class="fas fa-check-double"></i>
                                            <span>{{skillCheckSummary.resultLabel}}</span>
                                        </div>
                                        {{#if (or isGM ../isGM)}}
                                        <button type="button" class="btn-tier-override"
                                            data-action="rollAllActivities" data-roll-kind="skill" data-actor-id="{{id}}"
                                            data-tooltip="{{localize "ionrift-respite.downtimeLedger.gmRerollSkillChecksTooltip"}}">
                                            <i class="fas fa-redo"></i>
                                            <span>{{localize "ionrift-respite.downtimeLedger.reroll"}}</span>
                                        </button>
                                        {{/if}}
                                    {{else}}
                                        {{#if canInteract}}
                                        <button type="button" class="btn-tier-action btn-roll-defenses"
                                            data-action="rollAllActivities" data-roll-kind="skill" data-actor-id="{{id}}"
                                            data-tooltip="{{skillCheckSummary.tooltip}}">
                                            <i class="fas fa-dice-d20"></i>
                                            <span>{{localize "ionrift-respite.downtimeLedger.rollSkillCheck" label=skillCheckSummary.label}}{{#if skillCheckSummary.unrolledCount}} ({{skillCheckSummary.unrolledCount}}d){{/if}}</span>
                                        </button>
                                        {{else}}
                                        <span class="tier-action-placeholder">
                                            <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.downtimeLedger.awaitingRoll"}}
                                        </span>
                                        {{/if}}
                                    {{/if}}
                                    {{/if}}

                                    {{#if hasCraftingActivities}}
                                    {{#if isAllCraftsResolved}}
                                    <div class="badge-tier-resolved craft"
                                        data-tooltip="{{localize "ionrift-respite.downtimeLedger.allCraftDaysResolvedTooltip" count=craftDaysCount}}">
                                        <i class="fas fa-check-double"></i>
                                        <span>{{localize "ionrift-respite.downtimeLedger.craftsCompleteDays" count=craftDaysCount}}</span>
                                    </div>
                                    {{else}}
                                    {{#if canChangeCraftPlan}}
                                    <button type="button" class="btn-tier-action"
                                        data-action="unlockActivities" data-actor-id="{{id}}"
                                        data-tooltip="{{localize "ionrift-respite.downtimeLedger.changePlanTooltip"}}">
                                        <i class="fas fa-rotate-left"></i>
                                        <span>{{localize "ionrift-respite.downtimeLedger.changePlan"}}</span>
                                    </button>
                                    {{/if}}
                                    <button type="button" class="btn-tier-action btn-resolve-crafts in-progress"
                                        data-action="openCraftQueue" data-actor-id="{{id}}"
                                        {{#unless canInteract}}disabled{{/unless}}
                                        data-tooltip="{{localize "ionrift-respite.downtimeLedger.resolveCraftsTooltip" count=craftDaysRemaining}}">
                                        <i class="fas fa-utensils"></i>
                                        <span>{{localize "ionrift-respite.downtimeLedger.resolveCraftsDays" count=craftDaysRemaining}}</span>
                                    </button>
                                    {{/if}}
                                    {{/if}}

                                    {{#unless (or hasRollableActivities hasCraftingActivities)}}
                                    <span class="tier-action-placeholder">
                                        <i class="fas fa-check"></i> <span>{{localize "ionrift-respite.downtimeLedger.noChecksRequired"}}</span>
                                    </span>
                                    {{/unless}}
                                {{else}}
                                    {{#if budget.isComplete}}
                                    <button type="button" class="btn-tier-action btn-commit"
                                        data-action="commitActivities" data-actor-id="{{id}}"
                                        {{#unless canInteract}}disabled{{/unless}}
                                        data-tooltip="{{localize "ionrift-respite.downtimeLedger.lockInChoicesTooltip"}}">
                                        <i class="fas fa-lock"></i> <span>{{localize "ionrift-respite.downtimeLedger.lockInChoices"}}</span>
                                    </button>
                                    {{else}}
                                    <button type="button" class="btn-tier-action btn-commit" disabled
                                        data-tooltip="{{localize "ionrift-respite.downtimeLedger.assignAllDaysTooltip"}}">
                                        <i class="fas fa-lock"></i> <span>{{localize "ionrift-respite.downtimeLedger.assignAllDays"}}</span>
                                    </button>
                                    {{/if}}
                                {{/if}}
                            </div>
                        </div>
                        {{#if ../showSustenanceStep}}
                        {{#if (or isCommitted budget.isComplete)}}
                        <div class="rest-step-pacing">
                            <button type="button" class="btn-step-next" data-action="switchWorkflow" data-step="sustenance">
                                <span>{{localize "ionrift-respite.downtimeLedger.nextSustenance"}}</span> <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </button>
                        </div>
                        {{/if}}
                        {{/if}}
                        </div>
                        {{#if (and isIdentifyOpen workbenchEmbed)}}
                        <div class="downtime-workbench-drawer examine-diegetic">
                            <div class="sust-section-label">{{localize "ionrift-respite.downtimeLedger.examineSection"}}</div>
                            {{#with workbenchEmbed}}
                            {{> workbenchIdentifyPanel}}
                            {{/with}}
                        </div>
                        {{/if}}
                    </div>

                    {{!-- TIER 2: Gathering [Wilderness Only] --}}
                    {{#if ../isWilderness}}
                    <div class="downtime-tier-card tier-gathering">
                        <div class="sust-section-label">{{localize "ionrift-respite.downtimeLedger.gatherProvisionsSection"}}</div>
                        <div class="act-planner">
                            <div class="sust-planner-head">
                                {{#if gatheringSummary.isAllRolled}}
                                <span class="harvest-done"><i class="fas fa-check" aria-hidden="true"></i> {{localize "ionrift-respite.downtimeLedger.harvested"}}</span>
                                {{/if}}
                                <span class="sust-grow"></span>
                                <span class="gather-dc-pill">{{localize "ionrift-respite.downtimeLedger.forageDc" dc=forageDC}}</span>
                                <span class="gather-dc-pill hunt">{{localize "ionrift-respite.downtimeLedger.huntDc" dc=huntDC}}</span>
                                <span class="gather-surv-pill">{{localize "ionrift-respite.downtimeLedger.survivalMod" mod=survivalModFormatted}}</span>
                            </div>
                        <div class="tier-card-header">
                            <span class="tier-title"><i class="fas fa-seedling"></i> {{localize "ionrift-respite.downtimeLedger.gathering"}}</span>
                            {{#if gatheringSummary.isAllRolled}}
                            <span class="tier-status-pill complete" data-tooltip="{{localize "ionrift-respite.downtimeLedger.allGatheringDaysResolvedTooltip"}}">
                                <i class="fas fa-check"></i> {{localize "ionrift-respite.downtimeLedger.harvested"}}
                            </span>
                            {{else}}
                            <div class="gathering-dc-readouts">
                                <span class="gathering-dc-badge forage" data-tooltip="{{localize "ionrift-respite.downtimeLedger.forageDcTooltip"}}"><i class="fas fa-leaf"></i> {{localize "ionrift-respite.downtimeLedger.dcVal" dc=forageDC}}</span>
                                <span class="gathering-dc-badge hunt" data-tooltip="{{localize "ionrift-respite.downtimeLedger.huntDcTooltip"}}"><i class="fas fa-crosshairs"></i> {{localize "ionrift-respite.downtimeLedger.dcVal" dc=huntDC}}</span>
                            </div>
                            <span class="tier-status-pill survival" data-tooltip="{{localize "ionrift-respite.downtimeLedger.survivalModTooltip"}}">{{localize "ionrift-respite.downtimeLedger.survivalMod" mod=survivalModFormatted}}</span>
                            {{/if}}
                        </div>
                        <div class="tier-card-body tier-gathering-body">
                            {{!-- 7-Day Schedule Strip (always 100% width, 44px height, clean landscape cards) --}}
                            <div class="tier-content-zone gathering-schedule-strip">
                                {{#each gatheringSchedule}}
                                <div class="gathering-day-cell {{mode}} {{#if isSkip}}skip{{else if rolled}}{{#if success}}rolled pass{{else}}rolled fail{{/if}}{{/if}}" data-tooltip="{{tooltip}}">
                                    <button type="button" class="btn-day-toggle" data-action="toggleGatheringDay" data-actor-id="{{../id}}" data-day="{{day}}" {{#unless canToggle}}disabled{{/unless}}>
                                        <span class="day-label">D{{day}}</span>
                                        <b class="day-mode">{{#if modeLabel}}{{modeLabel}}{{else}}{{label}}{{/if}}</b>
                                        {{#if rolled}}
                                        {{#unless isSkip}}
                                        <span class="day-yield {{#if success}}pass{{else}}fail{{/if}}">
                                            {{#if success}}<i class="fas fa-check"></i> {{localize "ionrift-respite.downtimeLedger.found"}}{{else}}<i class="fas fa-xmark"></i> {{localize "ionrift-respite.downtimeLedger.nothing"}}{{/if}}
                                        </span>
                                        {{/unless}}
                                        {{/if}}
                                    </button>
                                </div>
                                {{/each}}
                            </div>

                            {{!-- Action Rail (shown when days remain unrolled) --}}
                            {{#unless gatheringSummary.isAllRolled}}
                            <div class="tier-action-rail">
                                {{#if canInteract}}
                                <button type="button" class="btn-tier-action btn-roll-all-gathering" data-action="rollAllGathering" data-actor-id="{{id}}" data-tooltip="{{localize "ionrift-respite.downtimeLedger.rollAllDaysTooltip"}}">
                                    <i class="fas fa-dice-d20"></i>
                                    <span>{{localize "ionrift-respite.downtimeLedger.rollAllDays" count=gatheringSummary.unrolledCount}}</span>
                                </button>
                                {{else}}
                                <span class="tier-action-placeholder">
                                    <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.downtimeLedger.awaitingRoll"}}
                                </span>
                                {{/if}}
                            </div>
                            {{/unless}}

                            {{!-- Harvest Report (below the 7-day strip once all days are rolled or skipped) --}}
                            {{#if gatheringSummary.isAllRolled}}
                            <div class="tier-content-zone gather-report">
                                {{#if gatheringSummary.hasFinds}}
                                <div class="gather-find-list">
                                    {{#each gatheringSchedule}}
                                    {{#if finds.length}}
                                    <div class="gather-find-day">
                                        <span class="gather-find-day-label">D{{day}}</span>
                                        {{#each finds}}
                                        <span class="gather-find" data-tooltip="{{name}}{{#if qtyLabel}}, {{qtyLabel}}{{/if}}">
                                            {{#if img}}<img src="{{img}}" alt="">{{/if}}
                                            <span class="gather-find-name">{{name}}</span>
                                            {{#if qtyLabel}}<b>{{qtyLabel}}</b>{{/if}}
                                        </span>
                                        {{/each}}
                                    </div>
                                    {{/if}}
                                    {{/each}}
                                </div>
                                {{else}}
                                <div class="gather-empty-report">
                                    <i class="fas fa-seedling"></i>
                                    <span>{{{localize "ionrift-respite.downtimeLedger.noProvisionsGathered"}}}</span>
                                </div>
                                {{/if}}
                                {{#if gatheringSummary.reportLine}}
                                <p class="harvest-tally">{{gatheringSummary.reportLine}}</p>
                                {{/if}}
                                {{#if gatheringSummary.freshForageNote}}
                                <p class="harvest-spoil-note">{{gatheringSummary.freshForageNote}}</p>
                                {{/if}}
                            </div>
                            {{/if}}
                        </div>
                        <div class="rest-step-pacing">
                            <button type="button" class="btn-step-next" data-action="switchWorkflow" data-step="activities">
                                <span>{{localize "ionrift-respite.downtimeLedger.nextActivity"}}</span> <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </button>
                        </div>
                        </div>
                    </div>
                    {{/if}}

                    {{!-- TIER 3: Sustenance --}}
                    {{#if ../showSustenanceStep}}
                    <div class="downtime-tier-card tier-food {{#if hasDehydrationRisk}}dehydration{{else if hasStarvationRisk}}starvation{{/if}}">
                        {{#if (eq ../selectedWorkflowStep "sustenance")}}
                        {{!-- Diegetic two-column pile/vessel (mock target) --}}
                        {{> sustenanceDiegetic actorId=id}}
                        {{else}}
                        {{!-- Compact summary on non-sustenance tabs --}}
                        <div class="tier-card-header">
                            <div class="tier-title-cluster">
                                <span class="tier-title"><i class="fas fa-utensils"></i> {{localize "ionrift-respite.downtimeLedger.sustenance"}}</span>
                                {{#if climateLabel}}
                                <span class="tier-climate-pill {{#if isTraitPill}}tier-trait-pill{{/if}}" data-tooltip="{{climateTooltip}}">{{climateLabel}}</span>
                                {{/if}}
                            </div>
                            <div class="tier-header-badges">
                                <span class="tier-status-pill {{#if hasStarvationRisk}}shortfall starvation{{else}}complete{{/if}}" data-tooltip="{{foodTooltip}}">
                                    <i class="fas {{#if hasStarvationRisk}}fa-triangle-exclamation{{else}}fa-check{{/if}}"></i> {{#if hasStarvationRisk}}{{localize "ionrift-respite.downtimeLedger.foodShortfall" days=foodFlow.shortfallDays}}{{else}}{{localize "ionrift-respite.downtimeLedger.foodFed"}}{{/if}}
                                </span>
                                {{#if isWilderness}}
                                <span class="tier-status-pill {{#if hasDehydrationRisk}}shortfall dehydration{{else}}complete{{/if}}" data-tooltip="{{autoWaterTooltip}}">
                                    <i class="fas {{#if hasDehydrationRisk}}fa-droplet-slash{{else}}fa-droplet{{/if}}"></i> {{#if hasDehydrationRisk}}{{localize "ionrift-respite.downtimeLedger.waterShortfall" days=waterFlow.shortfallDays}}{{else}}{{localize "ionrift-respite.downtimeLedger.waterHydrated"}}{{/if}}
                                </span>
                                {{/if}}
                                {{#if selectedDepartureMeal.hasBuff}}
                                <span class="tier-status-pill buff-active" data-tooltip="{{localize "ionrift-respite.downtimeLedger.departureSendoffTooltip" name=selectedDepartureMeal.name buff=selectedDepartureMeal.buffSummary}}">
                                    <i class="fas fa-wand-magic-sparkles"></i> {{selectedDepartureMeal.buffSummary}}
                                </span>
                                {{/if}}
                                {{#if selectedDepartureDrink.hasBuff}}
                                <span class="tier-status-pill buff-active" data-tooltip="{{localize "ionrift-respite.downtimeLedger.departureDrinkTooltip" name=selectedDepartureDrink.name buff=selectedDepartureDrink.buffSummary}}">
                                    <i class="fas fa-wine-glass"></i> {{selectedDepartureDrink.buffSummary}}
                                </span>
                                {{/if}}
                            </div>
                        </div>
                        {{/if}}
                    </div>
                    {{/if}}

                </div>
            </div>
        </div>
        {{/each}}
    </div>
    </div>

    {{#if isGM}}
    {{#if isWilderness}}
    {{> campLogisticsDrawer}}
    {{/if}}
    {{/if}}

    {{!-- Unified Footer Bar (mock: rest-dock-gritty footer).
         Logistics · Encounter DC · Ready count · Proceed --}}
    <div class="downtime-footer-bar rest-footer-unified">
        {{#if isGM}}
        {{#if isWilderness}}
        <button type="button"
            class="btn-gm-logistics{{#if logisticsDrawerOpen}} active{{/if}}"
            data-action="toggleLogisticsDrawer"
            data-tooltip="{{#if logisticsDrawerOpen}}{{localize "ionrift-respite.downtimeLedger.closeCampLogistics"}}{{else}}{{{logisticsTooltip}}}{{/if}}">
            <i class="fas fa-sliders"></i> {{localize "ionrift-respite.downtimeLedger.logistics"}}
        </button>

        {{> encounterDcStepper dc=dangerDC adjustAction="adjustDraftDC" tooltip=(localize "ionrift-respite.downtimeLedger.encounterDcTooltip")}}
        {{/if}}

        <span class="rest-footer-ready" data-tooltip="{{partyReadiness.unreadyTooltip}}">
            <i class="fas fa-hourglass-half"></i>
            {{localize "ionrift-respite.downtimeLedger.readyCountTally" ready=(concat partyReadiness.readyCount "") total=(concat partyReadiness.totalCount "")}}
        </span>

        {{#if partyReadiness.isAllComplete}}
            {{#if isWilderness}}
            <button type="button" class="rest-footer-proceed" data-action="proceedToResolutionFlow" data-tooltip="{{localize "ionrift-respite.downtimeLedger.advanceToNightlyWatchesTooltip"}}">
                <i class="fas fa-play"></i> {{localize "ionrift-respite.downtimeLedger.proceedToTheNights"}}
            </button>
            {{else}}
            <button type="button" class="btn-primary-green" data-action="resolveDowntime" data-tooltip="{{localize "ionrift-respite.downtimeLedger.completeTheRestTooltip"}}">
                <i class="fas fa-check-double"></i> {{localize "ionrift-respite.downtimeLedger.completeRest"}}
            </button>
            {{/if}}
        {{else}}
        <button type="button" class="rest-footer-proceed" disabled data-tooltip="{{partyReadiness.unreadyTooltip}}">
            <i class="fas fa-play"></i> {{#if isWilderness}}{{localize "ionrift-respite.downtimeLedger.proceedToTheNights"}}{{else}}{{localize "ionrift-respite.downtimeLedger.completeRest"}}{{/if}}
        </button>
        {{/if}}

        {{else}}
        <span class="rest-footer-ready">
            <i class="fas fa-hourglass-half"></i>
            {{localize "ionrift-respite.downtimeLedger.readyCountTally" ready=(concat partyReadiness.readyCount "") total=(concat partyReadiness.totalCount "")}}
        </span>
        <span class="rest-footer-waiting">{{localize "ionrift-respite.downtimeLedger.waitingForTheGm"}}</span>
        {{/if}}
    </div>
    {{/if}}

</div>
