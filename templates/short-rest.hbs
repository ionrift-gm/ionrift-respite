{{!-- Short Rest: single-screen HD spending view --}}
<div class="short-rest-container">

    {{!-- Tier 1: Canonical Rest Header --}}
    {{> restHeader}}

    {{!-- Shared Terrain Artwork Banner --}}
    {{> terrainBanner}}

    {{!-- Camp status badges below the banner (consistent across all rest interfaces; open air is assumed) --}}
    {{#if (or shelterBadge songOfRest chefReplenishing)}}
    <div class="sr-camp-meta">
        <div class="camp-status-bar">
            {{#if shelterBadge}}
            <span class="camp-status-chip shelter-chip shelter-chip-{{shelterBadge.id}}" data-tooltip="{{shelterBadge.name}}">
                <i class="{{shelterBadge.icon}}"></i> {{shelterBadge.name}}
            </span>
            {{/if}}
            {{#if songOfRest}}
            <span class="camp-status-chip sr-song-chip" data-tooltip="Song of Rest: {{songOfRest.bardName}} rolls {{songOfRest.songDie}} extra healing for each character who spends at least one Hit Die. {{#if songOfRest.timingEnd}}Applied when the GM completes this rest.{{else}}Applied immediately with each character's first Hit Die.{{/if}}">
                <i class="fas fa-music"></i> {{songOfRest.bardName}} · {{songOfRest.songDie}} · {{#if songOfRest.timingEnd}}on complete (if you spend HD){{else}}on 1st HD{{/if}}
            </span>
            {{/if}}
            {{#if chefReplenishing}}
            <span class="camp-status-chip sr-chef-chip {{#if chefReplenishing.hasRemaining}}chef-glowing-badge{{else}}chef-exhausted-badge{{/if}}"
                  data-tooltip="Replenishing Meal: {{chefReplenishing.chefName}} is cooking (+1d8 HP on Hit Dice). {{chefReplenishing.mealsRemaining}} servings left.">
                <i class="fas fa-utensils"></i> {{chefReplenishing.chefName}} · +1d8 · {{chefReplenishing.mealsRemaining}} left
            </span>
            {{/if}}
        </div>
    </div>
    {{/if}}

    {{#if workbenchIdentifyUiEnabled}}
    <div class="sr-nav-row" role="tablist" aria-label="Short rest sections">
        <div class="rest-dock-segments">
            <button type="button" role="tab" class="rest-dock-seg {{#if (eq activeTab "recovery")}}active{{/if}}"
                data-action="switchShortRestTab" data-tab="recovery" {{#if (eq activeTab "recovery")}}aria-selected="true"{{else}}aria-selected="false"{{/if}}>
                <i class="fas fa-heart"></i> Recovery
            </button>
            <button type="button" role="tab" class="rest-dock-seg {{#if (eq activeTab "workbench")}}active{{/if}}"
                data-action="switchShortRestTab" data-tab="workbench" {{#if (eq activeTab "workbench")}}aria-selected="true"{{else}}aria-selected="false"{{/if}}>
                <i class="fas fa-search"></i> Identify
            </button>
        </div>
    </div>
    {{/if}}

    {{#if (eq activeTab "recovery")}}
    {{!-- Scrollable body: character cards --}}
    <div class="sr-scroll-body rest-camp-flow">
        {{#if isGmNeutralView}}
            {{> restGmPartyDeck}}
        {{else}}
            {{#if isGM}}
            <div class="sr-focused-nav">
                <button type="button" class="btn-party-overview" data-action="clearSelectedCharacter" data-tooltip="Return to party overview">
                    <i class="fas fa-arrow-left"></i> All Characters
                </button>
                <span class="sr-focused-title"><i class="fas fa-user-shield"></i> Managing <strong>{{heroCharacter.name}}</strong></span>
            </div>
            {{/if}}
            {{> restHeroCard}}
            {{> restCompanionDeck}}
        {{/if}}
    </div>
    {{else}}
    <div class="sr-scroll-body sr-workbench-body">
        {{#with workbenchEmbed}}
        {{> workbenchIdentifyPanel}}
        {{/with}}
    </div>
    {{/if}}

    {{!-- Sticky footer --}}
    <div class="sr-footer">
        <div class="sr-footer-row{{#if isGM}} is-gm{{/if}}">
            {{#unless isGM}}
            <button type="button" class="sr-finished-toggle {{#if shortRestFooter.myFinished}}active{{/if}}" data-action="toggleShortRestFinished">
                {{#if shortRestFooter.myFinished}}
                <i class="fas fa-undo"></i> Still resting
                {{else}}
                <i class="fas fa-flag-checkered"></i> I'm finished
                {{/if}}
            </button>
            {{/unless}}
            {{#if isGM}}
            {{> encounterDcStepper encounterDcStepper}}
            <div class="sr-footer-end">
            {{#if canCompleteShortRest}}
            <button type="button" class="btn-primary-green sr-complete-btn" data-action="completeShortRest">
                <i class="fas fa-check"></i> Complete Short Rest
            </button>
            {{else}}
            <button type="button" class="btn-primary-green sr-complete-btn" disabled data-tooltip="{{completeBlockedHint}}">
                <i class="fas fa-hourglass-half"></i> Complete Short Rest
            </button>
            {{/if}}
            </div>
            {{else}}
            <span class="sr-waiting sr-footer-end"><i class="fas fa-hourglass-half"></i> Waiting for GM...</span>
            {{/if}}
        </div>
    </div>
</div>
