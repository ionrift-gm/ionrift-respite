<section class="campfire-body">

    {{!-- Fire area: big, clickable, central focus --}}
    <div class="campfire-fire-area fire-level-{{fireLevel}}" data-action="pokeFire">
        <canvas class="campfire-physics-canvas"></canvas>

        {{#if lit}}
            <div class="campfire-flames">
                <div class="flame flame-core"></div>
                <div class="flame flame-mid"></div>
                <div class="flame flame-outer"></div>
                <div class="flame flame-wisp flame-wisp-1"></div>
                <div class="flame flame-wisp flame-wisp-2"></div>
                <div class="flame flame-ember-glow"></div>
            </div>
            <div class="campfire-coals"></div>
        {{else}}
            {{#if makeCampCeremony}}
            <div class="campfire-kindling campfire-preview-pit {{#if previewColdCamp}}campfire-preview-cold{{else}}campfire-preview-setup{{/if}}">
                <div class="campfire-preview-center">
                    {{#if previewColdCamp}}
                    <i class="fas fa-moon" aria-hidden="true"></i>
                    {{else}}
                    <i class="fas fa-campground" aria-hidden="true"></i>
                    {{/if}}
                </div>
                {{#if previewRequirementSlots.length}}
                <div class="campfire-preview-requirements-row" aria-label="{{localize "ionrift-respite.campfire.firewoodRequiredAria"}}">
                    {{#each previewRequirementSlots}}
                    {{#if filled}}
                    <button type="button"
                            class="campfire-preview-req-piece is-filled"
                            data-action="unstageCeremonyWood"
                            data-slot-id="{{id}}"
                            data-tooltip="{{tooltip}}"
                            {{#unless canReclaim}}disabled{{/unless}}>
                        <img class="campfire-preview-req-img is-filled-img" src="{{kindlingImg}}" alt="" draggable="false">
                        {{#if portrait}}
                        <img class="ceremony-slot-avatar" src="{{portrait}}" alt="{{actorName}}" draggable="false">
                        {{/if}}
                    </button>
                    {{else}}
                    <span class="campfire-preview-req-piece is-empty {{#if insufficient}}is-short{{/if}}"
                          data-tooltip="{{tooltip}}">
                        <img class="campfire-preview-req-img" src="{{kindlingImg}}" alt="" draggable="false">
                    </span>
                    {{/if}}
                    {{/each}}
                </div>
                {{/if}}
            </div>
            {{else}}
            <div class="campfire-kindling {{#if kindlingPlaced}}has-kindling{{/if}}{{#if coldCampActive}} cold-camp-pit{{/if}}">
                {{#if kindlingPlaced}}
                    <i class="fas fa-fire-alt"></i>
                    <span>{{localize "ionrift-respite.campfire.readyToLight"}}</span>
                {{else if coldCampActive}}
                    <i class="fas fa-moon" aria-hidden="true"></i>
                    <span>{{localize "ionrift-respite.fireLevel.coldCamp"}}</span>
                {{else}}
                    <i class="fas fa-campground"></i>
                    <span>{{localize "ionrift-respite.campfire.kindlingPile"}}</span>
                {{/if}}
            </div>
            {{/if}}
        {{/if}}

        {{!-- Lit banner (fades) --}}
        {{#if showLitBanner}}
            <div class="campfire-lit-banner">
                <i class="fas fa-fire"></i> {{{localize "ionrift-respite.campfire.litBanner" color=litByColor name=litBy}}}
            </div>
        {{/if}}
    </div>

    {{!-- Interaction strip --}}
    <div class="campfire-interactions">

        {{#unless lit}}
            {{#if makeCampCeremony}}
            {{#if previewColdCamp}}
            <div class="campfire-ceremony-action-area">
                <p class="ceremony-cold-hint guided-label">{{localize "ionrift-respite.campfire.coldPreviewHint"}}</p>
            </div>
            {{else}}
            {{#unless kindlingPlaced}}
            {{!-- Step 1: Drag kindling into requirement slots --}}
            <div class="campfire-ceremony-action-area">
                <div class="ceremony-primary-slot">
                {{#if firewoodCount}}
                <div class="campfire-ceremony-kindling-step">
                    <div class="ceremony-kindling-row">
                        <div class="firewood-log" draggable="true" data-tooltip="{{localize "ionrift-respite.campfire.dragKindlingToSlot"}}">
                            <img class="firewood-log-icon" src="{{kindlingDragImg}}" alt="" draggable="false">
                        </div>
                        <span class="ceremony-kindling-count">&times;{{firewoodCount}}</span>
                        <span class="guided-label">{{localize "ionrift-respite.campfire.dragKindlingProgress" staged=ceremonyWoodStaged required=ceremonyWoodRequired}}</span>
                    </div>
                </div>
                {{else}}
                <div class="campfire-ceremony-kindling-step dimmed ceremony-no-wood-step">
                    <span class="ceremony-no-wood-label"><i class="fas fa-fire" aria-hidden="true"></i> {{localize "ionrift-respite.campfire.noFirewoodInInventory"}}</span>
                </div>
                {{/if}}
                </div>
                {{#if showGiftKindlingBtn}}
                <button type="button" class="campfire-btn ceremony-gift-wood-btn" data-action="giftCeremonyWood"
                        data-tooltip="{{{localize "ionrift-respite.campfire.giftWoodTooltip" name=giftKindlingTargetName}}}">
                    <i class="fas fa-gift" aria-hidden="true"></i> {{localize "ionrift-respite.campfire.giftWood"}}
                </button>
                {{/if}}
            </div>
            {{else}}
            {{!-- Step 2: strike flint and/or cantrip (committed row layout) --}}
            <div class="campfire-ceremony-action-area">
                {{#if ceremonyIgniteBlocked}}
                <p class="campfire-preview-shortfall-hint">{{ceremonyIgniteBlockReason}}</p>
                {{/if}}
                <div class="ceremony-primary-slot">
                <div class="campfire-ceremony-strike-row">
                    <div class="ceremony-row-left">
                        {{#if firewoodCount}}
                        <div class="firewood-log" draggable="true" data-tooltip="{{localize "ionrift-respite.campfire.dragMoreKindling"}}">
                            <img class="firewood-log-icon" src="{{kindlingDragImg}}" alt="" draggable="false">
                        </div>
                        <span class="ceremony-kindling-count">&times;{{firewoodCount}}</span>
                        {{else}}
                        <span class="ceremony-no-kindling guided-label">{{localize "ionrift-respite.campfire.noWoodLeft"}}</span>
                        {{/if}}
                    </div>
                    <div class="ceremony-row-center">
                        {{#if hasTinderbox}}
                        <span class="strike-hint">{{localize "ionrift-respite.campfire.strikeAttempt" count=strikeCount}}</span>
                        {{else}}
                        {{#unless hasFireCantrip}}
                        <span class="guided-label ceremony-no-lighter" data-tooltip="{{localize "ionrift-respite.campfire.noLighterTooltip"}}">{{localize "ionrift-respite.campfire.noTinderbox"}}</span>
                        {{/unless}}
                        {{/if}}
                    </div>
                    <div class="ceremony-row-right">
                        {{#if hasFireCantrip}}
                        {{#if ceremonyIgniteBlocked}}
                        <span class="campfire-btn-tooltip-wrap" data-tooltip="{{ceremonyIgniteBlockReason}}">
                            <button type="button" data-action="cantripIgnite" class="campfire-btn strike-btn cantrip-btn" disabled aria-disabled="true" tabindex="-1">
                                <i class="fas fa-hat-wizard"></i> {{fireCantrip}}
                            </button>
                        </span>
                        {{else}}
                        <button type="button" data-action="cantripIgnite" class="campfire-btn strike-btn cantrip-btn">
                            <i class="fas fa-hat-wizard"></i> {{fireCantrip}}
                        </button>
                        {{/if}}
                        {{/if}}
                        {{#if hasTinderbox}}
                        {{#if ceremonyIgniteBlocked}}
                        <span class="campfire-btn-tooltip-wrap" data-tooltip="{{ceremonyIgniteBlockReason}}">
                            <button type="button" data-action="strikeFlint" class="campfire-btn strike-btn" disabled aria-disabled="true" tabindex="-1">
                                <i class="fas fa-hand-sparkles"></i> {{localize "ionrift-respite.campfire.strikeFlint"}}
                            </button>
                        </span>
                        {{else}}
                        <button type="button" data-action="strikeFlint" class="campfire-btn strike-btn">
                            <i class="fas fa-hand-sparkles"></i> {{localize "ionrift-respite.campfire.strikeFlint"}}
                        </button>
                        {{/if}}
                        {{/if}}
                    </div>
                </div>
                </div>
                {{#if showGiftKindlingBtn}}
                <button type="button" class="campfire-btn ceremony-gift-wood-btn" data-action="giftCeremonyWood"
                        data-tooltip="{{{localize "ionrift-respite.campfire.giftWoodTooltip" name=giftKindlingTargetName}}}">
                    <i class="fas fa-gift" aria-hidden="true"></i> {{localize "ionrift-respite.campfire.giftWood"}}
                </button>
                {{/if}}
            </div>
            {{/unless}}
            {{#if previewFirewoodShortfall}}
            <p class="campfire-preview-shortfall-hint">{{localize "ionrift-respite.campfire.firewoodShortfall"}}</p>
            {{/if}}
            {{/if}}
            {{/if}}
        {{else}}
            {{!-- Lit: compact vertical stack --}}

            {{!-- Firewood + Emotes: combined row --}}
            <div class="campfire-tool-row combined-row">
                {{#if firewoodCount}}
                    <div class="firewood-log" draggable="true" data-tooltip="{{localize "ionrift-respite.campfire.dragKindlingToFire"}}">
                        <img class="firewood-log-icon" src="{{kindlingDragImg}}" alt="" draggable="false">
                    </div>
                    <span class="firewood-count">&times;{{firewoodCount}}</span>
                {{else}}
                    <span class="firewood-empty"><i class="fas fa-fire"></i> {{localize "ionrift-respite.campfire.noWood"}}</span>
                {{/if}}
                <span class="tool-row-sep"></span>
                {{#each emotes}}
                    <button type="button" class="emote-btn" data-action="emote" data-emote-id="{{this.id}}" data-tooltip="{{this.label}}">
                        <i class="{{this.icon}}"></i>
                    </button>
                {{/each}}
            </div>

            {{!-- Whittle: separate activity --}}
            <div class="whittle-area"></div>
            <div class="campfire-tool-row">
                <button type="button" data-action="whittle" class="campfire-btn whittle-btn compact">
                    <i class="fas fa-knife"></i> {{localize "ionrift-respite.campfire.whittleBtn"}}
                </button>
                <div class="whittle-progress-bar">
                    <div class="whittle-progress-fill" style="width: {{whittlePct}}%"></div>
                </div>
            </div>
            <div class="whittle-tray"></div>
        {{/unless}}
    </div>

    {{!-- Heat meter only while the fire is burning. Cold camp uses the tier strip. --}}
    {{#if showFireMeter}}
    <div class="fire-meter is-live">
        <div class="fire-meter-track">
            <div class="fire-meter-fill"></div>
            <div class="fire-meter-needle"></div>
            {{#unless makeCampCeremony}}
            <div class="fire-meter-zone zone-cold-camp{{#if (eq meterLevel "cold_camp")}} is-active{{/if}}" data-zone="cold_camp" data-tooltip="{{localize "ionrift-respite.campfire.meter.coldTooltip"}}">{{localize "ionrift-respite.campfire.meter.cold"}}</div>
            {{/unless}}
            <div class="fire-meter-zone zone-embers{{#if (eq meterLevel "embers")}} is-active{{/if}}" data-zone="embers" data-tooltip="{{localize "ionrift-respite.campfire.meter.embersTooltip"}}">{{localize "ionrift-respite.fireLevel.embers"}}</div>
            <div class="fire-meter-zone zone-campfire{{#if (eq meterLevel "campfire")}} is-active{{/if}}" data-zone="campfire" data-tooltip="{{localize "ionrift-respite.campfire.meter.campfireTooltip"}}">{{localize "ionrift-respite.fireLevel.campfire"}}</div>
            <div class="fire-meter-zone zone-bonfire{{#if (eq meterLevel "bonfire")}} is-active{{/if}}" data-zone="bonfire" data-tooltip="{{localize "ionrift-respite.campfire.meter.bonfireTooltip"}}">{{localize "ionrift-respite.fireLevel.bonfire"}}</div>
        </div>
    </div>
    {{#if showDouseBtn}}
    <div class="campfire-tool-row campfire-douse-row">
        <button type="button" data-action="douseFire" class="campfire-btn douse-btn"
                data-tooltip="{{localize "ionrift-respite.campfire.douseTooltip"}}">
            <i class="fas fa-shoe-prints" aria-hidden="true"></i>
            <span class="douse-btn-label">{{localize "ionrift-respite.campfire.douse"}}</span>
        </button>
    </div>
    {{/if}}
    {{/if}}
</section>
