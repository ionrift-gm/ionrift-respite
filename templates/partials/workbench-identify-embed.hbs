{{!-- Refactored Workbench Examine: Top Utility Bar + 3-Bay Symmetrical Triage + Dynamic Action Footer --}}
<div class="station-workbench-identify-embed station-identify-embed identify-tab{{#if workbenchSubmitPending}} wb-ident-submit-pending{{/if}}"
     data-workbench-actor-id="{{workbenchIdentifyActorId}}">

    {{!-- Top Utility Bar: Header Info / Caster Hint + Detect Magic Reconnaissance Ping --}}
    <div class="wb-ident-utility-bar">
        <div class="wb-ident-utility-meta">
            {{#if isPf2eWorkbench}}
            <span class="wb-ident-recon-hint">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <span>Select a trained tradition skill or Crafting (with an Alchemist's Toolkit), then drag an item from your inventory to examine it.</span>
            </span>
            {{else}}
            {{#if identifyCasters.length}}
            <span class="wb-ident-caster-hint" data-tooltip="{{localize "ionrift-respite.workbenchIdentify.availableCasters"}} {{#each identifyCasters}}{{#unless @first}}, {{/unless}}{{name}}{{/each}}">
                <i class="fas fa-hat-wizard" aria-hidden="true"></i>
                <span class="wb-ident-caster-text">{{#each identifyCasters}}{{#unless @first}}, {{/unless}}{{name}}{{/each}} {{localize "ionrift-respite.workbenchIdentify.canCastIdentify"}}</span>
            </span>
            {{else}}
            <span class="wb-ident-recon-hint">
                <i class="fas fa-sparkles" aria-hidden="true"></i>
                <span>{{{localize "ionrift-respite.workbenchIdentify.reconHint"}}}</span>
            </span>
            {{/if}}
            {{/if}}
        </div>
        <div class="wb-ident-utility-recon{{#unless detectMagicAvailable}}{{#unless magicScanActive}} wb-ident-zone-lacking{{#if (eq detectMagicAccess.state "unprepared")}} wb-ident-zone-unprepared{{else}} wb-ident-zone-unavailable{{/if}}{{/unless}}{{/unless}}">
            <button type="button" class="btn-detect-magic btn-detect-magic-toggle{{#if magicScanActive}} is-active{{/if}}"
                data-action="stationDetectMagicScan"
                {{#unless canTriggerDetectMagicScan}}disabled{{/unless}}
                {{#if workbenchSubmitPending}}disabled aria-disabled="true"{{/if}}
                data-tooltip="{{#if workbenchSubmitPending}}{{localize "ionrift-respite.workbenchIdentify.waitSubmit"}}{{else}}{{#if magicScanActive}}{{localize "ionrift-respite.workbenchIdentify.dismissScan"}}{{else}}{{#if canTriggerDetectMagicScan}}{{#if isGmUser}}{{localize "ionrift-respite.workbenchIdentify.castDetectMagicGm"}}{{else}}{{localize "ionrift-respite.workbenchIdentify.castDetectMagic"}}{{/if}}{{else}}{{detectMagicDisabledTooltip}}{{/if}}{{/if}}{{/if}}">
                <i class="fas {{#if magicScanActive}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i>
                <span class="btn-detect-magic-text">{{#if magicScanActive}}{{localize "ionrift-respite.workbenchIdentify.dismiss"}}{{else}}{{localize "ionrift-respite.workbenchIdentify.detectMagic"}}{{/if}}</span>
                {{#if detectMagicPill}}
                {{#unless magicScanActive}}
                <span class="wb-ident-pill {{#if (eq detectMagicPill "Not prepared")}}wb-ident-pill--unprepared{{else}}wb-ident-pill--spell{{/if}}">{{detectMagicPill}}</span>
                {{/unless}}
                {{/if}}
            </button>
        </div>
    </div>

    <div class="identify-scroll-area station-identify-scroll wb-ident-scroll">
    {{#if workbenchSubmitPending}}
    <p class="wb-ident-pending-status" role="status" aria-live="polite">
        <i class="fas fa-spinner fa-spin" aria-hidden="true"></i> {{localize "ionrift-respite.workbenchIdentify.workingWaiting"}}
    </p>
    {{/if}}

    {{#if isPf2eWorkbench}}
    <div class="wb-pf2e-examine-panel">
        <div class="wb-pf2e-skill-chips" role="group" aria-label="Identification Skill">
            {{#each pf2eSkillChips}}
            <button type="button"
                class="wb-pf2e-skill-chip{{#if selected}} is-selected{{/if}}{{#if disabled}} is-disabled{{/if}}"
                data-wb-pf2e-skill="{{slug}}"
                data-skill-label="{{label}}"
                {{#if disabled}}data-disabled="true" data-status-reason="{{statusReason}}"{{/if}}
                data-tooltip="{{tooltip}}">
                <span class="wb-pf2e-skill-name">{{label}}</span>
                <span class="wb-pf2e-skill-meta">{{#if ready}}{{rankLabel}} · {{modLabel}}{{else}}{{statusReason}}{{/if}}</span>
            </button>
            {{/each}}
        </div>

        <div class="meal-panel wb-ident-card wb-ident-card--focus wb-ident-card--pf2e{{#unless pf2eCanIdentify}} wb-ident-zone-lacking wb-ident-zone-unavailable{{/unless}}">
            <div class="wb-ident-card-head">
                <span class="panel-label wb-ident-card-title">
                    {{#if pf2eActiveSkill}}{{pf2eActiveSkill.disciplineLabel}} · {{pf2eActiveSkill.label}}{{else}}Camp Item Examination{{/if}}
                    <span class="wb-ident-pill">Secret · 10m</span>
                </span>
                <button type="button" class="wb-pf2e-inventory-btn" data-wb-open-inventory data-tooltip="Open your character inventory to drag an item here">
                    <i class="fas fa-suitcase" aria-hidden="true"></i> Inventory
                </button>
            </div>
            <div class="wb-ident-well-wrap">
                <div class="meal-drop-zone wb-ident-drop-zone gear-focus-drop-zone {{#if workbenchGearChip}}filled{{/if}}{{#unless pf2eCanIdentify}} wb-ident-zone-blocked{{/unless}}"
                    data-wb-zone="gear"
                    data-tooltip="{{#if pf2eActiveSkill}}{{pf2eActiveSkill.tooltip}}{{else}}Requires Trained proficiency in Arcana, Nature, Occultism, Religion, or Crafting (with an Alchemist's Toolkit).{{/if}}">
                    <div class="drop-zone-silhouette">
                        {{#if workbenchGearChip}}
                        <img src="{{workbenchGearChip.img}}" alt="" class="drop-zone-item-icon" onerror="this.onerror=null;this.src='icons/svg/mystery-man.svg'">
                        <span class="drop-zone-clear-badge" title="{{localize "ionrift-respite.workbenchIdentify.removeItem"}}"><i class="fas fa-times"></i></span>
                        {{else}}
                        <i class="fas fa-hand-sparkles drop-zone-sil drop-zone-gear-sil"></i>
                        {{/if}}
                    </div>
                </div>
            </div>
            <div class="wb-ident-card-meta">
                {{#if workbenchGearChip}}
                <span class="wb-ident-staged-name" title="{{workbenchGearChip.name}}">{{workbenchGearChip.name}}</span>
                <span class="wb-ident-staged-hint">{{localize "ionrift-respite.workbenchIdentify.clickToClear"}}</span>
                {{else}}
                <span class="wb-ident-method-tag">{{#if pf2eActiveSkill}}{{pf2eActiveSkill.disciplineLabel}}{{else}}Trained Skill Required{{/if}}</span>
                <span class="wb-ident-method-desc">Drag any item from your Inventory here to nominate it for examination.</span>
                {{/if}}
            </div>
        </div>
    </div>
    {{else}}
    {{!-- Main Triage Bay: 3 Symmetrical Cards --}}
    <div class="wb-ident-triage-grid">

        {{!-- CARD 1: IDENTIFY (SPELL) --}}
        <div class="meal-panel wb-ident-card wb-ident-card--arcane{{#unless identifyAvailable}} wb-ident-zone-lacking{{#if (eq identifyAccess.state "unprepared")}} wb-ident-zone-unprepared{{else}} wb-ident-zone-unavailable{{/if}}{{/unless}}">
            <div class="wb-ident-card-head">
                <span class="panel-label wb-ident-card-title">{{localize "ionrift-respite.workbenchIdentify.identify"}}
                    {{#if identifyPill}}
                    <span class="wb-ident-pill {{#if (eq identifyPill "Not prepared")}}wb-ident-pill--unprepared{{else}}wb-ident-pill--spell{{/if}}">{{identifyPill}}</span>
                    {{/if}}
                </span>
                <span class="wb-ident-col-tip" tabindex="0" data-tooltip-direction="DOWN"
                    data-tooltip="{{#if arcaneStatus}}{{arcaneStatus}}{{else}}{{localize "ionrift-respite.workbenchIdentify.spellsRevealMore"}}{{/if}}"
                    aria-label="{{#if arcaneStatus}}{{arcaneStatus}}{{else}}{{localize "ionrift-respite.workbenchIdentify.spellsRevealMore"}}{{/if}}"><i class="fas fa-info-circle" aria-hidden="true"></i></span>
            </div>
            <div class="wb-ident-well-wrap">
                <div class="meal-drop-zone wb-ident-drop-zone spell-identify-drop-zone {{#if workbenchSpellChip}}filled{{/if}}{{#unless identifyAvailable}} wb-ident-zone-blocked{{/unless}}"
                     data-wb-zone="spell"
                     data-tooltip="{{#if identifyAvailable}}{{localize "ionrift-respite.workbenchIdentify.dropToIdentify"}}{{else}}{{identifyAccess.tooltip}}{{/if}}">
                    <div class="drop-zone-silhouette">
                        {{#if workbenchSpellChip}}
                        <img src="{{workbenchSpellChip.img}}" alt="" class="drop-zone-item-icon" onerror="this.onerror=null;this.src='icons/svg/mystery-man.svg'">
                        <span class="drop-zone-clear-badge" title="{{localize "ionrift-respite.workbenchIdentify.removeItem"}}"><i class="fas fa-times"></i></span>
                        {{else}}
                        <i class="fas fa-hat-wizard drop-zone-sil drop-zone-spell-sil"></i>
                        {{/if}}
                    </div>
                </div>
            </div>
            <div class="wb-ident-card-meta">
                {{#if workbenchSpellChip}}
                <span class="wb-ident-staged-name" title="{{workbenchSpellChip.name}}">{{workbenchSpellChip.name}}</span>
                <span class="wb-ident-staged-hint">{{localize "ionrift-respite.workbenchIdentify.clickToClear"}}</span>
                {{else}}
                <span class="wb-ident-method-tag">{{localize "ionrift-respite.workbenchIdentify.firstLevelRitual"}}</span>
                <span class="wb-ident-method-desc">{{localize "ionrift-respite.workbenchIdentify.revealsAll"}}</span>
                {{/if}}
            </div>
        </div>

        {{!-- CARD 2: FOCUS (SHORT REST) --}}
        <div class="meal-panel wb-ident-card wb-ident-card--focus{{#if workbenchFocusExhausted}} wb-ident-exhausted{{/if}}">
            <div class="wb-ident-card-head">
                <span class="panel-label wb-ident-card-title">{{localize "ionrift-respite.workbenchIdentify.focus"}}
                    {{#if focusBudgetLabel}}
                    <span class="wb-ident-pill">{{focusBudgetLabel}}</span>
                    {{else if workbenchFocusExhausted}}
                    <span class="wb-ident-used-badge">{{localize "ionrift-respite.workbenchIdentify.used"}}</span>
                    {{/if}}
                </span>
                <span class="wb-ident-col-tip" tabindex="0" data-tooltip-direction="DOWN"
                    data-tooltip="{{#if restCiteText}}{{restCiteText}}{{else}}{{localize "ionrift-respite.workbenchIdentify.focusOncePerRest"}}{{/if}}"
                    aria-label="{{#if restCiteText}}{{restCiteText}}{{else}}{{localize "ionrift-respite.workbenchIdentify.focusOncePerRest"}}{{/if}}"><i class="fas fa-info-circle" aria-hidden="true"></i></span>
            </div>
            <div class="wb-ident-well-wrap">
                <div class="meal-drop-zone wb-ident-drop-zone gear-focus-drop-zone {{#if workbenchGearChip}}filled{{/if}}{{#if workbenchFocusExhausted}} wb-ident-zone-blocked{{/if}}"
                    data-wb-zone="gear"
                    data-tooltip="{{#if workbenchFocusExhausted}}{{localize "ionrift-respite.workbenchIdentify.focusLimitReached"}}{{else if focusTooltip}}{{focusTooltip}}{{else}}{{localize "ionrift-respite.workbenchIdentify.focusTooltipDefault"}}{{/if}}">
                    <div class="drop-zone-silhouette">
                        {{#if workbenchGearChip}}
                        <img src="{{workbenchGearChip.img}}" alt="" class="drop-zone-item-icon" onerror="this.onerror=null;this.src='icons/svg/mystery-man.svg'">
                        <span class="drop-zone-clear-badge" title="{{localize "ionrift-respite.workbenchIdentify.removeItem"}}"><i class="fas fa-times"></i></span>
                        {{else}}
                        <i class="fas fa-hand-holding drop-zone-sil drop-zone-gear-sil"></i>
                        {{/if}}
                    </div>
                </div>
            </div>
            <div class="wb-ident-card-meta">
                {{#if workbenchGearChip}}
                <span class="wb-ident-staged-name" title="{{workbenchGearChip.name}}">{{workbenchGearChip.name}}</span>
                <span class="wb-ident-staged-hint">{{localize "ionrift-respite.workbenchIdentify.clickToClear"}}</span>
                {{else}}
                <span class="wb-ident-method-tag">{{localize "ionrift-respite.workbenchIdentify.onePerShortRest"}}</span>
                <span class="wb-ident-method-desc">{{localize "ionrift-respite.workbenchIdentify.studyOneHour"}}</span>
                {{/if}}
            </div>
        </div>

        {{!-- CARD 3: TASTE (POTION) --}}
        <div class="meal-panel wb-ident-card wb-ident-card--taste">
            <div class="wb-ident-card-head">
                <span class="panel-label wb-ident-card-title">{{localize "ionrift-respite.workbenchIdentify.taste"}}</span>
                <span class="wb-ident-col-tip" tabindex="0" data-tooltip-direction="DOWN"
                    data-tooltip="{{localize "ionrift-respite.workbenchIdentify.potionsCite"}}"
                    aria-label="{{localize "ionrift-respite.workbenchIdentify.potionsCite"}}"><i class="fas fa-info-circle" aria-hidden="true"></i></span>
            </div>
            <div class="wb-ident-well-wrap">
                <div class="meal-drop-zone wb-ident-drop-zone potion-taste-drop-zone {{#if workbenchPotionChip}}filled{{/if}}"
                     data-wb-zone="potion" data-tooltip="{{localize "ionrift-respite.workbenchIdentify.potionsTasteTooltip"}}">
                    <div class="drop-zone-silhouette">
                        {{#if workbenchPotionChip}}
                        <img src="{{workbenchPotionChip.img}}" alt="" class="drop-zone-item-icon" onerror="this.onerror=null;this.src='icons/svg/mystery-man.svg'">
                        <span class="drop-zone-clear-badge" title="{{localize "ionrift-respite.workbenchIdentify.removeItem"}}"><i class="fas fa-times"></i></span>
                        {{else}}
                        <i class="fas fa-flask drop-zone-sil drop-zone-potion-sil"></i>
                        {{/if}}
                    </div>
                </div>
            </div>
            <div class="wb-ident-card-meta">
                {{#if workbenchPotionChip}}
                <span class="wb-ident-staged-name" title="{{workbenchPotionChip.name}}">{{workbenchPotionChip.name}}</span>
                <span class="wb-ident-staged-hint">{{localize "ionrift-respite.workbenchIdentify.clickToClear"}}</span>
                {{else}}
                <span class="wb-ident-method-tag">{{localize "ionrift-respite.workbenchIdentify.repeatable"}}</span>
                <span class="wb-ident-method-desc">{{localize "ionrift-respite.workbenchIdentify.sipReveals"}}</span>
                {{/if}}
            </div>
        </div>

    </div>
    {{/if}}

    {{!-- Tabletop Dynamic Commit Action --}}
    <div class="station-meal-submit-row wb-ident-submit-row">
        <button type="button" class="station-meal-submit-btn btn-examine-commit{{#if workbenchSubmitPending}} wb-ident-submit-btn--pending is-pending{{/if}}" data-action="submitWorkbenchIdentify"
            data-workbench-actor-id="{{workbenchIdentifyActorId}}"
            {{#if workbenchSubmitLocked}}disabled{{/if}}
            {{#if workbenchSubmitPending}}aria-busy="true" data-tooltip="{{localize "ionrift-respite.workbenchIdentify.inProgress"}}"{{/if}}>
            {{#if workbenchSubmitPending}}
            <i class="fas fa-spinner fa-spin" aria-hidden="true"></i> {{localize "ionrift-respite.workbenchIdentify.examiningItems"}}
            {{else if workbenchSubmitLocked}}
            <i class="fas fa-arrow-up-from-bracket" aria-hidden="true"></i> {{localize "ionrift-respite.workbenchIdentify.placeItemAbove"}}
            {{else}}
            <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i> {{localize "ionrift-respite.workbenchIdentify.performExamination"}}
            {{/if}}
        </button>
    </div>
    </div>

    {{#if workbenchIdentifyAcknowledgement}}
    <div class="wb-ident-ack-overlay" role="dialog" aria-modal="true">
        <div class="wb-ident-ack-card wb-ident-ack-fx">
            <div class="wb-ident-ack-title" id="wb-ident-ack-heading"><i class="fas fa-scroll"></i> {{#if workbenchIdentifyAcknowledgement.title}}{{workbenchIdentifyAcknowledgement.title}}{{else}}{{localize "ionrift-respite.workbenchIdentify.revelation"}}{{/if}}</div>
            <p class="wb-ident-ack-lead">{{#if workbenchIdentifyAcknowledgement.lead}}{{workbenchIdentifyAcknowledgement.lead}}{{else}}{{localize "ionrift-respite.workbenchIdentify.namesAndProperties"}}{{/if}}</p>
            {{#each workbenchIdentifyAcknowledgement.items}}
            <div class="wb-ident-ack-row">
                <img src="{{img}}" alt="" class="wb-ident-ack-img" onerror="this.onerror=null;this.src='icons/svg/mystery-man.svg'">
                <div class="wb-ident-ack-meta">
                    <span class="wb-ident-ack-name">{{name}}</span>
                    {{#if requiresAttunement}}<span class="magic-attune-hint">{{localize "ionrift-respite.workbenchIdentify.requiresAttunement"}}</span>{{/if}}
                </div>
            </div>
            {{/each}}
            <button type="button" class="station-meal-submit-btn wb-ident-ack-btn" data-action="dismissWorkbenchIdentifyAck"
                data-workbench-actor-id="{{workbenchIdentifyActorId}}"
                {{#unless workbenchAckRevealReady}} disabled data-tooltip="{{localize "ionrift-respite.workbenchIdentify.briefPause"}}"{{/unless}}>
                {{#if workbenchAckRevealReady}}{{localize "ionrift-respite.workbenchIdentify.done"}}{{else}}{{localize "ionrift-respite.workbenchIdentify.wait"}}{{/if}}
            </button>
        </div>
    </div>
    {{/if}}
</div>
