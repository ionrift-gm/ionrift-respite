{{!-- Normal rest Examine: the usual workbench (Identify, Focus, Taste) + Ready + fire rail. --}}
<div class="rest-sustenance-with-fire">
    <div class="rest-sustenance-main">
        <div class="sust-section-label">{{localize "ionrift-respite.restExamineWithFire.label"}}</div>
        {{#if workbenchIdentifyUiEnabled}}
        {{> workbenchIdentifyPanel}}
        {{else}}
        <div class="rest-night-card sel">
            <span class="rest-night-main">
                <strong>{{localize "ionrift-respite.restExamineWithFire.offTitle"}}</strong>
                <span>{{localize "ionrift-respite.restExamineWithFire.offHint"}}</span>
            </span>
        </div>
        {{/if}}
    </div>
    {{> restFireRail}}
</div>
