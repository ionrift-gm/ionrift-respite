{{!-- Shared Terrain Banner (120px) across Normal & Gritty Rest UIs --}}
{{#unless hideTerrainBanner}}
<div class="phase-banner rest-terrain-banner {{#if bannerFireClass}}{{bannerFireClass}}{{else}}is-fire-lit{{/if}}">
    <img src="{{#if terrainBanner}}{{terrainBanner}}{{else}}{{banner}}{{/if}}" alt="Camp terrain banner" style="object-position: {{#if terrainBannerPos}}{{terrainBannerPos}}{{else}}center{{/if}};" onerror="this.onerror=null;this.src='{{#if terrainBannerFallback}}{{terrainBannerFallback}}{{else}}{{bannerFallback}}{{/if}}'">
</div>
{{/unless}}
