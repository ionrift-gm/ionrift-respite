{{!-- Shared Short Rest Hero Character Card Partial --}}
{{#if heroCharacter}}
{{#with heroCharacter}}
<div class="rest-hero-card short-rest-card bivouac-char-card bivouac-hero-card ionrift-card-glass {{#if isAfk}}is-afk{{/if}} {{#if isStarving}}starving-card{{/if}} {{#if isSelfCard}}is-self-card{{/if}} {{#if isReady}}is-ready{{/if}}" data-actor-id="{{id}}">
    {{!-- Card Header: Monogram badge + identity on left, sustenance/treat slots on right --}}
    <div class="rest-card-header sr-card-header bivouac-card-header">
        <div class="rest-identity-left sr-identity-left bivouac-identity-left">
            <div class="companion-avatar-wrap hero-avatar-wrap">
                <div class="monogram-badge" style="border-color: {{themeBorder}};" data-tooltip="{{name}} ({{subtext}})">
                    <img class="monogram-portrait" src="{{#if img}}{{img}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="">
                </div>
                {{#if isReady}}
                <span class="hero-avatar-pip pip-ready" data-tooltip="{{localize "ionrift-respite.restHeroCard.finishedRestingTooltip"}}"><i class="fas fa-check"></i></span>
                {{/if}}
            </div>
            <div class="rest-identity-info sr-identity-info bivouac-identity-info">
                <div class="rest-name-row sr-name-row bivouac-name-row">
                    <span class="rest-char-name sr-name bivouac-char-name">{{name}}</span>
                    {{#if isSelfCard}}<span class="badge-you">{{localize "ionrift-respite.restHeroCard.you"}}</span>{{/if}}
                    {{#if isReady}}<span class="badge-ready"><i class="fas fa-check"></i> {{localize "ionrift-respite.restHeroCard.ready"}}</span>{{/if}}
                </div>
                <span class="rest-subtext sr-subtext bivouac-subtext">{{subtext}}</span>
            </div>
        </div>

        <div class="rest-header-right-slots">
            {{!-- Header slot: Gritty Bivouac sustenance chips --}}
            {{#if hasSustenanceSlot}}
            <div class="bivouac-sustenance-slot rest-header-slot">
                {{#if isChefFed}}
                <button type="button" class="sustenance-chip chef" data-action="swapPlateFood" data-actor-id="{{id}}"
                    {{#unless canInteract}}disabled{{/unless}} data-tooltip="{{localize "ionrift-respite.restHeroCard.chefMealTooltip"}}">
                    <i class="fas fa-utensils"></i> {{{localize "ionrift-respite.restHeroCard.chefsMeal"}}}
                </button>
                {{else if isOutlanderShielded}}
                <span class="sustenance-chip shielded" data-tooltip="{{#if foragerName}}{{{localize "ionrift-respite.restHeroCard.outlanderForagerTooltip" name=foragerName}}}{{else}}{{localize "ionrift-respite.restHeroCard.outlanderDefaultTooltip"}}{{/if}}">
                    <i class="fas fa-leaf"></i> {{localize "ionrift-respite.restHeroCard.wildForage"}}
                </span>
                {{else if platedItem}}
                <button type="button" class="sustenance-chip food" data-action="swapPlateFood" data-actor-id="{{id}}"
                    {{#unless canInteract}}disabled{{/unless}} data-tooltip="{{localize "ionrift-respite.restHeroCard.personalProvisionsTooltip" name=platedItem.name}}">
                    <i class="fas fa-drumstick-bite"></i> {{platedItem.name}}
                </button>
                {{else}}
                <button type="button" class="sustenance-chip starving" data-action="swapPlateFood" data-actor-id="{{id}}"
                    {{#unless canInteract}}disabled{{/unless}} data-tooltip="{{localize "ionrift-respite.restHeroCard.starvingTooltip"}}">
                    <i class="fas fa-triangle-exclamation"></i> {{localize "ionrift-respite.restHeroCard.starving"}}
                </button>
                {{/if}}

                {{#if waterPlate.isShielded}}
                <span class="sustenance-chip water-shielded" data-tooltip="{{waterPlate.tooltip}}">
                    <i class="fas fa-droplet"></i> {{localize "ionrift-respite.restHeroCard.freshWater"}}
                </span>
                {{else if waterPlate.isDehydrated}}
                <button type="button" class="sustenance-chip dehydrated" data-action="swapPlateWater" data-actor-id="{{id}}"
                    {{#unless waterPlate.canInteract}}disabled{{/unless}} data-tooltip="{{waterPlate.tooltip}}">
                    <i class="fas fa-droplet-slash"></i> {{localize "ionrift-respite.restHeroCard.dehydrated"}}
                </button>
                {{else if waterPlate}}
                <button type="button" class="sustenance-chip water" data-action="swapPlateWater" data-actor-id="{{id}}"
                    {{#unless waterPlate.canInteract}}disabled{{/unless}} data-tooltip="{{waterPlate.tooltip}}">
                    <i class="fas fa-droplet"></i> {{waterPlate.label}}
                </button>
                {{/if}}
            </div>
            {{/if}}

            {{!-- Chef Treat Slot --}}
            {{#if (or hasClaimedChefTreat canClaimChefTreat)}}
            <div class="sr-treat-slot rest-header-slot">
                {{#if hasClaimedChefTreat}}
                <span class="sr-treat-claimed-pill" data-tooltip="{{{localize "ionrift-respite.restHeroCard.chefTreatClaimedTooltip"}}}">
                    <i class="fas fa-cookie-bite"></i> {{{localize "ionrift-respite.restHeroCard.chefTreatHd"}}}
                </span>
                {{else if canClaimChefTreat}}
                <button type="button" class="sr-take-treat-btn" data-action="claimChefTreat" data-actor-id="{{id}}" data-tooltip="{{{localize "ionrift-respite.restHeroCard.takeChefTreatTooltip"}}}">
                    <i class="fas fa-cookie-bite"></i> {{localize "ionrift-respite.restHeroCard.takeTreat" count=(concat chefMealsRemaining "")}}
                </button>
                {{/if}}
            </div>
            {{/if}}
        </div>
    </div>

    {{!-- HP Section: separated text labels above slim progress bar --}}
    <div class="hp-container">
        <div class="hp-labels">
            <span class="label-green"><i class="fas fa-heart"></i> {{localize "ionrift-respite.restHeroCard.hitPoints"}}</span>
            <span class="hp-val {{#if isFullHp}}full-hp{{/if}}">{{hpValue}} / {{hpMax}} HP{{#if isFullHp}} ({{localize "ionrift-respite.restHeroCard.full"}}){{/if}}</span>
        </div>
        <div class="hp-bar-track">
            <div class="hp-bar-fill" style="width: {{hpPercent}}%;"></div>
        </div>
    </div>

    {{!-- Hit Dice Well: recessed panel with purple square pips and spend button --}}
    <div class="hd-well">
        <div class="hd-well-top">
            <span class="hd-well-label">{{localize "ionrift-respite.restHeroCard.hitDice" die=(concat hdDie "")}}</span>
            <span class="hd-well-avail {{#if noHdLeft}}zero-hd{{/if}}">
                <strong>{{hdRemaining}}</strong> / {{hdMax}} {{localize "ionrift-respite.restHeroCard.available"}}
            </span>
        </div>
        <div class="hd-well-action-row">
            <div class="hd-pips">
                {{#each hdPips}}
                <span class="{{#if filled}}pip-square-purple{{else}}pip-square-spent{{/if}}"></span>
                {{/each}}
            </div>
            <div class="hd-actions-right">
                {{#if isOwner}}
                {{#if isFullHp}}
                <button type="button" class="btn-spend-purple disabled" disabled data-tooltip="{{localize "ionrift-respite.restHeroCard.alreadyFullHpTooltip"}}">
                    {{localize "ionrift-respite.restHeroCard.fullHp"}}
                </button>
                {{else if noHdLeft}}
                <button type="button" class="btn-spend-purple disabled" disabled data-tooltip="{{localize "ionrift-respite.restHeroCard.noHdRemainingTooltip"}}">
                    {{localize "ionrift-respite.restHeroCard.noHd"}}
                </button>
                {{else}}
                <button type="button" class="btn-spend-purple" data-action="spendHitDie" data-actor-id="{{id}}">
                    <i class="fas fa-dice-d20"></i> {{localize "ionrift-respite.restHeroCard.spendHd" die=(concat hdDie "")}}
                </button>
                {{/if}}
                {{/if}}
            </div>
        </div>
    </div>

    {{!-- Roll log (compressed after 3 rolls) --}}
    {{#if rolls.length}}
    <div class="sr-roll-log">
        {{#if rollsCompressed}}
        <span class="sr-roll-hidden-badge" data-tooltip="{{localize "ionrift-respite.restHeroCard.earlierRollsTooltip" count=(concat rollsHidden "")}}">{{localize "ionrift-respite.restHeroCard.moreRolls" count=(concat rollsHidden "")}}</span>
        {{/if}}
        {{#each rollsToShow}}
        <span class="sr-roll-entry" data-tooltip="{{localize "ionrift-respite.restHeroCard.rollEntryTooltip" die=(concat die "") conMod=(concat conMod "")}}{{#if annotations.length}} | {{#each annotations}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}">+{{total}}{{#if annotations.length}}<span class="sr-roll-mod-badge">{{#each annotations}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</span>{{/if}}</span>
        {{/each}}
        <span class="sr-roll-total">
            <i class="fas fa-plus-circle"></i> {{totalHealed}} HP{{#if songBonusTotal}} <span class="sr-roll-song-addon">{{localize "ionrift-respite.restHeroCard.songAddon" bonus=(concat songBonusTotal "")}}</span>{{/if}}{{#if chefMealTotal}} <span class="sr-roll-chef-addon">{{localize "ionrift-respite.restHeroCard.chefAddon" bonus=(concat chefMealTotal "")}}</span>{{/if}}
        </span>
    </div>
    {{else if hdHealedTotal}}
    <div class="bivouac-roll-log-placeholder">
        <div class="sr-roll-log">
            <span class="sr-roll-total">
                <i class="fas fa-plus-circle"></i> {{localize "ionrift-respite.restHeroCard.hdSpentSummary" healed=(concat hdHealedTotal "") spent=(concat hdSpentThisRest "")}}
            </span>
        </div>
    </div>
    {{/if}}

    {{#if songCard}}
    <div class="sr-song-card-line {{songCard.kind}}">
        {{#if songCard.isPendingEnd}}
        <i class="fas fa-hourglass-half"></i>
        <span class="sr-song-card-text">{{{localize "ionrift-respite.restHeroCard.songPendingEnd" die=(concat songCard.die "")}}}</span>
        {{/if}}
        {{#if songCard.isAppliedImmediate}}
        <i class="fas fa-music"></i>
        <span class="sr-song-card-text">{{{localize "ionrift-respite.restHeroCard.songAppliedImmediate" total=(concat songCard.total "")}}} <span class="sr-song-formula">({{songCard.formula}})</span></span>
        {{/if}}
    </div>
    {{/if}}

    {{!-- Class Features Tray: Active Triggers vs Quiet Passive Badges --}}
    {{#if hasFeatures}}
    <div class="features-tray">
        <div class="features-tray-header">
            <span class="features-label">{{localize "ionrift-respite.restHeroCard.classFeatures"}}</span>
        </div>
        <div class="features-pills-row">
            {{!-- Bard Song of Rest Offer on Provider's Card --}}
            {{#if isEligibleBard}}
            {{#if hasVolunteeredSong}}
            <button type="button" class="btn-feature-trigger btn-feature-purple active" data-action="volunteerSong" data-actor-id="{{id}}"
                {{#unless canInteractSong}}disabled{{/unless}} data-tooltip="{{localize "ionrift-respite.restHeroCard.cancelSongTooltip"}}">
                <i class="fas fa-music"></i> {{localize "ionrift-respite.restHeroCard.performingSong" die=(concat bardSongDie "")}}
            </button>
            {{else if canVolunteerSong}}
            <button type="button" class="btn-feature-trigger btn-feature-purple" data-action="volunteerSong" data-actor-id="{{id}}"
                {{#unless canInteractSong}}disabled{{/unless}} data-tooltip="{{localize "ionrift-respite.restHeroCard.performSongTooltip" die=(concat bardSongDie "")}}">
                <i class="fas fa-music"></i> {{localize "ionrift-respite.restHeroCard.performSong" die=(concat bardSongDie "")}}
            </button>
            {{else if songVolunteerLocked}}
            <span class="badge-feature-passive"><i class="fas fa-music"></i> {{localize "ionrift-respite.restHeroCard.anotherBardPerforming"}}</span>
            {{/if}}
            {{/if}}

            {{!-- Chef Meal Offer on Provider's Card --}}
            {{#if isEligibleChef}}
            {{#if hasVolunteeredChef}}
            <button type="button" class="btn-feature-trigger btn-feature-amber active" data-action="optOutChef" data-actor-id="{{id}}"
                {{#unless canInteractChef}}disabled{{/unless}} data-tooltip="{{localize "ionrift-respite.restHeroCard.cancelChefTooltip"}}">
                <i class="fas fa-utensils"></i> {{localize "ionrift-respite.restHeroCard.cookingReplenishingMeal" count=(concat @root.chefMealsRemaining "")}}
            </button>
            {{else if canVolunteerChef}}
            <button type="button" class="btn-feature-trigger btn-feature-amber" data-action="volunteerChefMeal" data-actor-id="{{id}}"
                {{#unless canInteractChef}}disabled{{/unless}} data-tooltip="{{localize "ionrift-respite.restHeroCard.cookChefTooltip" capacity=(concat chefMealCapacity "")}}">
                <i class="fas fa-utensils"></i> {{#if @root.isGritty}}{{localize "ionrift-respite.restHeroCard.cookReplenishingMeal" capacity=(concat chefMealCapacity "")}}{{else}}{{{localize "ionrift-respite.restHeroCard.offerChefsTreats" capacity=(concat chefMealCapacity "")}}}{{/if}}
            </button>
            {{else if chefVolunteerLocked}}
            <span class="badge-feature-passive"><i class="fas fa-utensils"></i> {{localize "ionrift-respite.restHeroCard.anotherChefCooking"}}</span>
            {{else if cookingDisabled}}
            <span class="badge-feature-passive"><i class="fas fa-fire-flame-curved"></i> {{localize "ionrift-respite.restHeroCard.coldCampNoCooking"}}</span>
            {{/if}}
            {{/if}}

            {{!-- Arcane Recovery / Spell Recovery Trigger & Badges --}}
            {{#if spellRecovery}}
            {{#if spellRecovery.exhausted}}
            <span class="badge-feature-spent" data-tooltip="{{spellRecovery.exhaustedExplain}}">
                <i class="fas fa-hat-wizard"></i> {{localize "ionrift-respite.restHeroCard.spellRecoveryUsed" feature=spellRecovery.featureName}}
            </span>
            {{else if spellRecovery.noRecoverableSlots}}
            <span class="badge-feature-passive" data-tooltip="{{localize "ionrift-respite.restHeroCard.noSpentSlotsTooltip"}}">
                <i class="fas fa-hat-wizard"></i> {{localize "ionrift-respite.restHeroCard.spellRecoveryBudgetZero" feature=spellRecovery.featureName max=(concat spellRecovery.maxBudget "")}}
            </span>
            {{else}}
            <button type="button" class="btn-feature-trigger btn-feature-blue {{#if spellRecovery.confirmed}}confirmed{{/if}}" data-action="toggleSpellRecoveryDrawer" data-actor-id="{{id}}">
                <i class="fas fa-hat-wizard"></i> {{localize "ionrift-respite.restHeroCard.spellRecoveryBudget" feature=spellRecovery.featureName current=(concat spellRecovery.currentSpend "") max=(concat spellRecovery.maxBudget "")}}
                {{#if spellRecovery.confirmed}}<i class="fas fa-check-circle"></i>{{/if}}
            </button>
            {{/if}}
            {{/if}}

            {{!-- Quiet Passive Recharge Badges --}}
            {{#each srRechargeBadges}}
            <span class="badge-feature-passive" data-tooltip="{{localize "ionrift-respite.restHeroCard.rechargesOnRestTooltip"}}">{{this}}</span>
            {{/each}}
        </div>

        {{!-- Spell recovery drawer if active --}}
        {{#if (and spellRecovery (not spellRecovery.exhausted) (not spellRecovery.noRecoverableSlots))}}
        <div class="sr-spell-recovery {{#if spellRecovery.confirmed}}confirmed{{/if}}">
            <div class="sr-spell-slots">
                {{#each spellRecovery.slots}}
                <div class="sr-spell-slot-row">
                    <span class="sr-spell-level">{{localize "ionrift-respite.restHeroCard.spellLevel" level=level}}</span>
                    <span class="sr-spell-count">{{localize "ionrift-respite.restHeroCard.spellSpent" selected=(concat selected "") spent=(concat spent "")}}</span>
                    <div class="sr-spell-controls">
                        {{#if canRemove}}
                        <button type="button" class="sr-spell-btn sr-spell-minus" data-action="removeSpellSlot" data-actor-id="{{../spellRecovery.actorId}}" data-level="{{level}}">
                            <i class="fas fa-minus"></i>
                        </button>
                        {{else}}
                        <button type="button" class="sr-spell-btn sr-spell-minus faded" disabled>
                            <i class="fas fa-minus"></i>
                        </button>
                        {{/if}}
                        {{#if canAdd}}
                        <button type="button" class="sr-spell-btn sr-spell-plus" data-action="addSpellSlot" data-actor-id="{{../spellRecovery.actorId}}" data-level="{{level}}">
                            <i class="fas fa-plus"></i>
                        </button>
                        {{else}}
                        <button type="button" class="sr-spell-btn sr-spell-plus faded" disabled>
                            <i class="fas fa-plus"></i>
                        </button>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{#if spellRecovery.confirmed}}
            <button type="button" class="sr-spell-edit-btn" data-action="editRecovery" data-actor-id="{{spellRecovery.actorId}}">
                <i class="fas fa-pen"></i> {{localize "ionrift-respite.restHeroCard.edit"}}
            </button>
            {{else if spellRecovery.hasSelections}}
            <button type="button" class="sr-spell-confirm-btn" data-action="confirmRecovery" data-actor-id="{{spellRecovery.actorId}}">
                <i class="fas fa-check"></i> {{localize "ionrift-respite.restHeroCard.confirm"}}
            </button>
            {{/if}}
        </div>
        {{/if}}
    </div>
    {{/if}}
</div>
{{/with}}
{{/if}}
