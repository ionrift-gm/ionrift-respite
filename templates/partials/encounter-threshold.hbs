{{!-- Night Watch threshold. Stepper sits outside the summary so +/- does not toggle the breakdown.
     dc: displayed encounter DC (same number the roll uses).
     belowLabel: what a roll under the DC does in this mode.
     hideDisaster: improvise has no disaster pool line. --}}
<div class="encounter-details encounter-threshold">
    <div class="encounter-threshold-head">
        <div class="encounter-threshold-stepper">
            <button type="button" class="encounter-adj-btn" data-action="adjustEncounterDc" data-delta="-1"
                aria-label="{{localize "ionrift-respite.encounterThreshold.lowerDc"}}" data-tooltip="{{localize "ionrift-respite.encounterThreshold.lowerDc"}}"
                {{#if eventsCommitPending}}disabled{{/if}}>−</button>
            <span class="encounter-summary-badge">DC {{dc}}</span>
            <button type="button" class="encounter-adj-btn" data-action="adjustEncounterDc" data-delta="1"
                aria-label="{{localize "ionrift-respite.encounterThreshold.raiseDc"}}" data-tooltip="{{localize "ionrift-respite.encounterThreshold.raiseDc"}}"
                {{#if eventsCommitPending}}disabled{{/if}}>+</button>
        </div>
        <details>
            <summary class="encounter-summary">
                <span class="encounter-summary-label">{{localize "ionrift-respite.encounterThreshold.label"}}</span>
                <i class="fas fa-chevron-down encounter-chevron"></i>
            </summary>
            <div class="encounter-breakdown">
                <span class="event-outcome-advisory">
                    <i class="fas fa-moon"></i> {{localize "ionrift-respite.encounterThreshold.quietNightAdvisory" dc=(concat dc "")}}
                </span>
                <span class="event-outcome-advisory warn">
                    <i class="fas fa-exclamation-triangle"></i> {{localize "ionrift-respite.encounterThreshold.belowAdvisory" dc=(concat dc "") belowLabel=(concat belowLabel "")}}
                </span>
                {{#unless hideDisaster}}
                <span class="event-outcome-advisory disaster">
                    <i class="fas fa-skull"></i> {{localize "ionrift-respite.encounterThreshold.disasterPool"}}
                </span>
                {{/unless}}
            </div>
        </details>
    </div>
</div>
