{{!-- Lock / submit for the sustenance card.
     Normal rest hoists this into .rest-sustenance-main so the ration
     list can scroll without taking the button with it. --}}
{{#if sustenanceDiegetic.isMultiDay}}
<div class="rest-step-pacing sust-card-foot">
    {{#if sustenanceDiegetic.mealsLocked}}
    <span class="sust-meals-state"><i class="fas fa-lock" aria-hidden="true"></i> {{localize "ionrift-respite.sustenanceCardFoot.choicesLocked"}}</span>
    {{#if sustenanceDiegetic.canUnlock}}
    <button type="button" class="btn-step-ready rest-ready-btn is-ready" data-action="unlockMeals" data-actor-id="{{sustenanceDiegetic.actorId}}" data-tooltip="{{localize "ionrift-respite.sustenanceCardFoot.unlockChoicesTooltip"}}">
        <i class="fas fa-check-circle" aria-hidden="true"></i> <span>{{localize "ionrift-respite.sustenanceCardFoot.readyEditChoices"}}</span>
    </button>
    {{/if}}
    {{else}}
    {{#if sustenanceDiegetic.canInteract}}
    <button type="button" class="btn-step-ready rest-ready-btn" data-action="lockMeals" data-actor-id="{{sustenanceDiegetic.actorId}}" data-tooltip="{{localize "ionrift-respite.sustenanceCardFoot.lockChoicesTooltip"}}">
        <i class="fas fa-check" aria-hidden="true"></i> <span>{{localize "ionrift-respite.sustenanceCardFoot.readyForRest"}}</span>
    </button>
    {{else}}
    <span class="tier-action-placeholder">
        <i class="fas fa-hourglass-half"></i> <span>{{localize "ionrift-respite.sustenanceCardFoot.awaitingChoices"}}</span>
    </span>
    {{/if}}
    {{/if}}
</div>
{{else}}
<div class="sust-card-foot sust-card-foot-single">
    {{#if sustenanceDiegetic.mealsSubmitted}}
    <span class="sust-meals-state is-submitted"><i class="fas fa-check-circle" aria-hidden="true"></i> {{localize "ionrift-respite.sustenanceCardFoot.rationsConsumed"}}</span>
    {{else}}
    <button type="button" class="sust-lock-meals btn-submit-meals" data-action="submitMealChoices" data-actor-id="{{sustenanceDiegetic.actorId}}" data-tooltip="{{localize "ionrift-respite.sustenanceCardFoot.submitRationsTooltip"}}">
        <i class="fas fa-utensils" aria-hidden="true"></i> {{localize "ionrift-respite.sustenanceCardFoot.submitRations"}}
    </button>
    {{/if}}
</div>
{{/if}}
