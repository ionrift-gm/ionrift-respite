{{!-- Fire Tier Picker: TotM activity Fire tab --}}
<div class="totm-fire-tiers">
    <div class="totm-fire-tier-card cold-camp {{#if campColdCampDecided}}selected{{/if}}" data-tier="cold_camp">
        <div class="totm-fire-tier-top">
            <span class="totm-fire-tier-name">{{localize "ionrift-respite.fireTier.coldCamp"}}</span>
            <span class="totm-fire-tier-cost">{{localize "ionrift-respite.fireTier.noFireCost"}}</span>
        </div>
        <p class="totm-fire-tier-body">{{{localize "ionrift-respite.fireTier.coldCampBody"}}}</p>
        {{#if campColdCampDecided}}
        <span class="totm-fire-tier-current">{{localize "ionrift-respite.fireTier.current"}}</span>
        {{else}}
        <button type="button" class="totm-fire-tier-set-btn"
                data-action="selectCampColdCamp">
            {{localize "ionrift-respite.fireTier.set"}}
        </button>
        {{/if}}
    </div>
    {{#each campFirePickerLevels}}
    <div class="totm-fire-tier-card {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}" data-tier="{{id}}">
        <div class="totm-fire-tier-top">
            <span class="totm-fire-tier-name">{{label}}</span>
            <span class="totm-fire-tier-cost">{{costLabel}}</span>
        </div>
        <p class="totm-fire-tier-body">{{> fireTierBody}}</p>
        {{#if selected}}
        <span class="totm-fire-tier-current">{{localize "ionrift-respite.fireTier.current"}}</span>
        {{else if (not disabled)}}
        <button type="button" class="totm-fire-tier-set-btn"
                data-action="selectCampFireLevel"
                data-fire-level="{{id}}">
            {{localize "ionrift-respite.fireTier.set"}}
        </button>
        {{/if}}
        {{#if disabledReason}}
        <span class="totm-fire-tier-disabled-reason">{{disabledReason}}</span>
        {{/if}}
    </div>
    {{/each}}
</div>

{{!-- Firewood pledges (after fire is lit) --}}
{{#if campFireIsLit}}
{{#if campFirewoodPledgeList.length}}
<div class="totm-fire-pledges">
    <span class="totm-fire-pledges-label">{{localize "ionrift-respite.fireTier.firewoodPledged"}}</span>
    {{#each campFirewoodPledgeList}}
    <span class="totm-fire-pledge-entry">{{actorName}} ({{count}})</span>
    {{/each}}
</div>
{{/if}}
{{/if}}
