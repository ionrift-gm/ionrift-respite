{{!-- Dawn close for a normal rest. Dual-mode Hero Card vs GM Neutral Overview --}}
<div class="pacing-spotlight-card pacing-dawn-stage clean-dawn-layout">
    <div class="dawn-summary-strip">
        <div class="dawn-lead-group">
            <div class="dawn-sun-emblem"><i class="fas fa-sun"></i></div>
            <div class="dawn-copy-block">
                <div class="dawn-lead-title">{{localize "ionrift-respite.dawnExhaustionStage.leadTitle"}}</div>
                <div class="dawn-lead-hint">{{localize "ionrift-respite.dawnExhaustionStage.leadHint"}}</div>
            </div>
        </div>
        {{#if isGM}}
        <div class="dawn-batch-cluster">
            {{#if exhaustionSummary.pending}}
            <div class="check-module-dc-row dawn-global-dc-row">
                <button type="button" class="dc-nudge" data-action="adjustAllExhaustionDC" data-delta="-1" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.lowerDcAllTooltip"}}">
                    <i class="fas fa-minus"></i>
                </button>
                <div class="event-dc-badge circular" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.partyConDcTooltip"}}">
                    <span class="dc-label">{{localize "ionrift-respite.dawnExhaustionStage.dcLabel"}}</span>
                    <span class="dc-value">{{commonDc}}</span>
                </div>
                <button type="button" class="dc-nudge" data-action="adjustAllExhaustionDC" data-delta="1" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.raiseDcAllTooltip"}}">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
            <div class="override-mode-segment dawn-global-mode-segment" role="group">
                <button type="button" class="btn-mode adv {{#if (eq commonAdvMode "adv")}}active{{/if}}"
                        data-action="setAllExhaustionAdvMode" data-mode="adv" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.setAllAdvTooltip"}}">{{localize "ionrift-respite.dawnExhaustionStage.adv"}}</button>
                <button type="button" class="btn-mode norm {{#if (eq commonAdvMode "norm")}}active{{/if}}"
                        data-action="setAllExhaustionAdvMode" data-mode="norm" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.setAllNormTooltip"}}">{{localize "ionrift-respite.dawnExhaustionStage.norm"}}</button>
                <button type="button" class="btn-mode dis {{#if (eq commonAdvMode "dis")}}active{{/if}}"
                        data-action="setAllExhaustionAdvMode" data-mode="dis" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.setAllDisTooltip"}}">{{localize "ionrift-respite.dawnExhaustionStage.dis"}}</button>
            </div>
            <button type="button" class="btn-dawn-batch roll-all" data-action="rollAllExhaustionSaves"
                    data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.rollPendingTooltip"}}">
                <i class="fas fa-dice-d20"></i> {{localize "ionrift-respite.dawnExhaustionStage.rollPending" count=(concat exhaustionSummary.pending "")}}
            </button>
            <button type="button" class="btn-dawn-batch waive-all" data-action="waiveAllExhaustionSaves"
                    data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.waiveAllTooltip"}}">
                <i class="fas fa-shield-check"></i> {{localize "ionrift-respite.dawnExhaustionStage.waiveAll"}}
            </button>
            {{else}}
            <div class="dawn-settled-pill">
                <i class="fas fa-check-double"></i> {{localize "ionrift-respite.dawnExhaustionStage.savesSettled"}}
            </div>
            {{/if}}
        </div>
        {{/if}}
    </div>

    {{#if isGmNeutralView}}
    {{!-- ══════════════════════════════════════════════════════════════════ --}}
    {{!-- 1. GM NEUTRAL OVERVIEW (Balanced Party Ledger)                      --}}
    {{!-- ══════════════════════════════════════════════════════════════════ --}}
    <div class="dawn-roster-stack">
        {{#each exhaustionRoster}}
        <div class="dawn-actor-row {{#if rolled}}{{#if passed}}is-passed{{else}}is-failed{{/if}}{{else if mustRoll}}is-pending{{else}}is-waived{{/if}} {{#if isOverrideOpen}}override-active{{/if}}"
             data-actor-id="{{actorId}}">
            <div class="actor-identity-col">
                <img class="actor-avatar" src="{{actorImg}}" alt="{{actorName}}">
                <div class="actor-name-group">
                    <span class="actor-name">{{actorName}}</span>
                    <div class="actor-badges">
                        <span class="pill-con" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.conModifierTooltip"}}">{{localize "ionrift-respite.dawnExhaustionStage.conMod" mod=(concat conModString "")}}</span>
                        <span class="pill-exh {{#if currentExhaustion}}has-exh{{/if}}" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.currentExhaustionTooltip"}}">{{localize "ionrift-respite.dawnExhaustionStage.exhLevel" level=(concat currentExhaustion "")}}</span>
                    </div>
                </div>
            </div>
            <div class="actor-hazard-col" data-tooltip="{{reason}}">
                <i class="fas {{#if waived}}fa-shield-heart{{else}}fa-campground{{/if}}"></i>
                <span class="hazard-text">{{reason}}</span>
            </div>
            <div class="actor-target-col">
                {{#if mustRoll}}
                    {{#if rolled}}
                    <span class="target-dc-chip" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.conSaveDcTooltip"}}">DC <strong>{{dc}}</strong></span>
                    {{#if (ne advMode "norm")}}
                    <span class="target-mode-chip mode-{{advMode}}" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.rollModeTooltip"}}">
                        {{#if (eq advMode "adv")}}{{localize "ionrift-respite.dawnExhaustionStage.adv"}}{{else}}{{localize "ionrift-respite.dawnExhaustionStage.dis"}}{{/if}}
                    </span>
                    {{/if}}
                    {{else}}
                    <div class="actor-dc-stepper">
                        <button type="button" class="dc-nudge mini" data-action="adjustExhaustionDC" data-actor-id="{{actorId}}" data-delta="-1" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.lowerDcTooltip" name=actorName}}">
                            <i class="fas fa-minus"></i>
                        </button>
                        <span class="target-dc-chip" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.conSaveDcTooltip"}}">DC <strong>{{dc}}</strong></span>
                        <button type="button" class="dc-nudge mini" data-action="adjustExhaustionDC" data-actor-id="{{actorId}}" data-delta="1" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.raiseDcTooltip" name=actorName}}">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                    <button type="button" class="target-mode-chip mode-{{advMode}} clickable"
                            data-action="cycleExhaustionAdvMode" data-actor-id="{{actorId}}"
                            data-tooltip="{{#if (eq advMode "adv")}}{{localize "ionrift-respite.dawnExhaustionStage.cycleModeTooltip" name=actorName mode=(localize "ionrift-respite.dawnExhaustionStage.advantage")}}{{else if (eq advMode "dis")}}{{localize "ionrift-respite.dawnExhaustionStage.cycleModeTooltip" name=actorName mode=(localize "ionrift-respite.dawnExhaustionStage.disadvantage")}}{{else}}{{localize "ionrift-respite.dawnExhaustionStage.cycleModeTooltip" name=actorName mode=(localize "ionrift-respite.dawnExhaustionStage.normal")}}{{/if}}">
                        {{#if (eq advMode "adv")}}{{localize "ionrift-respite.dawnExhaustionStage.adv"}}{{else if (eq advMode "dis")}}{{localize "ionrift-respite.dawnExhaustionStage.dis"}}{{else}}{{localize "ionrift-respite.dawnExhaustionStage.norm"}}{{/if}}
                    </button>
                    {{/if}}
                {{else}}
                <span class="target-exempt-chip"><i class="fas fa-check"></i> {{localize "ionrift-respite.dawnExhaustionStage.exempt"}}</span>
                {{/if}}
            </div>
            <div class="actor-action-col">
                {{#if rolled}}
                    {{#if passed}}
                    <div class="result-badge passed" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.savedTooltip" roll=(concat rollTotal "") dc=(concat dc "")}}">
                        <i class="fas fa-check-circle"></i> {{localize "ionrift-respite.dawnExhaustionStage.saved" roll=(concat rollTotal "")}}
                        {{#if ../isGM}}
                        <button type="button" class="btn-mini-reroll" data-action="rollActorExhaustionSave" data-actor-id="{{actorId}}" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.rerollSaveTooltip"}}">
                            <i class="fas fa-rotate-right"></i>
                        </button>
                        {{/if}}
                    </div>
                    {{else}}
                    <div class="result-badge failed" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.failedTooltip" roll=(concat rollTotal "") dc=(concat dc "")}}">
                        <i class="fas fa-skull"></i> {{localize "ionrift-respite.dawnExhaustionStage.failed" roll=(concat rollTotal "")}}
                        {{#if ../isGM}}
                        <button type="button" class="btn-mini-reroll" data-action="rollActorExhaustionSave" data-actor-id="{{actorId}}" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.rerollSaveTooltip"}}">
                            <i class="fas fa-rotate-right"></i>
                        </button>
                        {{/if}}
                    </div>
                    {{/if}}
                {{else if mustRoll}}
                    {{#if ../isGM}}
                    <div class="gm-awaiting-roll-cell">
                        <span class="badge-waiting-player" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.awaitingPlayerTooltip"}}">
                            <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.dawnExhaustionStage.pending"}}
                        </span>
                        <button type="button" class="btn-dawn-fallback-roll" data-action="rollActorExhaustionSave" data-actor-id="{{actorId}}"
                                data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.rollOnBehalfTooltip" name=actorName}}">
                            <i class="fas fa-dice-d20"></i>
                        </button>
                    </div>
                    {{else}}
                    <span class="badge-waiting-gm"><i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.dawnExhaustionStage.pending"}}</span>
                    {{/if}}
                {{else}}
                    <span class="badge-waived-pill"><i class="fas fa-shield-heart"></i> {{localize "ionrift-respite.dawnExhaustionStage.waived"}}</span>
                {{/if}}
            </div>
            {{#if ../isGM}}
            <div class="actor-override-col">
                <button type="button" class="btn-gear-override {{#if isOverrideOpen}}active{{/if}}"
                        data-action="toggleExhaustionOverride" data-actor-id="{{actorId}}"
                        data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.overrideTooltip"}}">
                    <i class="fas fa-sliders"></i>
                </button>
            </div>
            {{/if}}
            {{#if (and ../isGM isOverrideOpen)}}
            <div class="dawn-override-drawer">
                <div class="override-drawer-title"><i class="fas fa-sliders"></i> {{actorName}}</div>
                <div class="override-drawer-controls">
                    <label class="override-checkbox-label">
                        <input type="checkbox" data-action="toggleMustRollExhaustion" data-actor-id="{{actorId}}" {{#if mustRoll}}checked{{/if}}>
                        <span>{{localize "ionrift-respite.dawnExhaustionStage.requireSave"}}</span>
                    </label>
                    <div class="override-dc-stepper">
                        <span class="stepper-label">{{localize "ionrift-respite.dawnExhaustionStage.dcLabel"}}</span>
                        <button type="button" class="btn-step" data-action="adjustExhaustionDC" data-actor-id="{{actorId}}" data-delta="-1">−</button>
                        <span class="dawn-dc-readout">{{dc}}</span>
                        <button type="button" class="btn-step" data-action="adjustExhaustionDC" data-actor-id="{{actorId}}" data-delta="1">+</button>
                    </div>
                    <div class="override-mode-segment" role="group">
                        <button type="button" class="btn-mode adv {{#if (eq advMode "adv")}}active{{/if}}"
                                data-action="setExhaustionAdvMode" data-actor-id="{{actorId}}" data-mode="adv">{{localize "ionrift-respite.dawnExhaustionStage.adv"}}</button>
                        <button type="button" class="btn-mode norm {{#if (eq advMode "norm")}}active{{/if}}"
                                data-action="setExhaustionAdvMode" data-actor-id="{{actorId}}" data-mode="norm">{{localize "ionrift-respite.dawnExhaustionStage.norm"}}</button>
                        <button type="button" class="btn-mode dis {{#if (eq advMode "dis")}}active{{/if}}"
                                data-action="setExhaustionAdvMode" data-actor-id="{{actorId}}" data-mode="dis">{{localize "ionrift-respite.dawnExhaustionStage.dis"}}</button>
                    </div>
                    <button type="button" class="btn-close-override" data-action="toggleExhaustionOverride" data-actor-id="{{actorId}}" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.closeAdjustmentsTooltip"}}">
                        <i class="fas fa-check"></i> {{localize "ionrift-respite.dawnExhaustionStage.done"}}
                    </button>
                </div>
            </div>
            {{/if}}
        </div>
        {{/each}}
    </div>

    {{else}}
    {{!-- ══════════════════════════════════════════════════════════════════ --}}
    {{!-- 2. PLAYER HERO VIEW (Hero Card + Companion Deck)                   --}}
    {{!-- ══════════════════════════════════════════════════════════════════ --}}
    <div class="dawn-player-flow">
        {{#if heroCharacter}}
        {{#with heroCharacter}}
        <div class="dawn-hero-card ionrift-card-glass {{#if rolled}}{{#if passed}}hero-passed{{else}}hero-failed{{/if}}{{else if mustRoll}}hero-pending{{else}}hero-waived{{/if}}" data-actor-id="{{actorId}}">
            <div class="dawn-hero-header">
                <div class="dawn-hero-identity">
                    <img class="dawn-hero-avatar" src="{{actorImg}}" alt="{{actorName}}">
                    <div class="dawn-hero-meta">
                        <div class="dawn-hero-name-row">
                            <span class="dawn-hero-name">{{actorName}}</span>
                            {{#if isSelf}}<span class="badge-you">{{localize "ionrift-respite.dawnExhaustionStage.you"}}</span>{{/if}}
                        </div>
                        <div class="dawn-hero-vitals-row">
                            <span class="hero-vital-pill con" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.conModifierTooltip"}}"><i class="fas fa-shield-heart"></i> {{localize "ionrift-respite.dawnExhaustionStage.conSaveMod" mod=(concat conModString "")}}</span>
                            <span class="hero-vital-pill exh {{#if currentExhaustion}}has-exh{{/if}}" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.currentExhaustionLevelTooltip"}}">
                                <i class="fas fa-person-falling-burst"></i> {{localize "ionrift-respite.dawnExhaustionStage.exhaustionLevel" level=(concat currentExhaustion "")}}
                            </span>
                        </div>
                    </div>
                </div>
                <div class="dawn-hero-stakes-badge" data-tooltip="{{reason}}">
                    <i class="fas {{#if waived}}fa-shield-check{{else}}fa-campground{{/if}}"></i>
                    <span>{{reason}}</span>
                </div>
            </div>

            <div class="dawn-hero-action-surface">
                {{#if rolled}}
                    {{#if passed}}
                    <div class="hero-outcome-banner passed">
                        <i class="fas fa-check-circle fa-2x"></i>
                        <div class="outcome-copy">
                            <span class="outcome-verdict">{{localize "ionrift-respite.dawnExhaustionStage.heroSavePassedVerdict"}}</span>
                            <span class="outcome-detail">{{{localize "ionrift-respite.dawnExhaustionStage.heroSavePassedDetail" roll=(concat rollTotal "") dc=(concat dc "")}}}</span>
                        </div>
                    </div>
                    {{else}}
                    <div class="hero-outcome-banner failed">
                        <i class="fas fa-skull-crossbones fa-2x"></i>
                        <div class="outcome-copy">
                            <span class="outcome-verdict">{{localize "ionrift-respite.dawnExhaustionStage.heroSaveFailedVerdict"}}</span>
                            <span class="outcome-detail">{{{localize "ionrift-respite.dawnExhaustionStage.heroSaveFailedDetail" roll=(concat rollTotal "") dc=(concat dc "")}}}</span>
                        </div>
                    </div>
                    {{/if}}
                {{else if mustRoll}}
                    <div class="hero-roll-prompt">
                        <div class="roll-prompt-stakes">
                            <span class="stakes-dc">DC <strong>{{dc}}</strong></span>
                            {{#if (eq advMode "adv")}}
                            <span class="stakes-mode mode-adv"><i class="fas fa-angles-up"></i> {{localize "ionrift-respite.dawnExhaustionStage.advantage"}}</span>
                            {{else if (eq advMode "dis")}}
                            <span class="stakes-mode mode-dis"><i class="fas fa-angles-down"></i> {{localize "ionrift-respite.dawnExhaustionStage.disadvantage"}}</span>
                            {{/if}}
                        </div>
                        <button type="button" class="btn-hero-roll-dawn" data-action="rollActorExhaustionSave" data-actor-id="{{actorId}}">
                            <i class="fas fa-dice-d20"></i> {{localize "ionrift-respite.dawnExhaustionStage.rollConstitutionSave"}}
                        </button>
                    </div>
                {{else}}
                    <div class="hero-outcome-banner waived">
                        <i class="fas fa-shield-heart fa-2x"></i>
                        <div class="outcome-copy">
                            <span class="outcome-verdict">{{localize "ionrift-respite.dawnExhaustionStage.exempt"}}</span>
                            <span class="outcome-detail">{{localize "ionrift-respite.dawnExhaustionStage.noCheckRequired"}}</span>
                        </div>
                    </div>
                {{/if}}
            </div>
        </div>
        {{/with}}
        {{/if}}

        {{!-- Companion Deck --}}
        {{#if companionCharacters.length}}
        <div class="dawn-companions-deck-section">
            <div class="dawn-companions-header">
                <i class="fas fa-users"></i> {{localize "ionrift-respite.dawnExhaustionStage.companionStatus"}}
            </div>
            <div class="dawn-companions-grid">
                {{#each companionCharacters}}
                <div class="dawn-companion-chip ionrift-card-glass {{#if rolled}}{{#if passed}}chip-passed{{else}}chip-failed{{/if}}{{else if mustRoll}}chip-pending{{else}}chip-waived{{/if}}" data-actor-id="{{actorId}}">
                    <img class="comp-chip-avatar" src="{{actorImg}}" alt="{{actorName}}">
                    <div class="comp-chip-info">
                        <div class="comp-chip-name-row">
                            <span class="comp-chip-name">{{actorName}}</span>
                            {{#if isSelf}}<span class="badge-you mini">{{localize "ionrift-respite.dawnExhaustionStage.you"}}</span>{{/if}}
                        </div>
                        <div class="comp-chip-status">
                            {{#if rolled}}
                                {{#if passed}}
                                <span class="chip-status passed"><i class="fas fa-check"></i> {{localize "ionrift-respite.dawnExhaustionStage.saved" roll=(concat rollTotal "")}}</span>
                                {{else}}
                                <span class="chip-status failed"><i class="fas fa-skull"></i> {{localize "ionrift-respite.dawnExhaustionStage.failed" roll=(concat rollTotal "")}}</span>
                                {{/if}}
                            {{else if mustRoll}}
                                {{#if isOwner}}
                                <button type="button" class="btn-comp-roll" data-action="rollActorExhaustionSave" data-actor-id="{{actorId}}" data-tooltip="{{localize "ionrift-respite.dawnExhaustionStage.rollSaveForTooltip" name=actorName}}">
                                    <i class="fas fa-dice-d20"></i> {{localize "ionrift-respite.dawnExhaustionStage.rollDc" dc=(concat dc "")}}
                                </button>
                                {{else}}
                                <span class="chip-status pending"><i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.dawnExhaustionStage.pending"}}</span>
                                {{/if}}
                            {{else}}
                                <span class="chip-status waived"><i class="fas fa-shield-heart"></i> {{localize "ionrift-respite.dawnExhaustionStage.exempt"}}</span>
                            {{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        {{/if}}
    </div>
    {{/if}}
</div>
