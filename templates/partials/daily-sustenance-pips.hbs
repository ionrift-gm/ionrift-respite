{{!-- Shared partial: Daily sustenance pip timeline. Food + water daily breakdown. --}}
{{#if isSustenanceDrawerOpen}}
<div class="sustenance-breakdown-drawer">
    <div class="breakdown-drawer-header">
        <span class="drawer-header-title">{{localize "ionrift-respite.dailySustenance.headerTitle"}}</span>
        <span class="drawer-header-subtitle">{{localize "ionrift-respite.dailySustenance.headerSubtitle"}}</span>
    </div>
    <div class="breakdown-tracks-grid">
        <!-- Food Strip -->
        <div class="breakdown-track food-track">
            <div class="track-header">
                <span class="track-title"><i class="fas fa-bread-slice"></i> {{localize "ionrift-respite.dailySustenance.foodTrackTitle"}}</span>
                <span class="track-summary {{#if foodFlow.isShort}}shortfall{{else}}fulfilled{{/if}}">{{#if foodFlow.isShort}}{{localize "ionrift-respite.dailySustenance.daysShort" days=(concat foodFlow.shortfallDays "")}}{{else}}{{localize "ionrift-respite.dailySustenance.allDaysFed"}}{{/if}}</span>
            </div>
            <div class="daily-pip-strip">
                {{#each foodDailyPips}}
                <div class="daily-pip food-pip {{#if isFed}}fed{{else}}starving{{/if}} {{#if isDeparture}}departure{{/if}}" data-tooltip="{{tooltip}}" data-tooltip-direction="UP">
                    <span class="pip-day">D{{day}}</span>
                    {{#if img}}
                    <img class="pip-asset-img" src="{{img}}" alt="{{name}}">
                    {{else}}
                    <i class="{{icon}}"></i>
                    {{/if}}
                </div>
                {{/each}}
            </div>
            <div class="track-footer">
                <span>{{localize "ionrift-respite.dailySustenance.routineProvisionsDays"}}</span>
                <span>{{localize "ionrift-respite.dailySustenance.departureMeal"}}</span>
            </div>
        </div>

        <!-- Water Strip -->
        <div class="breakdown-track water-track">
            <div class="track-header">
                <span class="track-title"><i class="fas fa-droplet"></i> {{localize "ionrift-respite.dailySustenance.waterTrackTitle"}}</span>
                <span class="track-summary {{#if waterFlow.isShort}}shortfall{{else}}fulfilled{{/if}}">{{#if waterFlow.isShort}}{{localize "ionrift-respite.dailySustenance.unitsShort" units=(concat waterFlow.shortfallUnits "")}}{{else}}{{localize "ionrift-respite.dailySustenance.allDaysHydrated"}}{{/if}}</span>
            </div>
            <div class="daily-pip-strip">
                {{#each waterDailyPips}}
                <div class="daily-pip water-pip {{#if isHydrated}}hydrated{{else}}parched{{/if}} {{#if isDeparture}}departure{{/if}}" data-tooltip="{{tooltip}}" data-tooltip-direction="UP">
                    <span class="pip-day">D{{day}}</span>
                    {{#if img}}
                    <img class="pip-asset-img" src="{{img}}" alt="{{name}}">
                    {{else}}
                    <i class="{{icon}}"></i>
                    {{/if}}
                </div>
                {{/each}}
            </div>
            <div class="track-footer">
                {{#if waterFlow.isShort}}
                <span class="water-warning"><i class="fas fa-triangle-exclamation"></i> {{localize "ionrift-respite.dailySustenance.waterWarningNoWaterskins" units=(concat waterFlow.shortfallUnits "")}}</span>
                <span class="water-action">{{localize "ionrift-respite.dailySustenance.refillAtStreamOrGather"}}</span>
                {{else}}
                <span>{{localize "ionrift-respite.dailySustenance.routineWater"}}</span>
                <span>{{localize "ionrift-respite.dailySustenance.departureDrink"}}</span>
                {{/if}}
            </div>
        </div>
    </div>
</div>
{{/if}}
