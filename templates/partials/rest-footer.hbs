{{!-- Canonical Rest Command Footer: Unified Bottom Rail across Rest Interfaces --}}
<footer class="respite-unified-footer {{#if encounterBar}}{{#unless encounterBar.isGM}}respite-unified-footer--player{{/unless}}{{/if}}">
    {{!-- ZONE 1: GM Encounter Risk & Logistics Calibration / Player Exposure.
         Mock order (rest-dock-gritty footer): Logistics · Encounter DC · stepper. --}}
    <div class="footer-zone footer-zone--risk">
        {{#if encounterBar}}
            {{#if encounterBar.isGM}}
            {{#unless safeRestSpot}}
            <button type="button"
                    class="btn-gm-logistics {{#if logisticsDrawerOpen}}active{{/if}}"
                    data-action="toggleLogisticsDrawer"
                    data-tooltip="{{#if logisticsDrawerOpen}}{{localize "ionrift-respite.restFooter.logisticsCloseTooltip"}}{{else}}{{localize "ionrift-respite.restFooter.logisticsOpenTooltip"}}{{/if}}">
                <i class="fas fa-sliders" aria-hidden="true"></i>
                <span>{{localize "ionrift-respite.restFooter.logistics"}}</span>
            </button>
            {{/unless}}
            {{#if showFireRail}}
            {{> encounterDcStepper dc=encounterBar.effectiveDC adjustAction="adjustEncounterDc" tooltip="Encounter DC. Rolls below this threshold trigger a night event."}}
            {{else}}
            <span class="encounter-bar-label-wrap">
                <span class="encounter-bar-label" data-tooltip="{{localize "ionrift-respite.restFooter.encounterThresholdTooltip" terrain=(concat encounterBar.terrainLabel "") dc=(concat encounterBar.baseDC "")}}">
                    <i class="fas fa-dice-d20" aria-hidden="true"></i>
                    {{encounterBar.totalLabel}}
                </span>
            </span>
            <span class="encounter-gm-adj">
                <button type="button" class="encounter-adj-btn" data-action="encounterAdjDown" data-tooltip="{{localize "ionrift-respite.restFooter.reduceDc"}}">−</button>
                <button type="button" class="encounter-adj-btn" data-action="encounterAdjUp" data-tooltip="{{localize "ionrift-respite.restFooter.increaseDc"}}">+</button>
            </span>
            {{/if}}
            {{else}}
            <span class="encounter-bar-label-wrap">
                <span class="encounter-bar-label">{{localize "ionrift-respite.restFooter.campExposure"}}</span>
            </span>
            {{#if encounterBar.playerFactors.length}}
            <span class="encounter-bar-chips encounter-bar-chips--player">
                {{#each encounterBar.playerFactors}}
                {{#unless @first}}<span class="encounter-factor-sep" aria-hidden="true">|</span>{{/unless}}
                <span class="encounter-chip encounter-chip--{{tone}}"{{#if tooltip}} data-tooltip="{{tooltip}}"{{/if}}>
                    {{#if icon}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}{{label}}
                </span>
                {{/each}}
            </span>
            {{/if}}
            {{/if}}
        {{else if safeRestSpot}}
            <span class="encounter-bar-label-wrap">
                <span class="encounter-bar-label safe-spot-label" data-tooltip="{{localize "ionrift-respite.restFooter.safeRestSpotTooltip"}}">
                    <i class="fas fa-shield-halved" aria-hidden="true"></i> {{localize "ionrift-respite.restFooter.sanctuary"}}
                </span>
            </span>
        {{/if}}
    </div>

    {{!-- ZONE 2: Party Assignment & Workflow Progress --}}
    <div class="footer-zone footer-zone--status">
        {{#if (eq phase 'activity')}}
            {{#if showMealContent}}
            {{#unless showFireRail}}
            {{#if allMealsConsumed}}
            <span class="totm-footer-stat">
                <i class="fas fa-utensils" aria-hidden="true"></i>
                {{#if pendingDehydrationSaves}}
                {{localize "ionrift-respite.restFooter.pendingConSaves" count=pendingDehydrationSaves}}
                {{else}}
                {{localize "ionrift-respite.restFooter.allRationsAssigned"}}
                {{/if}}
            </span>
            {{/if}}
            {{/unless}}
            {{else}}
            {{#unless showFireRail}}
            {{#if activityPhasePlayerOverview}}
            <span class="totm-footer-stat">
                <i class="fas fa-users" aria-hidden="true"></i>
                {{#if activityPhasePlayerOverview.viewerHasSubmitted}}
                {{localize "ionrift-respite.restFooter.activitiesCompleted" resolved=activityPhasePlayerOverview.resolvedCount total=activityPhasePlayerOverview.totalCharacters}}
                {{else if isGM}}
                {{localize "ionrift-respite.restFooter.activitiesAssigned" resolved=activityPhasePlayerOverview.resolvedCount total=activityPhasePlayerOverview.totalCharacters}}
                {{else}}
                {{localize "ionrift-respite.restFooter.chooseOneActivity"}}
                {{/if}}
            </span>
            {{/if}}
            {{/unless}}
            {{/if}}
        {{else if (eq phase 'meal')}}
            {{#if allMealsConsumed}}
            <span class="totm-footer-stat">
                <i class="fas fa-utensils" aria-hidden="true"></i>
                {{#if pendingDehydrationSaves}}
                {{localize "ionrift-respite.restFooter.pendingConSaves" count=pendingDehydrationSaves}}
                {{else}}
                {{localize "ionrift-respite.restFooter.allRationsAssigned"}}
                {{/if}}
            </span>
            {{/if}}
        {{/if}}
    </div>

    {{!-- ZONE 3: Tactical Actions & Phase Advance --}}
    <div class="footer-zone footer-zone--actions">
        {{#if (eq phase 'camp')}}
            {{> campfireDragHandle}}
            {{#if isGM}}
                {{#if canProceedFromMakeCamp}}
                <button type="button" class="btn-primary totm-camp-proceed" data-action="proceedFromMakeCamp">
                    <i class="fas fa-arrow-right" aria-hidden="true"></i> {{localize "ionrift-respite.restFooter.proceedToActivities"}}
                </button>
                {{else}}
                <button type="button" class="btn-primary totm-camp-proceed disabled" disabled data-tooltip="{{proceedBlockedHint}}">
                    <i class="fas fa-lock" aria-hidden="true"></i> {{localize "ionrift-respite.restFooter.proceedToActivities"}}
                </button>
                {{/if}}
            {{else}}
                <span class="totm-camp-player-wait">
                    <i class="fas fa-campground" aria-hidden="true"></i>
                    {{#if canProceedFromMakeCamp}}
                    {{localize "ionrift-respite.restFooter.campIsSetWaitingForGm"}}
                    {{else}}
                    {{localize "ionrift-respite.restFooter.settingUpCamp"}}
                    {{/if}}
                </span>
            {{/if}}
        {{else if (eq phase 'activity')}}
            {{> campfireDragHandle}}
            {{#if readyTotal}}
            <span class="rest-ready-count" data-tooltip="{{localize "ionrift-respite.restFooter.charactersMarkedReady"}}">{{localize "ionrift-respite.restFooter.readyCount" ready=readyCount total=readyTotal}}</span>
            {{/if}}
            {{#if activityProceedEnabled}}
                {{#if isGM}}
                <button type="button" class="btn-primary totm-footer-proceed" data-action="submitActivities">
                    <i class="{{activityProceed.icon}}"></i> {{activityProceed.label}}
                </button>
                {{else}}
                <span class="totm-footer-waiting"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {{localize "ionrift-respite.restFooter.waitingOnGm"}}</span>
                {{/if}}
            {{else if isGM}}
                <button type="button" class="btn-primary totm-footer-proceed disabled" disabled
                        data-tooltip="{{#if holdPhaseProceed}}{{localize "ionrift-respite.restFooter.useNextFirst"}}{{else}}{{localize "ionrift-respite.restFooter.notAllReady" ready=readyCount total=readyTotal}}{{/if}}">
                    <i class="fas fa-lock" aria-hidden="true"></i> {{activityProceed.label}}
                </button>
            {{else if activityPhasePlayerOverview.viewerHasSubmitted}}
                <span class="totm-footer-waiting"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {{localize "ionrift-respite.restFooter.waitingForOthers"}}</span>
            {{/if}}
        {{else if (eq phase 'meal')}}
            {{> campfireDragHandle}}
            {{#if readyTotal}}
            <span class="rest-ready-count" data-tooltip="{{localize "ionrift-respite.restFooter.charactersMarkedReady"}}">{{localize "ionrift-respite.restFooter.readyCount" ready=readyCount total=readyTotal}}</span>
            {{/if}}
            {{#if isGM}}
                {{#if allMealsConsumed}}
                    {{#if mealProcessed}}
                        {{#if pendingDehydrationSaves}}
                            {{#if allDehydrationResolved}}
                            <button type="button" class="{{#if encountersEnabled}}btn-primary{{else}}btn-primary-green{{/if}}" data-action="proceedFromMeal" draggable="false">
                                {{#if encountersEnabled}}<i class="fas fa-moon"></i> {{localize "ionrift-respite.restFooter.proceedToNightEvents"}}{{else}}<i class="fas fa-check-circle"></i> {{localize "ionrift-respite.restFooter.completeLongRest"}}{{/if}}
                            </button>
                            {{else}}
                            <button type="button" class="btn-primary" disabled draggable="false">
                                <i class="fas fa-hourglass-half"></i> {{localize "ionrift-respite.restFooter.waitingForConSaves" count=pendingDehydrationSaves}}
                            </button>
                            {{#if hasUnresolvedSaves}}
                            <button type="button" class="btn-secondary" data-action="skipPendingSaves" data-tooltip="{{localize "ionrift-respite.restFooter.skipPendingSavesTooltip"}}" draggable="false">
                                <i class="fas fa-forward"></i> {{localize "ionrift-respite.restFooter.skipPendingSaves"}}
                            </button>
                            {{/if}}
                            {{/if}}
                        {{else}}
                        <button type="button" class="{{#if encountersEnabled}}btn-primary{{else}}btn-primary-green{{/if}}" data-action="proceedFromMeal" draggable="false">
                            {{#if encountersEnabled}}<i class="fas fa-moon"></i> {{localize "ionrift-respite.restFooter.proceedToNightEvents"}}{{else}}<i class="fas fa-check-circle"></i> {{localize "ionrift-respite.restFooter.completeLongRest"}}{{/if}}
                        </button>
                        {{/if}}
                    {{else}}
                    <button type="button" class="{{#if encountersEnabled}}btn-primary{{else}}btn-primary-green{{/if}}" data-action="proceedFromMeal" draggable="false">
                        {{#if encountersEnabled}}<i class="fas fa-moon"></i> {{localize "ionrift-respite.restFooter.proceedToNightEvents"}}{{else}}<i class="fas fa-check-circle"></i> {{localize "ionrift-respite.restFooter.completeLongRest"}}{{/if}}
                    </button>
                    {{/if}}
                {{else}}
                    {{#with (lookup mealCards 0)}}
                    {{#if (and isMultiDay (not allDaysConsumed))}}
                    <button type="button" class="btn-primary btn-consume-day" data-action="consumeMealDay">
                        <i class="fas fa-utensils"></i> {{localize "ionrift-respite.restFooter.consumeDay" day=currentDay}}
                    </button>
                    {{else if allDaysConsumed}}
                    <button type="button" class="btn-primary" disabled>
                        <i class="fas fa-check"></i> {{localize "ionrift-respite.restFooter.allDaysConsumed" actor=actorName}}
                    </button>
                    {{/if}}
                    {{/with}}
                {{/if}}
            {{else}}
                {{#with (lookup mealCards 0)}}
                {{#if (and isMultiDay (not allDaysConsumed))}}
                <button type="button" class="btn-primary btn-consume-day" data-action="consumeMealDay">
                    <i class="fas fa-utensils"></i> {{localize "ionrift-respite.restFooter.consumeDay" day=currentDay}}
                </button>
                {{else}}
                <span class="totm-footer-waiting"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {{localize "ionrift-respite.restFooter.waitingOnGm"}}</span>
                {{/if}}
                {{else}}
                <span class="totm-footer-waiting"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {{localize "ionrift-respite.restFooter.waitingOnGm"}}</span>
                {{/with}}
            {{/if}}
        {{/if}}
    </div>
</footer>
