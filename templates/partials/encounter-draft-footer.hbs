{{!-- Shared partial: Encounter draft footer. GM-only wilderness encounter planning. --}}
{{#if isGM}}
<div class="encounter-draft-panel downtime-encounter-draft-panel">
    <div class="draft-header">
        <span class="draft-title"><i class="fas fa-shield-halved"></i> {{localize "ionrift-respite.encounterDraftFooter.title"}}</span>
        <div class="draft-master-actions">
            <div class="draft-dc-stepper" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.stepperTooltip"}}">
                <span class="draft-dc-label">{{localize "ionrift-respite.encounterDraftFooter.encounterDc"}}</span>
                <button type="button" class="btn-draft-dc" data-action="adjustDraftDC" data-delta="-1" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.decreaseAllNightsTooltip"}}">−</button>
                <span class="draft-dc-value">{{dangerDC}}</span>
                <button type="button" class="btn-draft-dc" data-action="adjustDraftDC" data-delta="1" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.increaseAllNightsTooltip"}}">+</button>
            </div>
            <button type="button" class="btn-draft-action" data-action="rerollAllDraft" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.rerollAllTooltip"}}">
                <i class="fas fa-dice"></i> {{localize "ionrift-respite.encounterDraftFooter.rerollAll"}}
            </button>
        </div>
    </div>

    <div class="draft-nights-grid">
        {{#each encounterDraft}}
        <div class="draft-night-card {{#if isRed}}red{{else if isAmber}}amber{{else}}green{{/if}}">
            <div class="night-card-top">
                <span class="night-label">
                    N{{nightIndex}}
                    {{#if hasFortify}}<i class="fas fa-shield-alt night-mod-icon fortify" data-tooltip="{{fortifyTooltip}}"></i>{{/if}}
                    {{#if hasGuard}}<i class="fas fa-eye night-mod-icon guard" data-tooltip="{{guardTooltip}}"></i>{{/if}}
                </span>
                <div class="night-actions">
                    <button type="button" class="night-btn cycle-btn" data-action="cycleNightState" data-night="{{nightIndex}}" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.cycleStateTooltip"}}">
                        <i class="fas fa-arrows-rotate"></i>
                    </button>
                    <button type="button" class="night-btn" data-action="rerollNight" data-night="{{nightIndex}}" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.rerollNightTooltip"}}">
                        <i class="fas fa-dice"></i>
                    </button>
                    {{#if (or isRed isAmber)}}
                    <button type="button" class="night-btn drop-btn" data-action="dropNight" data-night="{{nightIndex}}" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.markSafeTooltip"}}">
                        <i class="fas fa-times"></i>
                    </button>
                    {{/if}}
                </div>
            </div>
            <div class="night-card-roll-row">
                <span class="night-roll-pill {{#if isRed}}red{{else if isAmber}}amber{{else}}green{{/if}}" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.nightRollTooltip" night=nightIndex roll=rollTotal dc=effectiveDC}}">
                    <i class="fas fa-dice-d20"></i> {{rollTotal}}
                </span>
                <div class="night-dc-stepper" data-tooltip="{{dcTooltip}}">
                    <button type="button" class="night-dc-btn" data-action="adjustNightDC" data-night="{{nightIndex}}" data-delta="-1" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.decreaseNightDcTooltip" night=nightIndex}}">−</button>
                    <span class="night-dc-val {{#if isReducedDC}}reduced{{else if isIncreasedDC}}increased{{/if}}">DC {{effectiveDC}}</span>
                    <button type="button" class="night-dc-btn" data-action="adjustNightDC" data-night="{{nightIndex}}" data-delta="1" data-tooltip="{{localize "ionrift-respite.encounterDraftFooter.increaseNightDcTooltip" night=nightIndex}}">+</button>
                </div>
            </div>
            <span class="night-status {{#if isRed}}red{{else if isAmber}}amber{{else}}green{{/if}}" title="{{#if event}}{{event.title}}: {{event.description}}{{else}}{{localize "ionrift-respite.encounterDraftFooter.quietNight"}}{{/if}}">
                <i class="{{statusIcon}}"></i> {{statusLabel}}
            </span>
        </div>
        {{/each}}
    </div>
</div>
{{/if}}
