{{!-- Normal rest Gather / Activities: night-cards + Ready + 268px fire rail. --}}
<div class="rest-sustenance-with-fire">
    <div class="rest-sustenance-main">
        {{#if (eq selectedWorkflowStep "gather")}}
        {{#if gatherPanel}}
        <div class="totm-detail-view rest-gather-panel">
            <div class="totm-detail-header">
                <div class="totm-detail-icon-wrap">
                    <i class="{{gatherPanel.icon}} totm-detail-icon" aria-hidden="true"></i>
                </div>
                <div class="totm-detail-titles">
                    <span class="totm-detail-name">{{gatherPanel.name}}</span>
                </div>
            </div>
            {{#if gatherPanel.canConfirmSkip}}
            <p class="totm-detail-description">{{localize "ionrift-respite.restChoiceWithFire.remainAtCamp"}}</p>
            <div class="totm-detail-actions">
                <button type="button" class="totm-detail-cancel-btn" data-action="cancelGather">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> {{localize "ionrift-respite.restChoiceWithFire.back"}}
                </button>
                <button type="button" class="totm-detail-confirm-btn" data-action="confirmGatherSkip">
                    <i class="fas fa-check" aria-hidden="true"></i> {{localize "ionrift-respite.restChoiceWithFire.confirmSkip"}}
                </button>
            </div>
            {{else if gatherPanel.finds.length}}
            <div class="gather-find-list">
                {{#each gatherPanel.finds}}
                <span class="gather-find" data-tooltip="{{name}}{{#if qtyLabel}}, {{qtyLabel}}{{/if}}">
                    {{#if img}}<img src="{{img}}" alt="">{{/if}}
                    <span class="gather-find-name">{{name}}</span>
                    {{#if qtyLabel}}<b>{{qtyLabel}}</b>{{/if}}
                </span>
                {{/each}}
            </div>
            <div class="rest-step-pacing">
                <button type="button" class="btn-step-next" data-action="switchWorkflow" data-step="activities">
                    <span>{{localize "ionrift-respite.restChoiceWithFire.nextActivity"}}</span> <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
            {{else if gatherPanel.detail}}
            <p class="totm-detail-description">{{gatherPanel.detail}}</p>
            <div class="rest-step-pacing">
                <button type="button" class="btn-step-next" data-action="switchWorkflow" data-step="activities">
                    <span>{{localize "ionrift-respite.restChoiceWithFire.nextActivity"}}</span> <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
            {{else if gatherPanel.canRollCheck}}
            <div class="totm-detail-mechanics">
                <div class="totm-mechanics-header">
                    <div class="totm-mechanics-check">
                        <span class="totm-mechanics-check-label">
                            <i class="fas fa-dice-d20" aria-hidden="true"></i>
                            {{localize "ionrift-respite.restChoiceWithFire.survivalCheck" dc=gatherPanel.dc}}
                        </span>
                    </div>
                </div>
            </div>
            <div class="totm-detail-actions">
                <button type="button" class="totm-detail-cancel-btn" data-action="cancelGather">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> {{localize "ionrift-respite.restChoiceWithFire.back"}}
                </button>
                <button type="button" class="totm-detail-confirm-btn rest-gather-roll" data-action="rollGather" data-character-id="{{gatherPanel.characterId}}">
                    <i class="fas fa-dice-d20" aria-hidden="true"></i> {{localize "ionrift-respite.restChoiceWithFire.rollSurvival"}}
                </button>
            </div>
            {{else if gatherPanel.findingsOpen}}
            <p class="totm-detail-description">{{localize "ionrift-respite.restChoiceWithFire.findingsOpen"}}</p>
            <div class="totm-detail-actions">
                <button type="button" class="totm-detail-cancel-btn" data-action="cancelGather">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> {{localize "ionrift-respite.restChoiceWithFire.back"}}
                </button>
                <button type="button" class="totm-detail-confirm-btn rest-gather-roll" data-action="rollGather" data-character-id="{{gatherPanel.characterId}}">
                    <i class="fas fa-dice-d20" aria-hidden="true"></i> {{localize "ionrift-respite.restChoiceWithFire.rollFindings"}}
                </button>
            </div>
            {{else}}
            <p class="totm-detail-description">{{localize "ionrift-respite.restChoiceWithFire.nothingOpen"}}</p>
            <div class="totm-detail-actions">
                <button type="button" class="totm-detail-cancel-btn" data-action="cancelGather">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> {{localize "ionrift-respite.restChoiceWithFire.back"}}
                </button>
            </div>
            {{/if}}
        </div>
        {{else}}
        {{> restChoicePicker}}
        {{/if}}
        {{else}}
        {{#if activityCommit}}
        <div class="totm-detail-view rest-activity-panel">
            <div class="totm-detail-header">
                <div class="totm-detail-icon-wrap">
                    <i class="{{#if activityCommit.icon}}{{activityCommit.icon}}{{else}}fas fa-moon{{/if}} totm-detail-icon" aria-hidden="true"></i>
                </div>
                <div class="totm-detail-titles">
                    <span class="totm-detail-name">{{activityCommit.title}}</span>
                </div>
                {{#unless @root.characterReady}}
                {{#unless activityCommit.cannotChange}}
                <button type="button" class="totm-commit-change-btn" data-action="unlockTotmActivity" data-tooltip="{{localize "ionrift-respite.restChoiceWithFire.changeActivityTooltip"}}">
                    <i class="fas fa-undo-alt" aria-hidden="true"></i> {{localize "ionrift-respite.restChoiceWithFire.change"}}
                </button>
                {{/unless}}
                {{/unless}}
            </div>
            {{#if activityCommit.detail}}
            <p class="totm-detail-description">{{activityCommit.detail}}</p>
            {{/if}}
            {{#if @root.showSustenanceStep}}
            <div class="rest-step-pacing">
                <button type="button" class="btn-step-next" data-action="switchWorkflow" data-step="sustenance">
                    <span>{{localize "ionrift-respite.restChoiceWithFire.nextSustenance"}}</span> <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
            {{else if @root.characterPlanComplete}}
            <div class="rest-step-pacing">
                {{#if @root.characterReady}}
                <button type="button" class="btn-step-ready rest-ready-btn is-ready" data-action="toggleCharacterReady" data-actor-id="{{selectedCharacterId}}">
                    <i class="fas fa-check-circle" aria-hidden="true"></i> <span>{{localize "ionrift-respite.restChoiceWithFire.readyEditChoices"}}</span>
                </button>
                {{else}}
                <button type="button" class="btn-step-ready rest-ready-btn" data-action="toggleCharacterReady" data-actor-id="{{selectedCharacterId}}">
                    <i class="fas fa-check" aria-hidden="true"></i> <span>{{localize "ionrift-respite.restChoiceWithFire.readyForNight"}}</span>
                </button>
                {{/if}}
            </div>
            {{/if}}
        </div>
        {{else}}
        {{> restChoicePicker}}
        {{/if}}
        {{/if}}
    </div>
    {{> restFireRail}}
</div>
